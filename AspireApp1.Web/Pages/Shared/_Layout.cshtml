<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/index.css" asp-append-version="true">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    @await RenderSectionAsync("Styles", required: false)
    <!-- Admin & User Auth Styles -->
    <style>
        .auth-dropdown {
            position: relative;
            display: inline-block;
            margin: 0 10px;
        }

        .auth-user-avatar {
            font-size: 24px;
            color: white;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .admin-badge {
            background-color: #e74c3c;
            color: white;
            font-size: 14px;
            font-weight: bold;
            padding: 3px 8px;
            border-radius: 12px;
            text-transform: uppercase;
        }

        .auth-menu-content {
            display: none;
            position: absolute;
            right: 0;
            background-color: white;
            min-width: 220px;
            box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
            z-index: 1;
            border-radius: 8px;
            overflow: hidden;
        }

        .auth-dropdown:hover .auth-menu-content {
            display: block;
        }

        .auth-menu-content a {
            color: #333;
            padding: 12px 16px;
            text-decoration: none;
            display: block;
            font-family: Arial, sans-serif;
            font-size: 15px;
            font-weight: normal;
        }

        .auth-menu-content a:hover {
            background-color: #f1f1f1;
            color: var(--zoo-green);
        }
        /* Mobile Hamburger Menu */
        .hamburger-btn {
            display: none;
            background: none;
            border: none;
            color: white;
            font-size: 28px;
            cursor: pointer;
            padding: 5px;
            z-index: 1001;
        }

        @@media (max-width: 1024px) {
            .hamburger-btn { display: block; }
            .main-menu-new {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                width: 100vw;
                height: 100vh;
                background: rgba(0, 37, 38, 0.97);
                flex-direction: column;
                justify-content: center;
                align-items: center;
                gap: 30px;
                z-index: 9998;
            }
            .main-menu-new.mobile-open {
                display: flex;
            }
            .main-menu-new .nav-item-new a {
                font-size: 24px;
            }
            .dropdown-box {
                position: static;
                opacity: 1;
                visibility: visible;
                transform: none;
                flex-direction: column;
                gap: 15px;
                padding: 15px 0;
                background: transparent;
                box-shadow: none;
            }
            .header-actions .btn-join,
            .header-actions .btn-tickets {
                display: none;
            }
        }
    </style>
</head>
<body style="@((ViewData["Title"] as string) == "About Us - National Conservation Zoo" ? "background-color: #f9ebd1;" : "")">
    <div class="global-bg-shapes">
        <div class="bg-shape bg-yellow-shape"></div>
        <div class="bg-shape bg-green-shape"></div>
        <div class="bg-shape bg-red-shape"></div>
    </div>

    @{
        var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
    }

    @if (!(ViewData["HideHeader"] as bool? == true))
    {
        <header class="header-absolute-new" id="mainHeader">
        <div class="container-creature-new">
            <a asp-page="/Index" class="logo-zoo-new">
                <img src="/Source/General/logo.svg" alt="National Zoo" height="66" style="object-fit: contain; filter: brightness(0) invert(1);" />
            </a>

            <ul class="main-menu-new">
                <li class="nav-item-new has-dropdown">
                    <a asp-page="/Index" class="@(currentPage == "/" || currentPage == "/Index" ? "active" : "")">Visit</a>
                    <div class="dropdown-box">
                        <div class="drop-col">
                            <a asp-page="/Tickets">Get Tickets</a>
                            <a asp-page="/Attractions">Attractions</a>
                            <a asp-page="/Groups">Group Tickets</a>
                            <a asp-page="/Zoomap">Zoo Map</a>
                        </div>
                        <div class="drop-col">
                            <a href="/Shop2/index">Zoo Shop</a>
                            <a asp-page="/play-area/play-area">Play Area</a>
                            <a asp-page="/experience/zoo-experience">Experience</a>
                            <a asp-page="/dining/dining">Dining</a>
                        </div>
                    </div>
                </li>
                <li class="nav-item-new"><a asp-page="/Animals2" class="@(currentPage == "/Animals2" ? "active" : "")">Animals</a></li>
                <li class="nav-item-new"><a asp-page="/Events" class="@(currentPage == "/Events" ? "active" : "")">Events</a></li>
                <li class="nav-item-new"><a asp-page="/Conservation" class="@(currentPage == "/Conservation" ? "active" : "")">Conservation</a></li>
            </ul>

            <div class="header-actions">
                <button class="hamburger-btn" id="hamburgerBtn" onclick="toggleMobileMenu()">
                    <i class="fa fa-bars" id="hamburgerIcon"></i>
                </button>
                <i class="fa fa-search search-icon-btn" onclick="openSearch()"></i>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <!-- Notification Bell -->
                    <div class="notif-bell-wrapper" id="notifBellWrapper">
                        <button class="notif-bell-btn" onclick="toggleNotifDropdown(event)" title="Notifications">
                            <i class="fa fa-bell"></i>
                            <span class="notif-badge" id="notifBadge" style="display:none;">0</span>
                        </button>
                        <div class="notif-dropdown" id="notifDropdown">
                            <div class="notif-header">
                                <h4><i class="fa fa-bell"></i> Notifications</h4>
                                <button onclick="markAllNotifRead()" class="notif-mark-all">Mark all read</button>
                            </div>
                            <div class="notif-list" id="notifList">
                                <div class="notif-empty"><i class="fa fa-check-circle"></i><p>All caught up!</p></div>
                            </div>
                        </div>
                    </div>
                    <div class="auth-dropdown">
                        <div class="auth-user-avatar">
                            <i class="fa fa-user-circle"></i>
                            @if (User.IsInRole("Admin"))
                            {
                                <span class="admin-badge">Admin</span>
                            }
                        </div>
                        <div class="auth-menu-content">
                            <a asp-page="/CustomerInfo">📋 Information</a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-page="/AdminDashboard">🛠️ Details</a>
                            }
                            else
                            {
                                <a href="/purchase-history">📦 Purchase History</a>
                                <a asp-page="/RefundRequest">🔄 Refund</a>
                            }
                            <a asp-page="/Logout">🚪 Log Out</a>
                        </div>
                    </div>
                }
                else
                {
                    <a asp-page="/Login" asp-route-returnurl="@Context.Request.Path" title="Sign In" class="sign-in-link">
                        <i class="fa fa-sign-in sign-in-icon"></i>
                    </a>
                }
                <a asp-page="/Join" class="btn-join" style="color:white; font-weight: bold; text-decoration:none;">JOIN</a>
                <a asp-page="/Tickets" class="btn-tickets" style="background:#119864; color:white; padding:8px 20px; border-radius:20px; font-weight:bold; text-decoration:none;">TICKETS</a>
            </div>
        </div>
    </header>
    }

    <div id="fullSearchOverlay" class="search-overlay">
        <button class="close-search-btn" onclick="closeSearch()">&times;</button>
        <div style="text-align: center;">
            <div class="search-input-group">
                <input type="text" id="zooSearchInput" placeholder="Search the Zoo" onkeydown="if(event.key==='Enter') executeSearch()">
                <i class="fa fa-search" onclick="executeSearch()"></i>
            </div>
            <div id="searchResults" style="margin-top: 20px;"></div>
            <p style="color:white; font-size:18px;">Frequently Searched Terms: <a asp-page="/Zoomap" style="color:#FFFF00;">Map</a>, <a asp-page="/Attractions" style="color:#FFFF00;">Dining</a>, <a asp-page="/Tickets" style="color:#FFFF00;">Tickets</a>, <a asp-page="/Animal" style="color:#FFFF00;">Animals</a></p>
        </div>
    </div>

    @RenderBody()
    @Html.AntiForgeryToken()

    @if (!(ViewData["HideFooter"] as bool? == true))
    {
        <footer class="footer-new-beige">
            <div class="footer-content-wrapper">
            <div class="footer-logo-col">
                <div class="footer-logo-new">
                    <img src="/Source/General/logo.svg" alt="National Zoo" style="max-width: 216px; height: auto; object-fit: contain;" />
                </div>
            </div>

            <div class="footer-desc-new">
                <p>As Vietnam's first zoo, National Zoo has over 160 years of experience in conserving wildlife, caring for animals, and educating our communities. Home to more than 1,900 rare and endangered animals, the Zoo continues to reach new heights, offering award-winning animal exhibits, state-of-the-art healthcare facilities, award-winning education and conservation programs, and exceptional guest services, making it one of the most renowned zoos in the world.</p>
                <div class="footer-social-wrap">
                    <a href="#" class="icon-circle"><i class="fa fa-facebook"></i></a>
                    <a href="#" class="icon-circle"><i class="fa fa-twitter"></i></a>
                    <a href="#" class="icon-circle"><i class="fa fa-youtube-play"></i></a>
                    <a href="#" class="icon-circle"><i class="fa fa-instagram"></i></a>
                    <a href="#" class="newsletter-link-green">Join our newsletter &rarr;</a>
                </div>
            </div>

            <div class="footer-links-vert">
                <a asp-page="/About">About the Zoo</a>
                <a asp-page="/Careers">Careers at the Zoo</a>

                <a asp-page="/PrivateEvents">Host A Private Event</a>
                <a asp-page="/Contact">Contact Us</a>
                <a asp-page="/Accessibility">Accessibility</a>
            </div>
        </div>
    </footer>

    <div class="footer-bottom-dark">
        <div>Copyright &copy;2026 National Conservation Zoo a 501(c)(3) nonprofit organization.</div>
        <div>
            <a asp-page="/Privacy">Privacy Policy</a>
            <a asp-page="/Terms">Terms of Use</a>
        </div>
    </div>

        <a asp-page="/Contact" class="support-btn-fixed" style="text-decoration: none;">
            <i class="fa fa-question-circle-o"></i> Support
        </a>
    }

    <script>
        const header = document.getElementById('mainHeader');
        window.addEventListener('scroll', function () {
            if (window.scrollY > 48) {
                header.classList.add('sticky');
            } else {
                header.classList.remove('sticky');
            }
        });

        // ===== SEARCH =====
        function openSearch() {
            document.getElementById("fullSearchOverlay").classList.add("active");
            setTimeout(() => document.getElementById("zooSearchInput").focus(), 100);
        }
        function closeSearch() { document.getElementById("fullSearchOverlay").classList.remove("active"); }
        document.addEventListener('keydown', e => { if (e.key === "Escape") closeSearch(); });

        function executeSearch() {
            const query = document.getElementById('zooSearchInput').value.trim().toLowerCase();
            if (!query) return;

            const searchMap = {
                'ticket': '/Tickets', 'vé': '/Tickets', 'price': '/Tickets', 'giá': '/Tickets',
                'animal': '/Animal', 'động vật': '/Animal', 'lion': '/Animal', 'tiger': '/Animal', 'elephant': '/Animal',
                'event': '/Events', 'sự kiện': '/Events', 'festival': '/Events',
                'conservation': '/Conservation', 'bảo tồn': '/Conservation',
                'map': '/Zoomap', 'bản đồ': '/Zoomap',
                'direction': '/Directions', 'parking': '/Directions', 'giờ': '/Directions', 'hour': '/Directions',
                'group': '/Groups', 'đoàn': '/Groups', 'school': '/Groups',
                'contact': '/Contact', 'liên hệ': '/Contact', 'support': '/Contact',
                'donate': '/Donate', 'quyên góp': '/Donate',
                'tour': '/Tours', 'behind': '/Tours',
                'camp': '/Camp', 'trại': '/Camp',
                'attraction': '/Attractions', 'dining': '/dining/dining', 'food': '/dining/dining',
                'experience': '/experience/zoo-experience',
                'play': '/play-area/play-area', 'play-area': '/play-area/play-area',
                'encounter': '/Encounters', 'giraffe': '/Encounters',
                'join': '/Join', 'membership': '/Join', 'member': '/Join',
                'shop2': '/Shop2/index', 'shop': '/Shop2/index', 'gift': '/Shop2/index',
                'login': '/Login', 'đăng nhập': '/Login', 'sign': '/Login',
                'private': '/PrivateEvents', 'wedding': '/PrivateEvents',
                'accessibility': '/Accessibility'
            };

            for (const [keyword, url] of Object.entries(searchMap)) {
                if (query.includes(keyword)) {
                    closeSearch();
                    window.location.href = url;
                    return;
                }
            }

            // Không tìm thấy → hiện thông báo
            const resultsDiv = document.getElementById('searchResults');
            resultsDiv.innerHTML = '<p style="color:#FFFF00; font-size: 20px;">No results found for "' + query + '". Try: Tickets, Animals, Events, Map...</p>';
        }

        // ===== MOBILE MENU =====
        function toggleMobileMenu() {
            const menu = document.querySelector('.main-menu-new');
            const icon = document.getElementById('hamburgerIcon');
            menu.classList.toggle('mobile-open');
            if (menu.classList.contains('mobile-open')) {
                icon.className = 'fa fa-times';
            } else {
                icon.className = 'fa fa-bars';
            }
        }

        // Close mobile menu when clicking a link
        document.querySelectorAll('.main-menu-new a').forEach(link => {
            link.addEventListener('click', () => {
                const menu = document.querySelector('.main-menu-new');
                const icon = document.getElementById('hamburgerIcon');
                menu.classList.remove('mobile-open');
                if (icon) icon.className = 'fa fa-bars';
            });
        });
    </script>

    <!-- Notification Bell CSS + JS -->
    <style>
        .notif-bell-wrapper {
            position: relative;
            display: inline-flex;
            align-items: center;
        }
        .notif-bell-btn {
            background: none; border: none; color: white; cursor: pointer;
            font-size: 20px; position: relative; padding: 6px 10px;
            transition: transform 0.2s;
        }
        .notif-bell-btn:hover { transform: scale(1.15); }
        .notif-badge {
            position: absolute; top: 0; right: 2px;
            background: #e74c3c; color: white; font-size: 10px;
            font-weight: 800; min-width: 18px; height: 18px;
            border-radius: 9px; display: flex; align-items: center;
            justify-content: center; padding: 0 4px;
            animation: notifPulse 2s infinite;
            pointer-events: none;
        }
        @@keyframes notifPulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.15); }
        }
        .notif-dropdown {
            display: none; position: absolute; top: 45px; right: 0;
            width: 380px; max-height: 480px; background: white;
            border-radius: 14px; box-shadow: 0 15px 50px rgba(0,0,0,0.2);
            z-index: 9999; overflow: hidden;
            animation: notifSlideDown 0.25s ease;
        }
        .notif-dropdown.show { display: block; }
        @@keyframes notifSlideDown {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .notif-header {
            display: flex; justify-content: space-between; align-items: center;
            padding: 16px 20px; border-bottom: 1px solid #eee;
            background: linear-gradient(135deg, #1a5e3a, #119864);
            color: white;
        }
        .notif-header h4 { margin: 0; font-size: 15px; font-weight: 700; display: flex; align-items: center; gap: 8px; }
        .notif-mark-all {
            background: rgba(255,255,255,0.2); border: none; color: white;
            font-size: 12px; padding: 5px 12px; border-radius: 20px;
            cursor: pointer; font-weight: 600; transition: background 0.2s;
        }
        .notif-mark-all:hover { background: rgba(255,255,255,0.35); }
        .notif-list {
            max-height: 380px; overflow-y: auto;
        }
        .notif-list::-webkit-scrollbar { width: 6px; }
        .notif-list::-webkit-scrollbar-thumb { background: #ddd; border-radius: 3px; }
        .notif-item {
            display: flex; gap: 12px; padding: 14px 20px;
            border-bottom: 1px solid #f5f5f5; cursor: pointer;
            transition: background 0.15s;
        }
        .notif-item:hover { background: #f9fafb; }
        .notif-item.unread { background: #f0faf5; }
        .notif-item.unread:hover { background: #e0f5eb; }
        .notif-icon {
            width: 38px; height: 38px; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 16px; flex-shrink: 0;
        }
        .notif-icon.ticket { background: #e3f2fd; color: #1976d2; }
        .notif-icon.donation { background: #fce4ec; color: #c62828; }
        .notif-icon.event { background: #fff3e0; color: #e65100; }
        .notif-icon.contact { background: #e8f5e9; color: #2e7d32; }
        .notif-icon.system { background: #f3e5f5; color: #7b1fa2; }
        .notif-body { flex: 1; min-width: 0; }
        .notif-title { font-size: 13px; font-weight: 700; color: #333; margin: 0 0 3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .notif-msg { font-size: 12px; color: #777; margin: 0 0 4px; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        .notif-time { font-size: 11px; color: #aaa; }
        .notif-unread-dot { width: 8px; height: 8px; background: #119864; border-radius: 50%; flex-shrink: 0; align-self: center; }
        .notif-empty {
            padding: 40px 20px; text-align: center; color: #aaa;
        }
        .notif-empty i { font-size: 36px; display: block; margin-bottom: 10px; color: #ddd; }
        .notif-empty p { margin: 0; font-size: 14px; }
    </style>

    <script>
        // ===== NOTIFICATION BELL SYSTEM =====
        let notifDropdownOpen = false;

        function toggleNotifDropdown(e) {
            e.stopPropagation();
            const dd = document.getElementById('notifDropdown');
            notifDropdownOpen = !notifDropdownOpen;
            dd.classList.toggle('show', notifDropdownOpen);
            if (notifDropdownOpen) fetchNotifications();
        }

        document.addEventListener('click', function(e) {
            const wrapper = document.getElementById('notifBellWrapper');
            if (wrapper && !wrapper.contains(e.target)) {
                document.getElementById('notifDropdown')?.classList.remove('show');
                notifDropdownOpen = false;
            }
        });

        async function fetchNotifications() {
            try {
                const res = await fetch('/NotificationApi?handler=Fetch');
                const data = await res.json();
                renderNotifications(data.notifications, data.unreadCount);
            } catch(e) { console.error('Failed to fetch notifications', e); }
        }

        function getTypeClass(type) {
            switch(type) {
                case 'Ticket': return 'ticket';
                case 'Donation': return 'donation';
                case 'EventRequest': return 'event';
                case 'Contact': return 'contact';
                default: return 'system';
            }
        }

        function renderNotifications(notifs, unreadCount) {
            const badge = document.getElementById('notifBadge');
            if (badge) {
                if (unreadCount > 0) {
                    badge.textContent = unreadCount > 99 ? '99+' : unreadCount;
                    badge.style.display = 'flex';
                } else {
                    badge.style.display = 'none';
                }
            }

            const list = document.getElementById('notifList');
            if (!list) return;

            if (!notifs || notifs.length === 0) {
                list.innerHTML = '<div class="notif-empty"><i class="fa fa-check-circle"></i><p>All caught up!</p></div>';
                return;
            }

            list.innerHTML = notifs.map(n => `
                <div class="notif-item ${n.isRead ? '' : 'unread'}" onclick="markNotifRead(${n.id}, this)">
                    <div class="notif-icon ${getTypeClass(n.type)}"><i class="fa ${n.icon}"></i></div>
                    <div class="notif-body">
                        <p class="notif-title">${n.title}</p>
                        <p class="notif-msg">${n.message}</p>
                        <span class="notif-time"><i class="fa fa-clock-o"></i> ${n.createdAt}</span>
                    </div>
                    ${n.isRead ? '' : '<div class="notif-unread-dot"></div>'}
                </div>
            `).join('');
        }

        async function markNotifRead(id, el) {
            el.classList.remove('unread');
            const dot = el.querySelector('.notif-unread-dot');
            if (dot) dot.remove();
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                await fetch(`/NotificationApi?handler=MarkRead&id=${id}`, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token }
                });
                // Update badge
                const badge = document.getElementById('notifBadge');
                if (badge) {
                    let count = parseInt(badge.textContent) || 0;
                    count = Math.max(0, count - 1);
                    badge.textContent = count;
                    if (count === 0) badge.style.display = 'none';
                }
            } catch(e) { console.error(e); }
        }

        async function markAllNotifRead() {
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                await fetch('/NotificationApi?handler=MarkAllRead', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token }
                });
                document.querySelectorAll('.notif-item.unread').forEach(el => {
                    el.classList.remove('unread');
                    const dot = el.querySelector('.notif-unread-dot');
                    if (dot) dot.remove();
                });
                const badge = document.getElementById('notifBadge');
                if (badge) { badge.textContent = '0'; badge.style.display = 'none'; }
            } catch(e) { console.error(e); }
        }

        // Auto-fetch on page load if authenticated
        if (document.getElementById('notifBellWrapper')) {
            fetchNotifications();
            setInterval(fetchNotifications, 30000); // Refresh every 30s
        }
    </script>

    <!-- ══════════════ PREMIUM GLOBAL CUSTOM POPUPS (ALERT & CONFIRM) ══════════════ -->
    <div id="premiumAlertModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.55); backdrop-filter: blur(8px); z-index: 999999; align-items: center; justify-content: center; font-family: 'Outfit', sans-serif;">
        <div style="background: #fff; border-radius: 16px; width: 400px; max-width: 90%; padding: 30px; box-shadow: 0 15px 40px rgba(0,0,0,0.25); text-align: center; border: 2.5px solid #119864; animation: pModalScale 0.3s ease;">
            <div style="width: 70px; height: 70px; border-radius: 50%; background: #e8f5e9; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; border: 2px solid #119864;">
                <i class="fa fa-info-circle" style="font-size: 32px; color: #119864;"></i>
            </div>
            <h3 style="margin: 0 0 10px; font-size: 22px; font-weight: 700; color: #1a3a2a;">Message</h3>
            <p id="premiumAlertMessage" style="margin: 0 0 25px; font-size: 15px; color: #555; line-height: 1.6;"></p>
            <button onclick="closePremiumAlert()" style="background: linear-gradient(135deg, #119864 0%, #1a5e3a 100%); color: #fff; border: none; border-radius: 25px; padding: 12px 35px; font-size: 14px; font-weight: 700; cursor: pointer; transition: all 0.2s; min-width: 120px; outline: none; box-shadow: 0 4px 12px rgba(17,152,100,0.25);">OK</button>
        </div>
    </div>

    <div id="premiumConfirmModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.55); backdrop-filter: blur(8px); z-index: 999999; align-items: center; justify-content: center; font-family: 'Outfit', sans-serif;">
        <div style="background: #fff; border-radius: 16px; width: 420px; max-width: 90%; padding: 30px; box-shadow: 0 15px 40px rgba(0,0,0,0.25); text-align: center; border: 2.5px solid #119864; animation: pModalScale 0.3s ease;">
            <div style="width: 70px; height: 70px; border-radius: 50%; background: #e8f5e9; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; border: 2px solid #119864;">
                <i class="fa fa-question-circle" style="font-size: 32px; color: #119864;"></i>
            </div>
            <h3 style="margin: 0 0 10px; font-size: 22px; font-weight: 700; color: #1a3a2a;">Confirm Action</h3>
            <p id="premiumConfirmMessage" style="margin: 0 0 25px; font-size: 15px; color: #555; line-height: 1.6;"></p>
            <div style="display: flex; gap: 15px; justify-content: center;">
                <button onclick="closePremiumConfirm(false)" style="background: #f5f5f5; color: #555; border: 1.5px solid #ddd; border-radius: 25px; padding: 12px 30px; font-size: 14px; font-weight: 700; cursor: pointer; transition: all 0.2s; min-width: 110px; outline: none;">Cancel</button>
                <button onclick="closePremiumConfirm(true)" style="background: linear-gradient(135deg, #119864 0%, #1a5e3a 100%); color: #fff; border: none; border-radius: 25px; padding: 12px 30px; font-size: 14px; font-weight: 700; cursor: pointer; transition: all 0.2s; min-width: 110px; outline: none; box-shadow: 0 4px 12px rgba(17,152,100,0.25);">Confirm</button>
            </div>
        </div>
    </div>

    <style>
        @@keyframes pModalScale {
            from { transform: scale(0.9); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }
    </style>

    <script>
        let premiumConfirmCallback = null;

        function showPremiumAlert(msg) {
            document.getElementById('premiumAlertMessage').innerText = msg;
            document.getElementById('premiumAlertModal').style.display = 'flex';
        }

        function closePremiumAlert() {
            document.getElementById('premiumAlertModal').style.display = 'none';
        }

        function showPremiumConfirm(msg, callback) {
            document.getElementById('premiumConfirmMessage').innerText = msg;
            premiumConfirmCallback = callback;
            document.getElementById('premiumConfirmModal').style.display = 'flex';
        }

        function closePremiumConfirm(approved) {
            document.getElementById('premiumConfirmModal').style.display = 'none';
            if (approved && premiumConfirmCallback) {
                premiumConfirmCallback();
            }
            premiumConfirmCallback = null;
        }

        // Global Alert Override
        window.alert = function(msg) {
            showPremiumAlert(msg);
        };

        // Form Submit Confirm Interception
        document.addEventListener('submit', function(e) {
            const form = e.target;
            const onsubmitAttr = form.getAttribute('onsubmit');
            if (onsubmitAttr && onsubmitAttr.includes('confirm(')) {
                e.preventDefault();
                e.stopImmediatePropagation();
                const match = onsubmitAttr.match(/confirm\(['"](.*?)['"]\)/);
                const msg = match ? match[1] : "Are you sure you want to proceed?";
                showPremiumConfirm(msg, () => {
                    form.removeAttribute('onsubmit');
                    form.submit();
                });
            }
        }, true);
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
