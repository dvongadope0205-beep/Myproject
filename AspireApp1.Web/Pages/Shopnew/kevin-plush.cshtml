@page
@using Microsoft.Data.SqlClient
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
    Layout = "~/Pages/Shopnew/Shared/_Layout.cshtml";
    
    // Default values (from static template)
    string title = "Batrick Plush with Sunglasses and Hawaiian Shirt";
    string category = "Apparel";
    string price = "$21";
    string originalPriceStr = "$27";
    string imagePath = "/Source/shop-img/plush/batrick hawaiin/1/1-batrick-hawaiin-2048x2048.png";
    string description = "";
    string productInformation = "<p><strong>The Official Natural Habitat Batrick Plush with Sunglasses &amp; Hawaiian Shirt</strong></p><p>Fun Fact: <meta charset=\"utf-8\"/><span>Bats use echolocation to find things they canâ€™t see.</span><span style=\"font-weight: 400;\"></span></p>";
    string productDetail = "Removable Felt sunglasses<br/>Made with high-quality, plush material<br/>Stuffed with 100% cotton polyester<br/>Features Batrick's prominent ears and a dapper outfit<br/>Features: sunglasses, Hawaiian shirt<br/>100% Polyester<br/>10\" Tall<br/>Includes Collector Card";
    string materialAndCare = "Spot Clean Only";
    List<string> imagesList = new List<string> {
        "/Source/shop-img/plush/batrick hawaiin/1/1-batrick-hawaiin-2048x2048.png",
        "/Source/shop-img/plush/batrick hawaiin/2/2-batrick-hawaiin-2048x2048.png",
        "/Source/shop-img/plush/batrick hawaiin/3/3-batrick-hawaiin-2048x2048.jpg",
        "/Source/shop-img/plush/batrick hawaiin/4/4-batrick-hawaiin-2048x2048.jpg",
        "/Source/shop-img/plush/batrick hawaiin/5/5-batrick-hawaiin-2048x2048.jpg",
        "/Source/shop-img/plush/batrick hawaiin/6/6-batrick-hawaiin-2048x2048.jpg",
        "/Source/shop-img/plush/batrick hawaiin/7/7-batrick-hawaiin-2048x2048.jpg",
        "/Source/shop-img/plush/batrick hawaiin/8/8-batrick-hawaiin-2048x2048.jpg",
        "/Source/shop-img/plush/batrick hawaiin/9/9-batrick-hawaiin-2048x2048.jpg",
        "/Source/shop-img/plush/batrick hawaiin/10/10-batrick-hawaiin-2048x2048.png",
        "/Source/shop-img/plush/batrick hawaiin/11/11-batrick-hawaiin-2048x2048.jpg"
    };
    int productId = 0;
    string variantId = "50032197173538"; // default variant ID from static template
    bool isDbProduct = false;

    var slug = "kevin-plush";
    if (!string.IsNullOrEmpty(slug))
    {
        string connStr = Configuration.GetConnectionString("DefaultConnection");
        using (SqlConnection conn = new SqlConnection(connStr))
        {
            conn.Open();
            string sql = @"SELECT p.ProductId, p.Name, p.Description, p.Price, p.OriginalPrice, p.ImagePath, p.AdditionalImages, 
                                  p.ProductInformation, p.ProductDetail, p.MaterialAndCare, ISNULL(c.Name, 'Apparel')
                           FROM ShopProducts p
                           LEFT JOIN ShopCategories c ON p.CategoryId = c.CategoryId
                           WHERE p.Slug = @Slug OR p.PageSlug = @Slug";
            using (SqlCommand cmd = new SqlCommand(sql, conn))
            {
                cmd.Parameters.AddWithValue("@Slug", slug);
                using (SqlDataReader reader = cmd.ExecuteReader())
                {
                    if (reader.Read())
                    {
                        isDbProduct = true;
                        productId = reader.GetInt32(0);
                        variantId = "product-" + productId;
                        title = reader.IsDBNull(1) ? "" : reader.GetString(1);
                        description = reader.IsDBNull(2) ? "" : reader.GetString(2);
                        decimal priceVal = reader.IsDBNull(3) ? 0 : reader.GetDecimal(3);
                        price = priceVal % 1 == 0 ? $"${(int)priceVal}" : $"${priceVal:F2}";
                        
                        if (!reader.IsDBNull(4))
                        {
                            decimal origVal = reader.GetDecimal(4);
                            originalPriceStr = origVal % 1 == 0 ? $"${(int)origVal}" : $"${origVal:F2}";
                        }
                        else
                        {
                            originalPriceStr = "";
                        }
                        
                        imagePath = reader.IsDBNull(5) ? "" : reader.GetString(5);
                        
                        string additional = reader.IsDBNull(6) ? "" : reader.GetString(6);
                        imagesList = new List<string>();
                        if (!string.IsNullOrEmpty(imagePath))
                        {
                            imagesList.Add(imagePath);
                        }
                        if (!string.IsNullOrEmpty(additional))
                        {
                            var parts = additional.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries);
                            foreach (var p in parts)
                            {
                                string trimmed = p.Trim();
                                if (!imagesList.Contains(trimmed))
                                {
                                    imagesList.Add(trimmed);
                                }
                            }
                        }
                        
                        productInformation = reader.IsDBNull(7) ? "" : reader.GetString(7);
                        productDetail = reader.IsDBNull(8) ? "" : reader.GetString(8);
                        materialAndCare = reader.IsDBNull(9) ? "" : reader.GetString(9);
                        category = reader.GetString(10);
                    }
                }
            }
        }
    }

    ViewData["Title"] = title + " - Natural Habitat";
}
