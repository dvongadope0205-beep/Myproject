<script>
        document.addEventListener('DOMContentLoaded', function() {
            initCartEffects();
            initFeatures();
            @if (TempData["ContactSuccess"] != null)
            {
                <text>
                showPremiumAlert('@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(TempData["ContactSuccess"].ToString()))');
                </text>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <text>
                showPremiumAlert('@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(TempData["ErrorMessage"].ToString()))');
                </text>
            }
        });
    </script>
