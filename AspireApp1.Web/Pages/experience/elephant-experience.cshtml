<!-- ======================================================
     JAVASCRIPT
     ====================================================== -->

@section Scripts {
    <script>
(function () {
  'use strict';

  /* ---- Image data ---- */
  const IMAGES = [
    {
      src: '/Source/experience/meet/elephant/elephant-carousel-1.jpeg',
      alt: 'Close-up portrait of zebra stripes'
    },
    {
      src: '/Source/experience/meet/elephant/elephant-carousel-2.jpeg',
      alt: 'Giraffe standing under an acacia tree in the savannah'
    },
    {
      src: '/Source/experience/meet/elephant/elephant-carousel-3.jpeg',
      alt: 'Zebras drinking at a watering hole at sunset'
    }, 
    {
      src: '/Source/experience/meet/elephant/elephant-carousel-5.jpeg',
      alt: 'Macro shot of a giraffe\'s eye and eyelashes'
    }
  ];

  /* ================================================================
     CAROUSEL
     ================================================================ */
  const track      = document.getElementById('carouselTrack');
  const arrowPrev  = document.getElementById('arrowPrev');
  const arrowNext  = document.getElementById('arrowNext');
  const headerPrev = document.getElementById('headerPrev');
  const headerNext = document.getElementById('headerNext');

  let slideIndex = 0;

  function itemsPerView() {
    return window.innerWidth < 768 ? 2 : 4;
  }

  function maxSlide() {
    return Math.max(0, IMAGES.length - itemsPerView());
  }

  function updateTrack() {
    const items   = track.querySelectorAll('.carousel-item');
    if (!items.length) return;
    // Calculate real item width including gap
    const gap      = 16;
    const itemW    = items[0].offsetWidth + gap;
    track.style.transform = `translateX(-${slideIndex * itemW}px)`;
  }

  function slideTo(dir) {
    slideIndex = slideIndex + dir;
    if (slideIndex > maxSlide()) slideIndex = 0;
    if (slideIndex < 0) slideIndex = maxSlide();
    updateTrack();
  }

  arrowPrev.addEventListener('click',  () => slideTo(-1));
  arrowNext.addEventListener('click',  () => slideTo(1));
  headerPrev.addEventListener('click', () => slideTo(-1));
  headerNext.addEventListener('click', () => slideTo(1));

  window.addEventListener('resize', () => {
    slideIndex = Math.min(slideIndex, maxSlide());
    updateTrack();
  });

  /* ================================================================
     THEATER MODE
     ================================================================ */
  const overlay       = document.getElementById('theaterOverlay');
  const theaterImg    = document.getElementById('theaterImg');
  const theaterClose  = document.getElementById('theaterClose');
  const theaterPrev   = document.getElementById('theaterPrev');
  const theaterNext   = document.getElementById('theaterNext');
  const theaterCounter= document.getElementById('theaterCounter');

  let theaterIndex = 0;

  function openTheater(index) {
    theaterIndex = index;
    renderTheaterImage();
    overlay.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }

  function closeTheater() {
    overlay.classList.remove('is-open');
    document.body.style.overflow = '';
  }

  function renderTheaterImage() {
    theaterImg.style.opacity = '0';
    setTimeout(() => {
      const img = IMAGES[theaterIndex];
      theaterImg.src = img.src;
      theaterImg.alt = img.alt;
      theaterCounter.textContent = (theaterIndex + 1) + ' / ' + IMAGES.length;
      theaterImg.style.opacity = '1';
    }, 180);
  }

  function navigateTheater(dir) {
    theaterIndex = (theaterIndex + dir + IMAGES.length) % IMAGES.length;
    renderTheaterImage();
  }

  // Wire carousel items to open theater
  document.querySelectorAll('.carousel-item').forEach(function (item) {
    item.addEventListener('click', function () {
      openTheater(parseInt(item.dataset.index, 10));
    });
  });

  theaterClose.addEventListener('click', closeTheater);
  theaterPrev.addEventListener('click',  function () { navigateTheater(-1); });
  theaterNext.addEventListener('click',  function () { navigateTheater(1); });

  // Click backdrop to close
  overlay.addEventListener('click', function (e) {
    if (e.target === overlay) closeTheater();
  });

  // Keyboard controls
  document.addEventListener('keydown', function (e) {
    if (!overlay.classList.contains('is-open')) return;
    if (e.key === 'ArrowLeft')  navigateTheater(-1);
    if (e.key === 'ArrowRight') navigateTheater(1);
    if (e.key === 'Escape')     closeTheater();
  });

  /* ================================================================
     MOUSE GLOW
     ================================================================ */
  var glow = document.getElementById('interaction-glow');
  document.addEventListener('mousemove', function (e) {
    glow.style.left = (e.clientX - 300) + 'px';
    glow.style.top  = (e.clientY - 300) + 'px';
  });

  /* ================================================================
     MAP PARALLAX
     ================================================================ */
  var mapCard = document.querySelector('.map-card');
  window.addEventListener('scroll', function () {
    if (!mapCard) return;
    var s = window.pageYOffset;
    mapCard.style.transform =
      'translateY(' + (s * 0.05) + 'px) rotate(' + (1 + s * 0.005) + 'deg)';
  });

})();
    </script>
}

