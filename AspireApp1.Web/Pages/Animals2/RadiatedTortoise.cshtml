@page
@model ZooProject.Pages.RadiatedTortoise
@{
    ViewData["HideHeader"] = true;
    ViewData["HideFooter"] = true;
}

<style>

        /* === BẢNG MÀU CHỦ ĐẠO XANH LÁ, TRẮNG PHỤ ĐẠO === */
        :root {
            --bg-main: #161D08;       
            --text-primary: #ffffff;  
            --text-muted: #C8D0BF;    
            --accent-green: #424D2C;  
            --band-bg: #293416;       
            --band-border: #636D4B;   
            
            /* Màu đỏ cho mức độ Critically Endangered */
            --iucn-critically-endangered: #FF2400; 
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-primary);
            font-family: 'DM Sans', sans-serif;
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
        }

        .container {
            max-width: 1360px; 
            margin: 0 auto;
            padding: 60px 40px;
        }

        /* --- FIG IMAGE BANNER TRẢI DÀI NẰM NGANG & OVERLAY TIÊU ĐỀ --- */
        .fig-image-wrapper {
            position: relative;
            margin: 0 0 60px 0;
            width: 100%;
            height: 520px; 
            overflow: hidden;
            background: #111; 
        }

        .fig-image-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover; 
            display: block;
            position: relative;
            z-index: 1;
        }

        .fig-image-wrapper::after {
            content: '';
            position: absolute;
            left: 0;
            bottom: 0;
            width: 100%;
            height: 60%;
            background: linear-gradient(to top, rgba(22, 29, 8, 0.95) 0%, rgba(22, 29, 8, 0.4) 50%, transparent 100%);
            z-index: 2;
            pointer-events: none;
        }

        .hero-text-overlay {
            position: absolute;
            bottom: 40px;
            left: 40px;
            right: 40px;
            z-index: 3; 
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .header-title {
            font-family: 'DM Sans', sans-serif;
            font-size: 14px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 6px;
            color: #FEB800; 
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 4px;
        }
        
        .header-title::before {
            content: '';
            display: inline-block;
            width: 3px;
            height: 14px;
            background: #FEB800;
        }

        .header-subtitle {
            font-family: 'Playfair Display', serif;
            font-size: 26px;
            font-style: italic;
            color: var(--text-muted);
        }

        .iucn-badge-inline {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            margin-top: 6px;
        }

        .iucn-tag {
            font-family: 'Space Mono', monospace;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--text-muted);
        }

        .iucn-status-value {
            color: var(--iucn-critically-endangered); 
            font-family: 'Playfair Display', serif;
            font-size: 22px;
            font-weight: 700;
        }

        /* --- BỐ CỤC NỘI DUNG DÀN TRẢI ĐỀU --- */
        .content-split {
            display: grid;
            grid-template-columns: 1.2fr 0.8fr; 
            gap: 60px;
            margin-bottom: 80px;
            align-items: start;
        }

        .carousel-container {
            position: relative;
            padding-right: 20px;
        }

        /* Đường gạch đứt phân cách */
        .carousel-container::after {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            bottom: 0;
            width: 1px;
            background-image: linear-gradient(to bottom, var(--band-border) 70%, transparent 30%);
            background-size: 100% 8px;
        }

        .carousel-slide {
            display: none;
            animation: fadeIn 0.4s ease-in-out;
        }

        .carousel-slide.active {
            display: block;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .carousel-italic {
            font-family: 'Playfair Display', serif;
            font-size: 30px;
            font-style: italic;
            line-height: 1.35;
            color: var(--text-primary);
            margin-bottom: 25px;
        }

        .carousel-body {
            font-size: 17px;
            color: var(--text-muted);
            line-height: 1.7;
            margin-bottom: 40px;
        }

        .image-placeholder-slot {
            width: 100%;
            height: 140px; 
            background-color: #0c1104;
            border: 1px dashed var(--band-border);
            margin-bottom: 15px;
            overflow: hidden; 
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .image-placeholder-slot img {
            width: 100%;
            height: 100%;
            object-fit: cover; 
            display: block;
        }

        .carousel-controls {
            display: flex;
            align-items: center;
            gap: 20px;
            font-family: 'Space Mono', monospace;
            font-size: 14px;
            font-weight: 700;
        }

        .carousel-controls button {
            background: none;
            border: 1px solid var(--text-primary);
            color: var(--text-primary);
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .carousel-controls button:hover {
            background: var(--text-primary);
            color: var(--bg-main);
        }

        .slide-indicator {
            letter-spacing: 2px;
        }

        /* Fact Grid */
        .fact-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 50px 40px;
        }

        .fact-item {
            border-top: 2px solid var(--text-primary);
            padding-top: 15px;
        }

        .fact-label {
            font-family: 'Space Mono', monospace;
            font-size: 11px;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--text-muted);
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px; 
        }

        .fact-label svg {
            width: 14px;
            height: 14px;
            fill: none;
            stroke: var(--text-muted);
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .fact-value {
            font-family: 'Playfair Display', serif;
            font-size: 24px;
            font-weight: 700;
            line-height: 1.2;
            color: var(--text-primary);
        }

        /* --- DOCUMENTARY BAND --- */
        .doc-band {
            position: relative;
            background-color: var(--band-bg);
            padding: 70px 40px;
            width: 100vw;
            margin-left: calc(-50vw + 50%);
        }

        .dashed-border-top, .dashed-border-bottom {
            position: absolute;
            left: 0;
            right: 0;
            height: 8px;
            background-image: linear-gradient(to right, var(--band-border) 50%, transparent 50%);
            background-size: 16px 100%;
        }

        .dashed-border-top { top: 0; }
        .dashed-border-bottom { bottom: 0; }

        .doc-container {
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 30px;
        }

        .doc-text h3 {
            font-family: 'Playfair Display', serif;
            font-size: 42px;
            color: var(--text-primary);
            margin-bottom: 8px;
        }

        .doc-text p {
            font-size: 18px;
            color: var(--text-muted);
        }

        .doc-btn {
            background-color: var(--text-primary);
            color: var(--bg-main);
            text-decoration: none;
            padding: 16px 32px;
            font-family: 'Space Mono', monospace;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            display: inline-flex;
            align-items: center;
            gap: 12px;
            transition: background 0.3s ease;
        }

        .doc-btn:hover {
            background-color: var(--accent-green);
            color: #ffffff;
        }

        .play-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 24px;
            height: 24px;
            border: 2px solid var(--bg-main);
            border-radius: 50%;
            font-size: 10px;
            padding-left: 2px;
        }

        /* Responsive */
        @@media (max-width: 900px) {
            .content-split { grid-template-columns: 1fr; gap: 60px; }
            .fig-image-wrapper { height: 350px; }
            .doc-container { flex-direction: column; align-items: flex-start; }
        }
    
</style>



    
<a href="/Animals2" class="back-to-animals2" style="position: fixed; top: 30px; left: 30px; z-index: 9999; display: inline-flex; align-items: center; gap: 10px; background: rgba(0, 0, 0, 0.6); backdrop-filter: blur(8px); border: 1px solid rgba(255, 255, 255, 0.15); color: #fff; padding: 12px 24px; border-radius: 30px; text-decoration: none; font-family: 'Space Mono', monospace; font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1); box-shadow: 0 4px 15px rgba(0,0,0,0.3);" onmouseover="this.style.background='#119864'; this.style.borderColor='#119864'; this.style.transform='translateX(-5px)';" onmouseout="this.style.background='rgba(0, 0, 0, 0.6)'; this.style.borderColor='rgba(255, 255, 255, 0.15)'; this.style.transform='translateX(0)';">
    <i class="fa fa-chevron-left" style="font-size: 14px;"></i>
    <span>back to Animal</span>
</a>

<main class="container">
        
        <section class="fig-image-wrapper">
            <img src="/Source/Animals2/radiated-tortoise/radiated-tortoise.jpg" alt="Radiated Tortoise Expedition">
            
            <div class="hero-text-overlay">
                <div class="header-title">The Starry Sentinel</div>
                <h2 class="header-subtitle">Radiated tortoise (Astrochelys radiata)</h2>
                <div class="iucn-badge-inline">
                    <span class="iucn-tag">IUCN Status:</span>
                    <span class="iucn-status-value">Critically Endangered</span>
                </div>
            </div>
        </section>

        <section class="content-split">
            
            <div class="carousel-container">
                <div id="carouselTrack">
                    
                    <!-- Slide 1: About -->
                    <div class="carousel-slide active">
                        <div class="carousel-italic">
                            Adorned with <span style="color: var(--iucn-critically-endangered); border-bottom: 2px solid var(--text-primary); font-weight: 700;">star-patterned shells</span>, these beautiful reptiles are renowned for their staggering ability to live for <span style="border-bottom: 2px solid var(--text-primary); font-weight: 700;">over a century</span>.
                        </div>
                        <div class="carousel-body">
                            <p style="margin-bottom: 12px;">Despite their tough, protective exterior, their striking shells actually contain active nerves and blood vessels, meaning the tortoise can physically feel whenever it is touched. They typically live peaceful, solitary lives, though it is not uncommon to see several grazing together, which naturally helps keep local vegetation closely trimmed.</p>
                            <p>Females bury between five and twelve eggs in a hole, which then undergo a lengthy incubation period of five to eight months. They possess one of the longest lifespans of any animal on Earth, with one incredible individual recorded to have lived to an astonishing 188 years old!</p>
                        </div>
                    </div>

                    <!-- Slide 2: Threats -->
                    <div class="carousel-slide">
                        <div class="carousel-italic">
                            A living ancient treasure disappearing from the dry tropical forests. They face a devastating assault from <span style="color: #ff2400; border-bottom: 2px solid var(--text-primary); font-weight: 700;">relentless deforestation</span> and the <span style="font-weight: 700; color: var(--iucn-critically-endangered)">illegal pet trade</span>.
                        </div>
                        <div class="carousel-body">
                            <p style="margin-bottom: 12px;">Native mostly to southern Madagascar, the wild population of this stunning species is experiencing a steady and alarming decline. The dry, spiny forests, rocky outcroppings, and sandy coastal shrubs they rely on are being rapidly destroyed by aggressive habitat loss and human intervention.</p>
                            <p>Compounding the devastating loss of their home, they are heavily targeted for hunting and collection to supply the illegal global pet trade, pushing these magnificent, century-old wanderers dangerously close to complete extinction.</p>
                        </div>
                    </div>

                    <div class="carousel-slide">
                        <div class="carousel-italic" style="font-size: 26px; margin-bottom: 25px;">
                            Support & Experience the Wildlife Firsthand
                        </div>
                        <div class="carousel-body">
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 30px; text-align: left;">
                                
                                <div style="border-left: 2px solid var(--text-muted); padding-left: 15px;">
                                    <div class="image-placeholder-slot">
                                        <img src="/Source/Animals2/radiated-tortoise/tortoise-ticket.jpg" alt="Tortoise Ticket">
                                    </div>
                                    <h4 style="font-family: 'Playfair Display', serif; font-size: 18px; color: var(--text-primary); margin-bottom: 6px;">Visit your favourite animals</h4>
                                    <p style="font-size: 14px; color: var(--text-muted); margin-bottom: 15px; line-height: 1.4;">Book your visit today and see all the amazing animals at the zoo!</p>
                                    <a href="#" class="doc-btn" style="padding: 8px 16px; font-size: 11px;">Book Now</a>
                                </div>
                                
                                <div style="border-left: 2px solid var(--text-muted); padding-left: 15px;">
                                    <div class="image-placeholder-slot">
                                        <img src="/Source/Animals2/radiated-tortoise/tortoise-membership.jpg" alt="Tortoise Member">
                                    </div>
                                    <h4 style="font-family: 'Playfair Display', serif; font-size: 18px; color: var(--text-primary); margin-bottom: 6px;">Become a member and don't miss a thing</h4>
                                    <p style="font-size: 14px; color: var(--text-muted); margin-bottom: 15px; line-height: 1.4;">See these magnificent animals any day you like with free unlimited entry for a year, plus up to 10% off future experiences.</p>
                                    <a href="#" class="doc-btn" style="padding: 8px 16px; font-size: 11px;">Become a Member</a>
                                </div>

                            </div>
                        </div>
                    </div>

                </div>

                <div class="carousel-controls">
                    <button id="prevBtn" aria-label="Previous Slide">←</button>
                    <span class="slide-indicator" id="slideIndicator">1 / 3</span>
                    <button id="nextBtn" aria-label="Next Slide">→</button>
                </div>
            </div>

            <div class="fact-grid">
                
                <!-- Species Fact -->
                <div class="fact-item">
                    <div class="fact-label">
                        <svg viewBox="0 0 24 24">
                            <circle cx="12" cy="13" r="6" />
                            <path d="M12 7v12M6 13h12" />
                            <path d="M12 7V4a1.5 1.5 0 0 1 3 0v1" />
                            <path d="M5.5 9.5L3 8M18.5 9.5L21 8M6 17.5l-2 1.5M18 17.5l2 1.5" />
                        </svg>
                        Species
                    </div>
                    <div class="fact-value">Reptile </div>
                </div>
                
                <!-- Life Span Fact -->
                <div class="fact-item">
                    <div class="fact-label">
                        <svg viewBox="0 0 24 24"><path d="M5 2h14M5 22h14M7 2l5 8 5-8M7 22l5-8 5 8"/></svg>
                        Life Span
                    </div>
                    <div class="fact-value">Over a century</div>
                </div>
                
                <!-- Habitat Fact -->
                <div class="fact-item">
                    <div class="fact-label">
                        <svg viewBox="0 0 24 24"><polygon points="12,2 3,17 21,17"/><line x1="12" y1="17" x2="12" y2="22"/></svg>
                        Habitat
                    </div>
                    <div class="fact-value">Dry tropical forests (Spiny scrub)</div>
                </div>
                
                <!-- Region Fact -->
                <div class="fact-item">
                    <div class="fact-label">
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="22" y1="12" x2="2" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                        Region
                    </div>
                    <div class="fact-value">Southwestern Madagascar</div>
                </div>
                
                <!-- Diet Fact -->
                <div class="fact-item">
                    <div class="fact-label">
                        <svg viewBox="0 0 24 24">
                            <path d="M12 22V12" />
                            <path d="M12 12c4-3 5-7 5-7s-4 0-7 4c-1.3 1.7-1.5 3.5-1 4.5z" />
                            <path d="M12 15c-3-1.5-4.5-4.5-4.5-4.5s2.5-.5 4.5 2" />
                        </svg>
                        Diet
                    </div>
                    <div class="fact-value">Herbivore </div>
                    <span style="font-size: 14px; font-family: 'DM Sans', sans-serif; font-weight: 400; color: var(--text-muted);">Dead leaves, fruit & cacti</span>
                </div>
                
                <!-- Avg Size Fact -->
                <div class="fact-item">
                    <div class="fact-label">
                        <svg viewBox="0 0 24 24"><rect x="1" y="8" width="22" height="8" rx="1"/><line x1="5" y1="8" x2="5" y2="12"/><line x1="9" y1="8" x2="9" y2="14"/><line x1="13" y1="8" x2="13" y2="12"/><line x1="17" y1="8" x2="17" y2="14"/></svg>
                        Avg Size
                    </div>
                    <div class="fact-value">41 cm</div>
                </div>
                
                <!-- Behaviour & Zoo Location Fact -->
                <div class="fact-item" style="grid-column: span 2;">
                    <div class="fact-label">
                        <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        Behaviour & Zoo Location
                    </div>
                    <div class="fact-value" style="font-size: 21px; line-height: 1.3;">
                        Friendly & peaceful <br>
                        <span style="font-size: 14px; font-family: 'Space Mono', monospace; font-weight: 400; color: var(--text-muted); margin-top: 8px; display: inline-block;">Located in the Tropical Realm</span>
                    </div>
                </div>
            </div>

        </section>

    </main>

    <section class="doc-band">
        <div class="dashed-border-top"></div>
        <div class="doc-container">
            <div class="doc-text">
                <h3> A Century in the Sand </h3>
                <p> Explore the resilient nature of these wandering sentinels as they navigate a shrinking habitat heavily targeted by illegal collection. </p>
            </div>
            <a href="https://youtu.be/1RwregXhD_0?si=CV33oGHTSSGId3O4" target="_blank" class="doc-btn">
                <span class="play-icon">▶</span> Watch Film
            </a>
        </div>
        <div class="dashed-border-bottom"></div>
    </section>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const slides = document.querySelectorAll('.carousel-slide');
            const totalSlides = slides.length;
            const indicator = document.getElementById('slideIndicator');
            let currentSlide = 0;

            function updateSlide(index) {
                slides.forEach(slide => slide.classList.remove('active'));
                slides[index].classList.add('active');
                indicator.textContent = `0${index + 1} / 0${totalSlides}`;
            }

            document.getElementById('nextBtn').addEventListener('click', () => {
                currentSlide = (currentSlide + 1) % totalSlides;
                updateSlide(currentSlide);
            });

            document.getElementById('prevBtn').addEventListener('click', () => {
                currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
                updateSlide(currentSlide);
            });

            updateSlide(currentSlide);
        });
    </script>


