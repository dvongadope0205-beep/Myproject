@page "/Shop2/{slug}"
@using Microsoft.Data.SqlClient
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
    Layout = "~/Pages/Shop2/Shared/_Layout.cshtml";
    
    // Read route parameter 'slug'
    var slug = RouteData.Values["slug"]?.ToString();
    
    // Default values (from static template)
    string title = "Product Detail";
    string category = "Apparel";
    string price = "$0";
    string originalPriceStr = "";
    string imagePath = "";
    string description = "";
    string productInformation = "";
    string productDetail = "";
    string materialAndCare = "";
    List<string> imagesList = new List<string>();
    int productId = 0;
    string variantId = "";
    bool isSizeEnabled = false;
    bool isSizeChartEnabled = false;

    if (!string.IsNullOrEmpty(slug))
    {
        string connStr = Configuration.GetConnectionString("DefaultConnection") ?? "";
        using (SqlConnection conn = new SqlConnection(connStr))
        {
            conn.Open();
            string sql = @"SELECT p.ProductId, p.Name, p.Description, p.Price, p.OriginalPrice, p.ImagePath, p.AdditionalImages, 
                                  p.ProductInformation, p.ProductDetail, p.MaterialAndCare, ISNULL(c.Name, 'Apparel'),
                                  p.IsSizeEnabled, p.IsSizeChartEnabled
                           FROM ShopProducts p
                           LEFT JOIN ShopCategories c ON p.CategoryId = c.CategoryId
                           WHERE p.Slug = @Slug OR p.PageSlug = @Slug";
            using (SqlCommand cmd = new SqlCommand(sql, conn))
            {
                cmd.Parameters.AddWithValue("@Slug", slug);
                using (SqlDataReader reader = cmd.ExecuteReader())
                {
                    if (reader.Read())
                    {
                        productId = reader.GetInt32(0);
                        variantId = "product-" + productId;
                        title = reader.IsDBNull(1) ? "" : reader.GetString(1);
                        description = reader.IsDBNull(2) ? "" : reader.GetString(2);
                        decimal priceVal = reader.IsDBNull(3) ? 0 : reader.GetDecimal(3);
                        price = priceVal % 1 == 0 ? $"${(int)priceVal}" : $"${priceVal:F2}";
                        
                        if (!reader.IsDBNull(4))
                        {
                            decimal origVal = reader.GetDecimal(4);
                            originalPriceStr = origVal % 1 == 0 ? $"${(int)origVal}" : $"${origVal:F2}";
                        }
                        else
                        {
                            originalPriceStr = "";
                        }
                        
                        imagePath = reader.IsDBNull(5) ? "" : reader.GetString(5);
                        
                        string additional = reader.IsDBNull(6) ? "" : reader.GetString(6);
                        imagesList = new List<string>();
                        if (!string.IsNullOrEmpty(imagePath))
                        {
                            imagesList.Add(imagePath);
                        }
                        if (!string.IsNullOrEmpty(additional))
                        {
                            var parts = additional.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries);
                            foreach (var p in parts)
                            {
                                string trimmed = p.Trim();
                                if (!imagesList.Contains(trimmed))
                                {
                                    imagesList.Add(trimmed);
                                }
                            }
                        }
                        
                        productInformation = reader.IsDBNull(7) ? "" : reader.GetString(7);
                        productDetail = reader.IsDBNull(8) ? "" : reader.GetString(8);
                        materialAndCare = reader.IsDBNull(9) ? "" : reader.GetString(9);
                        category = reader.GetString(10);
                        isSizeEnabled = reader.IsDBNull(11) ? false : reader.GetBoolean(11);
                        isSizeChartEnabled = reader.IsDBNull(12) ? false : reader.GetBoolean(12);
                    }
                    else
                    {
                        // If product is not found in database, return 404
                        Response.StatusCode = 404;
                        return;
                    }
                }
            }
        }
    }

    ViewData["Title"] = title + " - Natural Habitat";
}

<main class="content-for-layout" id="MainContent" role="main" tabindex="-1">
<!-- PRODUCT SECTION -->
<section class="product-section">
<product-info class="section-template" data-update-url="true" data-url="@slug" id="MainProduct-template--26975595233570__main">
<div class="page-width">
<div class="product-medium">
<!-- LEFT: Image Gallery -->
<div class="product-gallery">
<media-gallery aria-label="Gallery Viewer" class="tibia" data-desktop-layout="thumbnail_slider" data-mobile-layout="default" id="MediaGallery-template" role="region">
<slider-component class="slider-mobile-gutter" id="GalleryViewer-template">
<ul class="product__media-list contains-media list-unstyled slider slider--mobile grid grid--peek" id="Slider-Gallery-template--26975595233570__main" role="presentation">
    @for (int i = 0; i < imagesList.Count; i++)
    {
        var img = imagesList[i];
        string activeClass = (i == 0) ? "is-active" : "";
