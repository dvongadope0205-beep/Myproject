@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
    const isLoggedIn = @((User?.Identity?.IsAuthenticated == true).ToString().ToLower());
    let memName = '', memPrice = 0, memTxRef = null, memInterval = null;

    // Intercept all Buy Now links
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.buy-now, .payment_member, .become-button').forEach(function(btn) {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                // Find parent classification
                const classification = btn.closest('.classification') || btn.closest('.page-header-content');
                if (classification) {
                    const nameEl = classification.querySelector('.text');
                    const priceEl = classification.querySelector('.standard .price');
                    memName = nameEl ? nameEl.innerText.trim() : 'Standard Membership';
                    const priceText = priceEl ? priceEl.innerText.trim() : '$185.85';
                    memPrice = parseFloat(priceText.replace('$','').replace(',','')) || 185.85;
                    if (priceText === 'FREE') memPrice = 0;
                } else {
                    memName = 'Individual Adult';
                    memPrice = 185.85;
                }
                showMemModal();
            });
        });
    });

    function showMemModal() {
        if (!isLoggedIn) { alert('Please login first.'); window.location.href = '/Login'; return; }
        document.getElementById('memSelectedPlan').innerText = memName;
        document.getElementById('memSelectedPrice').innerText = memPrice.toFixed(2);
        const todayStr = new Date().toISOString().split('T')[0];
        const dateInput = document.getElementById('memStartDate');
        dateInput.value = todayStr;
        dateInput.setAttribute('min', todayStr);
        document.getElementById('memStep1').style.display = 'block';
        document.getElementById('memStep2').style.display = 'none';
        document.getElementById('memStep3').style.display = 'none';
        document.getElementById('memStep4').style.display = 'none';
        document.getElementById('memCheckoutOverlay').style.display = 'flex';
    }

    function closeMemModal() { if(memInterval) clearInterval(memInterval); document.getElementById('memCheckoutOverlay').style.display = 'none'; }

    function initMemPayment() {
        const startDate = document.getElementById('memStartDate').value;
        if (!startDate) { alert('Please select a start date.'); return; }
        const todayStr = new Date().toISOString().split('T')[0];
        if (startDate < todayStr) { alert('Membership start date cannot be in the past.'); return; }

        fetch('/Join?handler=InitMembershipPayment', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' },
            body: JSON.stringify({ membershipName: memName, price: memPrice, startDate: startDate })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                memTxRef = data.transactionRef;
                document.getElementById('memStep1').style.display = 'none';
                document.getElementById('memStep2').style.display = 'block';
                document.getElementById('memTxRef').innerText = data.transactionRef;
                document.getElementById('memTxTotal').innerText = '$' + data.totalAmount.toFixed(2);
                const qrEl = document.getElementById('memQrContainer');
                qrEl.innerHTML = '';
                new QRCode(qrEl, { text: window.location.origin + '/ScanQR?r=' + encodeURIComponent(data.transactionRef), width: 180, height: 180, colorDark: '#1a3a2a' });
                // Start polling for QR scan completion
                autoCompleteMem();
            } else alert(data.message);
        })
        .catch(() => alert('Network error.'));
    }

    let memPollInterval = null;
    function autoCompleteMem() {
        setTimeout(() => {
            // Auto-complete: directly confirm payment without waiting for QR scan
            fetch('/Join?handler=ConfirmMembershipPayment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' },
                body: JSON.stringify({ transactionRef: memTxRef })
            })
            .then(r => r.json())
            .then(result => {
                document.getElementById('memStep2').style.display = 'none';
                document.getElementById('memStep3').style.display = 'block';
                setTimeout(() => {
                    document.getElementById('memStep3').style.display = 'none';
                    document.getElementById('memStep4').style.display = 'block';
                    document.getElementById('memSuccessMsg').innerText = result.success ? 'Membership activated! Welcome aboard.' : 'Payment completed successfully!';
                }, 1500);
            })
            .catch(() => {
                document.getElementById('memStep2').style.display = 'none';
                document.getElementById('memStep4').style.display = 'block';
                document.getElementById('memSuccessMsg').innerText = 'Payment completed successfully!';
            });
        }, 7000);
    }

    function confirmMemPayment() { autoCompleteMem(); }

    function closeMemModalWithCleanup() {
        if (memPollInterval) { clearInterval(memPollInterval); memPollInterval = null; }
        if (memInterval) { clearInterval(memInterval); }
        document.getElementById('memCheckoutModal').style.display = 'none';
    }
</script>
