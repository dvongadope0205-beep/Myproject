@page
@model ZooProject.Pages.ParsonsChameleon
@{
    ViewData["HideHeader"] = true;
    ViewData["HideFooter"] = true;
}

<style>

        /* === BẢNG MÀU CHỦ ĐẠO XANH LÁ, TRẮNG PHỤ ĐẠO === */
        :root {
            --bg-main: #161D08;       
            --text-primary: #ffffff;  
            --text-muted: #C8D0BF;    
            --accent-green: #424D2C;  
            --band-bg: #293416;       
            --band-border: #636D4B;   
            
            /* Cập nhật màu trạng thái IUCN sang xanh cốm cho mức độ Near Threatened */
            --iucn-near-threatened: #d5ef84; 
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-primary);
            font-family: 'DM Sans', sans-serif;
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
        }

        .container {
            max-width: 1360px; 
            margin: 0 auto;
            padding: 60px 40px;
        }

        /* --- FIG IMAGE BANNER TRẢI DÀI NẰM NGANG & OVERLAY TIÊU ĐỀ (NATIONAL GEOGRAPHIC STYLE) --- */
        .fig-image-wrapper {
            position: relative;
            margin: 0 0 60px 0;
            width: 100%;
            height: 520px; 
            overflow: hidden;
            background: #111; 
        }

        .fig-image-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover; 
            display: block;
            position: relative;
            z-index: 1;
        }

        .fig-image-wrapper::after {
            content: '';
            position: absolute;
            left: 0;
            bottom: 0;
            width: 100%;
            height: 60%;
            background: linear-gradient(to top, rgba(22, 29, 8, 0.95) 0%, rgba(22, 29, 8, 0.4) 50%, transparent 100%);
            z-index: 2;
            pointer-events: none;
        }

        .hero-text-overlay {
            position: absolute;
            bottom: 40px;
            left: 40px;
            right: 40px;
            z-index: 3; 
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        /* Tinh chỉnh chữ tiêu đề lồng ảnh theo Identity National Geographic */
        .header-title {
            font-family: 'DM Sans', sans-serif;
            font-size: 14px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 6px;
            color: #FEB800; 
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 4px;
        }
        
        .header-title::before {
            content: '';
            display: inline-block;
            width: 3px;
            height: 14px;
            background: #FEB800;
        }

        .header-subtitle {
            font-family: 'Playfair Display', serif;
            font-size: 26px;
            font-style: italic;
            color: var(--text-muted);
        }

        .iucn-badge-inline {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            margin-top: 6px;
        }

        .iucn-tag {
            font-family: 'Space Mono', monospace;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--text-muted);
        }

        .iucn-status-value {
            color: var(--iucn-near-threatened); 
            font-family: 'Playfair Display', serif;
            font-size: 22px;
            font-weight: 700;
        }

        /* --- TINH CHỈNH BỐ CỤC NỘI DUNG DÀN TRẢI ĐỀU THEO HÌNH NẰM NGANG --- */
        .content-split {
            display: grid;
            grid-template-columns: 1.2fr 0.8fr; 
            gap: 60px;
            margin-bottom: 80px;
            align-items: start;
        }

        .carousel-container {
            position: relative;
            padding-right: 20px;
        }

        /* Đường gạch đứt phân cách */
        .carousel-container::after {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            bottom: 0;
            width: 1px;
            background-image: linear-gradient(to bottom, var(--band-border) 70%, transparent 30%);
            background-size: 100% 8px;
        }

        .carousel-slide {
            display: none;
            animation: fadeIn 0.4s ease-in-out;
        }

        .carousel-slide.active {
            display: block;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .carousel-italic {
            font-family: 'Playfair Display', serif;
            font-size: 30px;
            font-style: italic;
            line-height: 1.35;
            color: var(--text-primary);
            margin-bottom: 25px;
        }

        .carousel-body {
            font-size: 17px;
            color: var(--text-muted);
            line-height: 1.7;
            margin-bottom: 40px;
        }

        /* Khung cố định chống tràn tuyệt đối cho ảnh chất lượng cao */
        .image-placeholder-slot {
            width: 100%;
            height: 140px; 
            background-color: #0c1104;
            border: 1px dashed var(--band-border);
            margin-bottom: 15px;
            overflow: hidden; 
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .image-placeholder-slot img {
            width: 100%;
            height: 100%;
            object-fit: cover; 
            display: block;
        }

        .carousel-controls {
            display: flex;
            align-items: center;
            gap: 20px;
            font-family: 'Space Mono', monospace;
            font-size: 14px;
            font-weight: 700;
        }

        .carousel-controls button {
            background: none;
            border: 1px solid var(--text-primary);
            color: var(--text-primary);
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .carousel-controls button:hover {
            background: var(--text-primary);
            color: var(--bg-main);
        }

        .slide-indicator {
            letter-spacing: 2px;
        }

        /* Fact Grid */
        .fact-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 50px 40px;
        }

        .fact-item {
            border-top: 2px solid var(--text-primary);
            padding-top: 15px;
        }

        .fact-label {
            font-family: 'Space Mono', monospace;
            font-size: 11px;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--text-muted);
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px; 
        }

        .fact-label svg {
            width: 16px;
            height: 16px;
            fill: none;
            stroke: var(--text-muted);
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .fact-value {
            font-family: 'Playfair Display', serif;
            font-size: 24px;
            font-weight: 700;
            line-height: 1.2;
            color: var(--text-primary);
        }

        /* --- DOCUMENTARY BAND --- */
        .doc-band {
            position: relative;
            background-color: var(--band-bg);
            padding: 70px 40px;
            width: 100vw;
            margin-left: calc(-50vw + 50%);
        }

        .dashed-border-top, .dashed-border-bottom {
            position: absolute;
            left: 0;
            right: 0;
            height: 8px;
            background-image: linear-gradient(to right, var(--band-border) 50%, transparent 50%);
            background-size: 16px 100%;
        }

        .dashed-border-top { top: 0; }
        .dashed-border-bottom { bottom: 0; }

        .doc-container {
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 30px;
        }

        .doc-text h3 {
            font-family: 'Playfair Display', serif;
            font-size: 42px;
            color: var(--text-primary);
            margin-bottom: 8px;
        }

        .doc-text p {
            font-size: 18px;
            color: var(--text-muted);
        }

        .doc-btn {
            background-color: var(--text-primary);
            color: var(--bg-main);
            text-decoration: none;
            padding: 16px 32px;
            font-family: 'Space Mono', monospace;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            display: inline-flex;
            align-items: center;
            gap: 12px;
            transition: background 0.3s ease;
        }

        .doc-btn:hover {
            background-color: var(--accent-green);
            color: #ffffff;
        }

        .play-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 24px;
            height: 24px;
            border: 2px solid var(--bg-main);
            border-radius: 50%;
            font-size: 10px;
            padding-left: 2px;
        }

        /* Responsive */
        @@media (max-width: 900px) {
            .content-split { grid-template-columns: 1fr; gap: 60px; }
            .fig-image-wrapper { height: 350px; }
            .doc-container { flex-direction: column; align-items: flex-start; }
        }
    
</style>



    
