@page
@model WebApps.Pages.SponsorshipModel
@{
    ViewData["Title"] = "Sponsorship - National Conservation Zoo";
}

@section Styles {
<link rel="stylesheet" href="css/pages.css">
}

<!-- ... Header boilerplate ... -->
    
    
    
    

    <!-- MAIN CONTENT START -->
    <main>
        <section class="page-hero">
            <h1>Corporate Sponsorship</h1>
            <p>Partner your brand with one of the most trusted conservation organizations dedicated to wildlife.</p>
        </section>

        <section class="page-content-wrap">
            <div class="page-section">
                <h2>Why Sponsor the Zoo?</h2>
                <p>When your company partners with the National Conservation Zoo, you align your brand with wildlife conservation, family values, and community education. We offer customized sponsorship packages to meet your marketing and philanthropic goals.</p>
            </div>
            <div class="page-section">
                <h2>Partnership Benefits</h2>
                <div class="feature-grid">
                    <div class="feature-box">
                        <i class="fa fa-eye"></i>
                        <h3>Brand Visibility</h3>
                        <p>Gain exposure to our 1.5 million annual visitors through on-site branding.</p>
                    </div>
                    <div class="feature-box">
                        <i class="fa fa-ticket"></i>
                        <h3>VIP Access</h3>
                        <p>Enjoy exclusive corporate tickets and private behind-the-scenes guided tours.</p>
                    </div>
                </div>
            </div>
            <div class="page-section" style="text-align:center;">
                <h2>Let's build a wild partnership!</h2>
                <p>To learn more about sponsorship opportunities, please contact our Development Team.</p>
                <a href="mailto:sponsor@nationalconservzoo.org" class="btn-primary" style="margin-top:20px;">Contact Us</a>
            </div>
        </section>
    </main>
    <!-- MAIN CONTENT END -->
