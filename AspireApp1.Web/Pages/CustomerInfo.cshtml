@page
@model WebApps.Pages.CustomerInfoModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "My Account - National Conservation Zoo";
}

@section Styles {
<link rel="stylesheet" href="css/pages.css">
<style>
    .ci-wrapper { max-width: 1200px; margin: 0 auto; padding: 40px 20px; }

    .ci-header {
        display: flex; align-items: center; gap: 24px; margin-bottom: 40px;
        padding: 30px 40px;
        background: linear-gradient(135deg, #1a5e3a 0%, #2d8f5e 50%, #119864 100%);
        border-radius: 16px; color: white;
        box-shadow: 0 8px 32px rgba(17, 152, 100, 0.25);
    }

    .ci-avatar-wrap { position: relative; flex-shrink: 0; }
    .ci-avatar {
        width: 90px; height: 90px; border-radius: 50%;
        background: rgba(255,255,255,0.2);
        display: flex; align-items: center; justify-content: center;
        font-size: 42px; border: 3px solid rgba(255,255,255,0.4);
        overflow: hidden;
    }
    .ci-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .ci-avatar-btn {
        position: absolute; bottom: -4px; right: -4px;
        width: 32px; height: 32px; border-radius: 50%;
        background: white; border: 2px solid #119864; color: #119864;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer; font-size: 14px; transition: all 0.2s;
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
    }
    .ci-avatar-btn:hover { background: #119864; color: white; transform: scale(1.1); }

    .ci-header-info h1 { margin: 0 0 6px 0; font-size: 28px; font-weight: 700; }
    .ci-header-info p { margin: 0; opacity: 0.85; font-size: 15px; }
    .ci-role-badge {
        background: rgba(255,255,255,0.2); padding: 4px 14px; border-radius: 20px;
        font-size: 13px; font-weight: 600; display: inline-block; margin-top: 8px;
        backdrop-filter: blur(4px); border: 1px solid rgba(255,255,255,0.3);
    }

    .ci-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 35px; }
    .ci-stat-card {
        background: white; padding: 25px; border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.06); text-align: center;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .ci-stat-card:hover { transform: translateY(-3px); box-shadow: 0 8px 25px rgba(0,0,0,0.1); }
    .ci-stat-icon { font-size: 28px; color: #119864; margin-bottom: 10px; }
    .ci-stat-value { font-size: 32px; font-weight: 800; color: #1a3a2a; display: block; }
    .ci-stat-label { font-size: 13px; color: #888; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 5px; }

    .ci-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 25px; margin-bottom: 35px; }
    .ci-card { background: white; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.06); overflow: hidden; }
    .ci-card-header {
        padding: 18px 25px; background: #f8f9fa; border-bottom: 1px solid #eee;
        font-size: 18px; font-weight: 700; color: #1a3a2a;
        display: flex; align-items: center; gap: 10px;
    }
    .ci-card-body { padding: 25px; }

    .ci-detail-row { display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #f0f0f0; font-size: 15px; }
    .ci-detail-row:last-child { border-bottom: none; }
    .ci-detail-label { color: #888; font-weight: 500; }
    .ci-detail-value { color: #333; font-weight: 600; text-align: right; }

    .ci-membership-badge { display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; border-radius: 8px; font-weight: 600; font-size: 14px; }
    .ci-membership-active { background: #e8f5e9; color: #2e7d32; }
    .ci-membership-none { background: #fff3e0; color: #e65100; }

    .ci-table-wrap { grid-column: 1 / -1; }
    .ci-table { width: 100%; border-collapse: collapse; font-size: 14px; }
    .ci-table thead { background: #f8f9fa; }
    .ci-table th { padding: 14px 16px; text-align: left; font-weight: 700; color: #555; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #eee; }
    .ci-table td { padding: 14px 16px; color: #333; border-bottom: 1px solid #f0f0f0; vertical-align: middle; }
    .ci-table tr:hover { background: #fafffe; }
    .ci-status-badge { padding: 4px 10px; border-radius: 12px; font-size: 12px; font-weight: 600; }
    .ci-status-completed { background: #e8f5e9; color: #2e7d32; }
    .ci-status-pending { background: #fff8e1; color: #f57f17; }
    .ci-status-failed { background: #fbe9e7; color: #c62828; }
    .ci-status-refunded { background: #e3f2fd; color: #1565c0; }

    .ci-empty-state { text-align: center; padding: 40px; color: #999; }
    .ci-empty-state i { font-size: 48px; margin-bottom: 15px; display: block; color: #ddd; }

    /* Profile Popup Modal */
    .pp-overlay {
        display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0,0,0,0.6); z-index: 9999;
        justify-content: center; align-items: center; backdrop-filter: blur(4px);
    }
    .pp-overlay.active { display: flex; }
    .pp-modal {
        background: white; border-radius: 20px; width: 480px; max-width: 95%;
        box-shadow: 0 25px 60px rgba(0,0,0,0.3); overflow: hidden;
        animation: ppSlideUp 0.4s ease;
    }
    @@keyframes ppSlideUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
    .pp-header {
        background: linear-gradient(135deg, #119864, #0d7a4f);
        padding: 24px 30px; color: white;
    }
    .pp-header h2 { margin: 0 0 6px; font-size: 22px; }
    .pp-header p { margin: 0; opacity: 0.85; font-size: 14px; }
    .pp-body { padding: 30px; }
    .pp-field { margin-bottom: 18px; }
    .pp-field label { display: block; font-weight: 600; color: #333; margin-bottom: 6px; font-size: 14px; }
    .pp-field input, .pp-field select {
        width: 100%; padding: 12px 14px; border: 2px solid #e0e0e0; border-radius: 10px;
        font-size: 15px; transition: border-color 0.2s; outline: none; box-sizing: border-box;
    }
    .pp-field input:focus, .pp-field select:focus { border-color: #119864; }
    .pp-actions { display: flex; gap: 12px; margin-top: 24px; }
    .pp-btn {
        flex: 1; padding: 14px; border: none; border-radius: 10px; font-size: 15px;
        font-weight: 700; cursor: pointer; transition: all 0.2s;
    }
    .pp-btn-save { background: linear-gradient(135deg, #119864, #0d7a4f); color: white; }
    .pp-btn-save:hover { transform: translateY(-2px); box-shadow: 0 4px 15px rgba(17,152,100,0.3); }
    .pp-btn-skip { background: #f5f5f5; color: #666; }
    .pp-btn-skip:hover { background: #eee; }

    @@media (max-width: 768px) {
        .ci-grid { grid-template-columns: 1fr; }
        .ci-header { flex-direction: column; text-align: center; padding: 25px; }
        .ci-table { font-size: 12px; }
        .ci-table th, .ci-table td { padding: 10px 8px; }
    }
</style>
}

<main>
    <section class="page-hero">
        <h1>My Account</h1>
        <p>Manage your profile, view purchase history, and track your membership status.</p>
    </section>

    <section class="ci-wrapper">

        <!-- Profile Header -->
        <div class="ci-header">
            <div class="ci-avatar-wrap">
                <div class="ci-avatar" id="avatarDisplay">
                    @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                    {
                        <img src="@Model.AvatarUrl" alt="Avatar" id="avatarImg" />
                    }
                    else
                    {
                        <i class="fa fa-user" id="avatarIcon"></i>
                    }
                </div>
                <div class="ci-avatar-btn" onclick="document.getElementById('avatarInput').click()" title="Change Avatar">
                    <i class="fa fa-camera"></i>
                </div>
                <input type="file" id="avatarInput" accept="image/jpeg,image/png,image/gif,image/webp" style="display:none;" onchange="uploadAvatar(this)" />
            </div>
            <div class="ci-header-info">
                <h1>@Model.CustomerName</h1>
                <p><i class="fa fa-envelope"></i> @Model.Email</p>
                <p><i class="fa fa-user-circle"></i> @@@Model.Username</p>
                <span class="ci-role-badge">@Model.RoleName</span>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="ci-stats">
            <div class="ci-stat-card">
                <div class="ci-stat-icon"><i class="fa fa-shopping-bag"></i></div>
                <span class="ci-stat-value">@Model.TotalTransactions</span>
                <div class="ci-stat-label">Total Transactions</div>
            </div>
            <div class="ci-stat-card">
                <div class="ci-stat-icon"><i class="fa fa-ticket"></i></div>
                <span class="ci-stat-value">@Model.TotalTicketsBought</span>
                <div class="ci-stat-label">Tickets Purchased</div>
            </div>
            <div class="ci-stat-card">
                <div class="ci-stat-icon"><i class="fa fa-usd"></i></div>
                <span class="ci-stat-value">$@Model.TotalSpent.ToString("N2")</span>
                <div class="ci-stat-label">Total Spent</div>
            </div>
            <div class="ci-stat-card">
                <div class="ci-stat-icon" style="color: #c62828;"><i class="fa fa-undo"></i></div>
                <span class="ci-stat-value" style="color: #c62828;">$@Model.TotalRefundedAmount.ToString("N2")</span>
                <div class="ci-stat-label">Refund Approved</div>
            </div>
        </div>

        <!-- Profile Details + Membership -->
        <div class="ci-grid">
            <div class="ci-card">
                <div class="ci-card-header" style="justify-content: space-between;">
                    <span><i class="fa fa-id-card"></i> Personal Information</span>
                    <button onclick="document.getElementById('profilePopup').classList.add('active')" 
                            style="background: #119864; color: white; border: none; padding: 6px 16px; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 6px; transition: all 0.2s;">
                        <i class="fa fa-pencil"></i> Edit
                    </button>
                </div>
                <div class="ci-card-body">
                    <div class="ci-detail-row">
                        <span class="ci-detail-label">Full Name</span>
                        <span class="ci-detail-value">@Model.CustomerName</span>
                    </div>
                    <div class="ci-detail-row">
                        <span class="ci-detail-label">Email</span>
                        <span class="ci-detail-value">@Model.Email</span>
                    </div>
                    <div class="ci-detail-row">
                        <span class="ci-detail-label">Phone</span>
                        <span class="ci-detail-value">@(string.IsNullOrEmpty(Model.Phone) ? "—" : Model.Phone)</span>
                    </div>
                    <div class="ci-detail-row">
                        <span class="ci-detail-label">Address</span>
                        <span class="ci-detail-value">@(string.IsNullOrEmpty(Model.Address) ? "—" : Model.Address)</span>
                    </div>
                    <div class="ci-detail-row">
                        <span class="ci-detail-label">Gender</span>
                        <span class="ci-detail-value">@(string.IsNullOrEmpty(Model.Gender) ? "—" : Model.Gender)</span>
                    </div>
                    <div class="ci-detail-row">
                        <span class="ci-detail-label">Date of Birth</span>
                        <span class="ci-detail-value">@(string.IsNullOrEmpty(Model.DateOfBirth) ? "—" : DateTime.Parse(Model.DateOfBirth).ToString("dd/MM/yyyy"))</span>
                    </div>
                    <div class="ci-detail-row">
                        <span class="ci-detail-label">Member Since</span>
                        <span class="ci-detail-value">@Model.MemberSince</span>
                    </div>
                </div>
            </div>

            <div class="ci-card">
                <div class="ci-card-header">
                    <i class="fa fa-star"></i> Membership Status (V2)
                </div>
                <div class="ci-card-body">

                    @if (Model.ActiveMembership != null)
                    {
                        <div style="text-align: center; margin-bottom: 20px;">
                            <span class="ci-membership-badge ci-membership-active">
                                <i class="fa fa-check-circle"></i> @Model.ActiveMembership.Status
                            </span>
                        </div>
                        <div class="ci-detail-row">
                            <span class="ci-detail-label">Membership Type</span>
                            <span class="ci-detail-value">@Model.ActiveMembership.MembershipType</span>
                        </div>
                        <div class="ci-detail-row">
                            <span class="ci-detail-label">Start Date</span>
                            <span class="ci-detail-value">@Model.ActiveMembership.StartDate</span>
                        </div>
                        <div class="ci-detail-row">
                            <span class="ci-detail-label">End Date</span>
                            <span class="ci-detail-value">@Model.ActiveMembership.EndDate</span>
                        </div>
                        <div class="ci-detail-row">
                            <span class="ci-detail-label">Benefits</span>
                            <span class="ci-detail-value">@Model.ActiveMembership.Benefits</span>
                        </div>
                    }
                    else
                    {
                        <div style="text-align: center; padding: 30px 0;">
                            <span class="ci-membership-badge ci-membership-none">
                                <i class="fa fa-exclamation-circle"></i> No Active Membership
                            </span>
                            <p style="color: #999; margin-top: 15px;">Become a member and get free admission, discounts, and exclusive perks!</p>
                            <a asp-page="/Join" style="display: inline-block; margin-top: 10px; padding: 10px 24px; background: #119864; color: white; border-radius: 8px; text-decoration: none; font-weight: 600;">
                                <i class="fa fa-plus"></i> Join Now
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Refunded Orders History -->
        <div class="ci-card ci-table-wrap">
            <div class="ci-card-header">
                <i class="fa fa-undo"></i> Refunded Orders History
            </div>
            <div class="ci-card-body" style="padding: 0;">
                @if (Model.RefundedOrders.Count > 0)
                {
                    <table class="ci-table">
                        <thead>
                            <tr>
                                <th>Refund ID</th>
                                <th>Order ID</th>
                                <th>Amount</th>
                                <th>Category</th>
                                <th>Status</th>
                                <th>Requested At</th>
                                <th>Completed At</th>
                                <th>Transaction Ref</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.RefundedOrders)
                            {
                                <tr>
                                    <td>#@r.RefundId</td>
                                    <td>@(r.OrderId > 0 ? $"#{r.OrderId}" : "—")</td>
                                    <td style="color:#c62828; font-weight:700;">$@r.Amount.ToString("N2")</td>
                                    <td style="text-transform:capitalize;">@r.Type</td>
                                    <td>
                                        <span class="ci-status-badge ci-status-completed" style="background:#fbe9e7; color:#c62828; font-weight: 700;">Refunded</span>
                                    </td>
                                    <td>@r.RequestedAt</td>
                                    <td>@r.CompletedAt</td>
                                    <td style="font-size: 12px; color: #999;">@r.TransactionRef</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="ci-empty-state">
                        <i class="fa fa-undo" style="color: #ddd;"></i>
                        <p>No refunded orders in your account history.</p>
                    </div>
                }
            </div>
        </div>
    </section>
</main>

<!-- ============================================================ -->
<!-- PROFILE UPDATE POPUP MODAL -->
<!-- ============================================================ -->
<div class="pp-overlay" id="profilePopup">
    <div class="pp-modal">
        <div class="pp-header">
            <h2><i class="fa fa-user-edit"></i> Complete Your Profile</h2>
            <p>Please fill in the missing information to get the best experience</p>
        </div>
        <div class="pp-body">
            <div class="pp-field">
                <label><i class="fa fa-user"></i> Full Name</label>
                <input type="text" id="ppFullName" placeholder="e.g. Nguyen Van A" value="@Model.CustomerName" />
            </div>
            <div class="pp-field">
                <label><i class="fa fa-phone"></i> Phone Number</label>
                <input type="tel" id="ppPhone" placeholder="e.g. +84 912 345 678" value="@Model.Phone" />
            </div>
            <div class="pp-field">
                <label><i class="fa fa-map-marker"></i> Address</label>
                <input type="text" id="ppAddress" placeholder="e.g. 123 Main Street, District 1" value="@Model.Address" />
            </div>
            <div class="pp-field">
                <label><i class="fa fa-venus-mars"></i> Gender</label>
                <select id="ppGender">
                    <option value="">-- Select --</option>
                    @{ var g = Model.Gender ?? ""; }
                    <option value="Male" selected="@(g == "Male")">Male</option>
                    <option value="Female" selected="@(g == "Female")">Female</option>
                    <option value="Other" selected="@(g == "Other")">Other</option>
                </select>
            </div>
            <div class="pp-field">
                <label><i class="fa fa-calendar"></i> Date of Birth</label>
                <input type="date" id="ppDOB" value="@Model.DateOfBirth" />
            </div>
            <div class="pp-actions">
                <button class="pp-btn pp-btn-skip" onclick="closeProfilePopup()">Skip for now</button>
                <button class="pp-btn pp-btn-save" onclick="saveProfile()">
                    <i class="fa fa-check"></i> Save
                </button>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

<script>
    // ============================================================
    // PROFILE POPUP — show if profile incomplete
    // ============================================================
    document.addEventListener('DOMContentLoaded', function() {
        var showPopup = @(Model.ShowProfilePopup ? "true" : "false");
        if (showPopup) {
            setTimeout(() => {
                document.getElementById('profilePopup').classList.add('active');
            }, 500);
        }
    });

    function closeProfilePopup() {
        document.getElementById('profilePopup').classList.remove('active');
    }

    function saveProfile() {
        const data = {
            fullName: document.getElementById('ppFullName').value,
            phone: document.getElementById('ppPhone').value,
            address: document.getElementById('ppAddress').value,
            gender: document.getElementById('ppGender').value,
            dateOfBirth: document.getElementById('ppDOB').value
        };

        fetch('/CustomerInfo?handler=UpdateProfile', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            },
            body: JSON.stringify(data)
        })
        .then(r => r.json())
        .then(result => {
            if (result.success) {
                closeProfilePopup();
                location.reload();
            } else {
                alert(result.message);
            }
        })
        .catch(() => alert('Network error.'));
    }

    // ============================================================
    // AVATAR UPLOAD
    // ============================================================
    function uploadAvatar(input) {
        if (!input.files || !input.files[0]) return;

        const file = input.files[0];
        if (file.size > 5 * 1024 * 1024) {
            alert('File too large. Max 5MB.');
            return;
        }

        const formData = new FormData();
        formData.append('avatarFile', file);

        // Show loading state
        const avatarDisplay = document.getElementById('avatarDisplay');
        avatarDisplay.innerHTML = '<div style="width:30px;height:30px;border:3px solid rgba(255,255,255,0.3);border-top:3px solid white;border-radius:50%;animation:spin 0.8s linear infinite;"></div>';

        fetch('/CustomerInfo?handler=UploadAvatar', {
            method: 'POST',
            headers: {
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            },
            body: formData
        })
        .then(r => r.json())
        .then(result => {
            if (result.success) {
                avatarDisplay.innerHTML = '<img src="' + result.avatarUrl + '" alt="Avatar" style="width:100%;height:100%;object-fit:cover;" />';
            } else {
                avatarDisplay.innerHTML = '<i class="fa fa-user"></i>';
                alert(result.message);
            }
        })
        .catch(() => {
            avatarDisplay.innerHTML = '<i class="fa fa-user"></i>';
            alert('Upload failed.');
        });
    }
</script>

<style>
    @@keyframes spin { to { transform: rotate(360deg); } }
</style>
