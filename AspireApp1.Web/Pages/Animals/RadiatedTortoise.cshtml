@section Scripts {
<script src="https://unpkg.com/embla-carousel/embla-carousel.umd.js"></script>
<script>
        // --- Header JS ---
        const header = document.getElementById('mainHeader');
        window.addEventListener('scroll', function () {
            if (window.scrollY > 48) {
                header.classList.add('sticky');
            } else {
                header.classList.remove('sticky');
            }
        });

        function openSearch() {
            document.getElementById("fullSearchOverlay").classList.add("active");
            setTimeout(() => document.getElementById("zooSearchInput").focus(), 100);
        }
        function closeSearch() { document.getElementById("fullSearchOverlay").classList.remove("active"); }
        document.addEventListener('keydown', e => { if (e.key === "Escape") closeSearch(); });

        // --- Carousel JS (Using Embla for infinite looping) ---
        const emblaNode = document.querySelector('.embla-viewport-draggable');
        const embla = EmblaCarousel(emblaNode, { loop: true, align: 'start', duration: 35 });

        const prevBtn = document.querySelectorAll('.embla-button-flex')[0];
        const nextBtn = document.querySelectorAll('.embla-button-flex')[1];

        prevBtn.addEventListener('click', () => embla.scrollPrev(), false);
        nextBtn.addEventListener('click', () => embla.scrollNext(), false);

        // --- Modal JS ---
        const modalHtml = `
        <div class="tiger-modal" id="tigerModal">
            <div class="tiger-modal-content">
                <button class="tiger-modal-close" id="tigerModalClose">&times;</button>
                <button class="tiger-modal-prev" id="tigerModalPrev">&#10094;</button>
                <img id="tigerModalImg" src="" alt="Zoomed in">
                <button class="tiger-modal-next" id="tigerModalNext">&#10095;</button>
            </div>
        </div>
        <style>
            /* Fix Centering for Facts */
            .contain-card-fact { display: flex; justify-content: center; width: 100%; }
            .list-cards { display: flex; flex-wrap: wrap; justify-content: center; gap: 20px; max-width: 1200px; padding: 0; margin: 0 auto; list-style-type: none; }
            .card-li { flex: 0 0 auto; }
            
            /* Hidden Carousel arrows until hover */
            .embla { position: relative; }
            .embla-button-flex { opacity: 0; transition: opacity 0.3s ease; }
            .embla:hover .embla-button-flex { opacity: 1; }
            
            /* Modal Styling matching Image 3 */
            .tiger-modal {
                display: none; position: fixed; z-index: 10000; left: 0; top: 0; width: 100%; height: 100%;
                background-color: rgba(235, 240, 230, 0.95);
                align-items: center; justify-content: center;
            }
            .tiger-modal.active { display: flex; }
            .tiger-modal-content { position: relative; max-width: 90%; max-height: 90%; display:flex; flex-direction: column; align-items:center; justify-content:center; }
            
            .tiger-modal-close {
                position: absolute; top: -60px; left: 50%; transform: translateX(-50%); width: 40px; height: 40px;
                background: #002526; color: #fff; border: 2px solid #002526; border-radius: 50%;
                font-size: 24px; cursor: pointer; display: flex; align-items: center; justify-content: center; z-index:1001; transition: background 0.3s;
            }
            .tiger-modal-close:hover { background: #e1e755; color: #002526; }
            
            .tiger-modal-content img { width: 85vw; height: 85vh; max-width: 1000px; border-radius: 16px; object-fit: cover; box-shadow: 0 10px 30px rgba(0,0,0,0.15); }
            
            .tiger-modal-prev, .tiger-modal-next {
                position: absolute; top: 50%; width: 48px; height: 48px; transform: translateY(-50%);
                background: #fff; color: #002526; border: none; border-radius: 50%; box-shadow: 0 4px 10px rgba(0,0,0,0.1);
                font-size: 20px; cursor: pointer; display: flex; align-items: center; justify-content: center;
                opacity: 0; transition: opacity 0.3s, background 0.3s; z-index:1001; font-weight:bold;
            }
            .tiger-modal-content:hover .tiger-modal-prev,
            .tiger-modal-content:hover .tiger-modal-next { opacity: 1; }
            .tiger-modal-prev { left: -64px; }
            .tiger-modal-next { right: -64px; }
            .tiger-modal-prev:hover, .tiger-modal-next:hover { background: #e1e755; }
            .tiger-modal-prev:active, .tiger-modal-next:active { background: #c5cc4b; }
            
            .embla-slide { cursor: zoom-in; }
        </style>
        `;
        document.body.insertAdjacentHTML('beforeend', modalHtml);

        const tigerModal = document.getElementById('tigerModal');
        const tigerModalImg = document.getElementById('tigerModalImg');
        const tigerModalClose = document.getElementById('tigerModalClose');
        const tigerModalPrev = document.getElementById('tigerModalPrev');
        const tigerModalNext = document.getElementById('tigerModalNext');

        let currentModalIndex = 0;
        const slidesForModal = Array.from(document.querySelectorAll('.embla-slide:not(.is-cloned)')); // Using non-cloned for modal mapping

        let images = [];
        slidesForModal.forEach((slide, idx) => {
            const imgEl = slide.querySelector('img');
            if (imgEl) {
                images.push(imgEl.src);
                slide.addEventListener('click', () => {
                    currentModalIndex = idx;
                    openModal(images[currentModalIndex]);
                });
            }
        });

        // Add listeners to cloned slides created by Embla as well
        embla.on('init', () => {
            document.querySelectorAll('.embla-slide').forEach((slide) => {
                slide.addEventListener('click', () => {
                    const imgEl = slide.querySelector('img');
                    if (!imgEl) return;
                    const findIndex = images.indexOf(imgEl.src);
                    if (findIndex > -1) {
                        currentModalIndex = findIndex;
                        openModal(images[currentModalIndex]);
                    }
                });
            });
        });

        function openModal(src) {
            tigerModalImg.src = src;
            tigerModal.classList.add('active');
        }

        tigerModalClose.addEventListener('click', () => {
            tigerModal.classList.remove('active');
        });

        tigerModalPrev.addEventListener('click', () => {
            currentModalIndex = (currentModalIndex > 0) ? currentModalIndex - 1 : images.length - 1;
            tigerModalImg.src = images[currentModalIndex];
        });

        tigerModalNext.addEventListener('click', () => {
            currentModalIndex = (currentModalIndex < images.length - 1) ? currentModalIndex + 1 : 0;
            tigerModalImg.src = images[currentModalIndex];
        });

        // Close on click outside image
        tigerModal.addEventListener('click', (e) => {
            if (e.target === tigerModal || e.target === document.querySelector('.tiger-modal-content')) {
                tigerModal.classList.remove('active');
            }
        });

        // --- Vertical Carousel Scroll JS ---
        const verticalSection = document.querySelector('.vertical-carousel');
        const carouselViewport = document.querySelector('.carousel-viewport');
        const verticalDots = document.querySelectorAll('.dots .dot');

        if (verticalSection && carouselViewport && verticalDots.length > 0) {
            // Initialize first dot
            verticalDots[0].classList.add('active');

            window.addEventListener('scroll', () => {
                const scrollableDistance = verticalSection.offsetHeight - window.innerHeight;
                const scrollPosition = window.scrollY - verticalSection.offsetTop;
                const progress = Math.max(0, Math.min(1, scrollPosition / scrollableDistance));

                const activeIndex = progress >= 0.5 ? 1 : 0;

                // Mapped to snap to specific slides when reaching the threshold
                const translateValue = activeIndex * 100;
                carouselViewport.style.transform = `translate3d(0px, -${translateValue}vh, 0px)`;

                verticalDots.forEach((dot, index) => {
                    if (index === activeIndex) {
                        dot.classList.add('active');
                    } else {
                        dot.classList.remove('active');
                    }
                });
            });

            // Click dots to scroll
            verticalDots.forEach((dot, index) => {
                dot.addEventListener('click', () => {
                    const scrollableDistance = verticalSection.offsetHeight - window.innerHeight;
                    const targetScrollY = verticalSection.offsetTop + (index === 0 ? 0 : scrollableDistance);
                    window.scrollTo({ top: targetScrollY, behavior: 'smooth' });
                });
            });
        }
    </script>
}