@page
@model WebApps.Pages.AboutModel
@{
    ViewData["Title"] = "About Us - National Conservation Zoo";
}

@section Styles {
<link rel="stylesheet" href="css/pages.css">
}

<!-- MAIN CONTENT START -->
    <main>
        <section class="page-hero">
            <h1>About Us</h1>
            <p>Learn more about our legacy, our mission, and our dedication to animal care and conservation.</p>
        </section>

        <section class="page-content-wrap">
            <div class="page-section">
                <h2>Our Mission</h2>
                <p>As Vietnam's premier wildlife sanctuary, our core mission revolves around the conservation of endangered species globally and within our borders. We aim to inspire community support through engaging experiences that connect people with wildlife.</p>
            </div>
            <div class="page-section">
                <h2>Our Impact</h2>
                <div class="feature-grid">
                    <div class="feature-box">
                        <i class="fa fa-globe"></i>
                        <h3>Global Reach</h3>
                        <p>We work with over 50 field conservation projects worldwide contributing resources and expertise.</p>
                    </div>
                    <div class="feature-box">
                        <i class="fa fa-heartbeat"></i>
                        <h3>Animal Care</h3>
                        <p>Our veterinary facilities rank as some of the most technologically advanced in the region.</p>
                    </div>
                    <div class="feature-box">
                        <i class="fa fa-graduation-cap"></i>
                        <h3>Education</h3>
                        <p>We reach over 2,000,000 students annually through our various on-site and digital programs.</p>
                    </div>
                </div>
            </div>
        </section>
    </main>
    <!-- MAIN CONTENT END -->
