@page "/experience/elephant-experience"
@model ZooProject.Pages.Experience.ElephantExperience

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;800&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Passion+One:wght@700;900&display=swap" rel="stylesheet">
    <style>
/* ============================================================
   CSS VARIABLES � Color Palette
   ============================================================ */
:root {
  --bg-vanilla:      #F1E8C7;
  --bg-vanilla-dark: #E9E0D0;
  --green-dark:      #36574E;
  --green-primary:   #2E4B2F;
  --green-light:     #ADBC9F;
  --text-light:      #FBFADA;
  --white:           #CCF8F9;

  /* derived */
  --outline:         rgba(67, 104, 80, 0.35);
  --outline-variant: rgba(173, 188, 159, 0.30);
  --shadow-color:    rgba(18, 55, 42, 0.10);
}

/* ============================================================
   RESET & BASE
   ============================================================ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  background-color: var(--bg-vanilla);
  color: var(--green-dark);
  font-family: 'Poppins', sans-serif;
  font-size: 16px;
  line-height: 1.5;
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}
::selection { background: var(--green-light); color: var(--green-dark); }
img { max-width: 100%; display: block; }
button { cursor: pointer; font-family: inherit; border: none; background: none; }
ul { list-style: none; }
a { text-decoration: none; color: inherit; }

/* ============================================================
   GRAIN TEXTURE OVERLAY
   ============================================================ */
.grain-texture {
  position: fixed; top: 0; left: 0;
  width: 100%; height: 100%;
  pointer-events: none; z-index: 9999; opacity: 0.04;
  background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuBxlWxtTx6G-vH_NF3uLAJdVhVITelwQklA0fDcYjr9Hikq6usQiTnJG0LiE2U_QxCR9R5B2EF_le8nF26OoG8LTcBnT3AznrQaHBGQgRStluOj5d2aXsBZSLZ18-ot_JOO8Jvw9-KY4JysXevYU3WMagZmVDrgPD08-ZAP9prTaXpGQKDeugdLDkbsgRBVv-b-CW1saMjhc_zxZ8dLYApbfoTdFK3SGoQ3orcnD5yUu-z6boF8FM6-ceswxLDfU9npZQnLmqixzwWT');
}

/* ============================================================
   PAPER FLICKER OVERLAY
   ============================================================ */
@@keyframes flicker {
  0%   { opacity: 0.03; }
  5%   { opacity: 0.05; }
  10%  { opacity: 0.04; }
  15%  { opacity: 0.07; }
  20%  { opacity: 0.03; }
  25%  { opacity: 0.06; }
  30%  { opacity: 0.04; }
  35%  { opacity: 0.05; }
  40%  { opacity: 0.03; }
  45%  { opacity: 0.07; }
  50%  { opacity: 0.04; }
  55%  { opacity: 0.06; }
  60%  { opacity: 0.03; }
  65%  { opacity: 0.05; }
  70%  { opacity: 0.07; }
  75%  { opacity: 0.04; }
  80%  { opacity: 0.03; }
  85%  { opacity: 0.06; }
  90%  { opacity: 0.05; }
  95%  { opacity: 0.07; }
  100% { opacity: 0.03; }
}
@@media (prefers-reduced-motion: no-preference) {
  .paper-flicker-overlay {
    position: fixed; top: 0; left: 0;
    width: 100%; height: 100%;
    background-image: radial-gradient(var(--green-dark) 1px, transparent 1px);
    background-size: 4px 4px;
    pointer-events: none; z-index: 9998;
    animation: flicker 0.15s infinite;
    opacity: 0.05;
  }
}

/* ============================================================
   SPECIAL CLASSES (DESIGN SYSTEM)
   ============================================================ */
.paper-card {
  background-color: var(--bg-vanilla-dark);
  background-image: radial-gradient(circle at 2px 2px, rgba(67,104,80,0.07) 1px, transparent 0);
  background-size: 24px 24px;
}
.field-journal-shadow {
  box-shadow: 0 10px 30px var(--shadow-color);
}
.asymmetric-bleed {
  clip-path: polygon(0 0, 100% 5%, 95% 100%, 2% 98%);
}

/* ============================================================
   LAYOUT
   ============================================================ */
main {
  padding-top: 64px;
  padding-bottom: 96px;
}
.container {
  max-width: 1280px;
  margin: 0 auto;
  padding-left: 16px;
  padding-right: 16px;
}
@@media (min-width: 768px) {
  .container {
    padding-left: 64px;
    padding-right: 64px;
  }
}

/* ---- Bento Grid ---- */
.bento-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24px;
  align-items: start;
}
@@media (min-width: 768px) {
  .bento-grid {
    grid-template-columns: repeat(12, 1fr);
  }
  .col-main { grid-column: span 8; }
  .col-side { grid-column: span 4; }
}
.main-col-inner > * + * { margin-top: 24px; }

/* ============================================================
   HERO
   ============================================================ */
.hero {
  margin-bottom: 64px;
  position: relative;
}
.hero-eyebrow {
  display: inline-block;
  color: var(--green-primary);
  font-weight: 600;
  font-size: 14px;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  margin-bottom: 16px;
}
.hero h1 {
  font-family: 'Passion One', display;
  font-size: 65px;
  line-height: 1.1;
  font-weight: 700;
  color: var(--green-dark);
  margin-bottom: 24px;
}
@@media (max-width: 767px) {
  .hero h1 { font-size: 30px; }
}
.hero-desc {
  max-width: 640px;
  font-size: 18px;
  line-height: 1.6;
  color: var(--green-primary);
}

/* ============================================================
   FEATURED IMAGE
   ============================================================ */
.featured-wrapper {
  position: relative;
  border-radius: 16px;
  overflow: hidden;
  background: var(--bg-vanilla-dark);
  padding: 12px;
  border: 1px solid var(--outline-variant);
}
.featured-badge {
  position: absolute;
  top: 32px; left: 32px;
  z-index: 10;
  background: rgba(253,251,247,0.85);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  padding: 8px 16px;
  border-radius: 8px;
  border: 1px solid var(--outline-variant);
}
.featured-badge p {
  font-family: 'Poppins', sans-serif;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  color: var(--green-primary);
}
.featured-img {
  width: 100%;
  aspect-ratio: 16 / 10;
  object-fit: cover;
  border-radius: 10px;
  filter: grayscale(1);
  transition: filter 0.7s ease;
}
.featured-wrapper:hover .featured-img {
  filter: grayscale(0);
}

/* ============================================================
   TAGS
   ============================================================ */
.tags-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10px;
  padding: 8px 0;
}
.tag {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 14px;
  border-radius: 9999px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  background: var(--green-dark);
  color: var(--text-light);
}
.tag .material-symbols-outlined { font-size: 14px; }
.tag-outline {
  background: transparent;
  color: var(--green-primary);
  border: 1px solid rgba(173,188,159,0.55);
}

/* ============================================================
   DESCRIPTION CARD
   ============================================================ */
.description-card {
  padding: 40px;
  border-radius: 16px;
  border: 1px solid var(--outline-variant);
  position: relative;
  overflow: hidden;
}
.description-card .deco-bg {
  position: absolute;
  right: -40px; bottom: -40px;
  opacity: 0.09;
  color: var(--green-dark);
  pointer-events: none;
}
.description-card .deco-bg .material-symbols-outlined {
  font-size: 200px;
  line-height: 1;
}
.description-card h2 {
  font-family: 'Passion One', display;
  font-size: 40px;
  line-height: 1.3;
  font-weight: 600;
  color: var(--green-dark);
  margin-bottom: 24px;
}
.description-card p {
  font-size: 16px;
  line-height: 1.7;
  color: var(--green-dark);
}
.description-card p + p { margin-top: 20px; }

/* ============================================================
   SIDEBAR
   ============================================================ */
.sidebar {
  display: flex;
  flex-direction: column;
  gap: 24px;
}
@@media (min-width: 768px) {
  .sidebar { position: sticky; top: 112px; }
}

/* ---- Ticket Card ---- */
.ticket-card {
  background: var(--green-light);
  padding: 32px;
  border-radius: 16px;
  border-top: 8px solid var(--green-primary);
  position: relative;
  overflow: hidden;
}
.ticket-deco {
  position: absolute;
  top: 16px; right: 16px;
  color: rgba(18, 55, 42, 0.15);
  pointer-events: none;
}
.ticket-deco .material-symbols-outlined { font-size: 64px; }
.ticket-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 32px;
}
.ticket-label {
  font-family: 'Poppins', sans-serif;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  color: var(--green-dark);
  margin-bottom: 4px;
}
.ticket-price {
  font-family: 'Playfair Display', serif;
  font-size: 48px;
  line-height: 1.1;
  font-weight: 700;
  color: var(--green-dark);
}
.ticket-member-badge {
  background: var(--bg-vanilla);
  padding: 4px 12px;
  border-radius: 9999px;
  border: 1px solid rgba(67,104,80,0.2);
  font-size: 11px;
  font-weight: 700;
  color: var(--green-primary);
  white-space: nowrap;
  margin-top: 6px;
}
.ticket-details {
  display: flex;
  flex-direction: column;
  gap: 16px;
  margin-bottom: 28px;
}
.ticket-detail {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 16px;
  color: var(--green-dark);
}
.ticket-detail .material-symbols-outlined { color: var(--green-primary); }
.ticket-btn {
  width: 100%;
  padding: 16px;
  background: var(--green-dark);
  color: var(--text-light);
  border-radius: 12px;
  font-weight: 700;
  font-size: 13px;
  letter-spacing: 0.08em;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.ticket-btn:hover {
  transform: scale(1.02);
  box-shadow: 0 6px 20px rgba(18,55,42,0.25);
}

/* ---- Map Card ---- */
.map-card {
  background: var(--bg-vanilla-dark);
  padding: 24px;
  border: 1px solid var(--outline-variant);
  transform: rotate(1deg);
  transition: transform 0.5s ease;
  cursor: default;
}
.map-card:hover {
  transform: rotate(0deg) translateY(-2px);
}
.map-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}
.map-card-title {
  font-family: 'Playfair Display', serif;
  font-size: 16px;
  font-weight: 600;
  color: var(--green-dark);
}
.map-card-header .material-symbols-outlined { color: var(--green-dark); }
.map-img-wrapper {
  height: 192px;
  border-radius: 8px;
  overflow: hidden;
  position: relative;
  border: 1px solid rgba(173,188,159,0.45);
}
.map-img-wrapper img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.65;
  mix-blend-mode: multiply;
}
.map-img-tint {
  position: absolute;
  inset: 0;
  background: rgba(67,104,80,0.07);
  pointer-events: none;
}
.map-note {
  margin-top: 14px;
  font-size: 12px;
  line-height: 1.5;
  color: var(--green-primary);
  font-style: italic;
}

/* ============================================================
   GALLERY / CAROUSEL SECTION
   ============================================================ */
.gallery-section { margin-top: 96px; }

.gallery-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 48px;
  gap: 16px;
}
.gallery-header h3 {
  font-family: 'Passion One', display;
  font-size: 40px;
  font-weight: 600;
  color: var(--green-dark);
  margin-bottom: 6px;
}
.gallery-header p {
  font-size: 16px;
  color: var(--green-primary);
}
.gallery-nav-btns {
  display: flex;
  gap: 12px;
  flex-shrink: 0;
}
@@media (max-width: 767px) { .gallery-nav-btns { display: none; } }
.gallery-nav-btn {
  width: 52px; height: 52px;
  border-radius: 9999px;
  border: 1px solid var(--outline);
  color: var(--green-dark);
  display: flex; align-items: center; justify-content: center;
  background: transparent;
  transition: background 0.2s ease, color 0.2s ease, transform 0.15s ease;
}
.gallery-nav-btn:hover {
  background: var(--green-dark);
  color: var(--text-light);
}
.gallery-nav-btn:active { transform: scale(0.95); }

/* ---- Carousel ---- */
.carousel-container {
  position: relative;
}
/* Show hover arrows on the whole container */
.carousel-container:hover .carousel-arrow { opacity: 1; }

.carousel-overflow { overflow: hidden; }

.carousel-track {
  display: flex;
  gap: 16px;
  transition: transform 0.55s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  align-items: flex-start;
}

/* Items: 4 visible on desktop, 2 on mobile */
.carousel-item {
  flex: 0 0 calc(25% - 12px);
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid rgba(173,188,159,0.2);
  cursor: pointer;
  position: relative;
  background: var(--bg-vanilla-dark);
}
/* Staggered offset � even items drop down */
.carousel-item:nth-child(even) { margin-top: 32px; }

.carousel-item img {
  width: 100%;
  aspect-ratio: 1 / 1;
  object-fit: cover;
  display: block;
  transition: transform 0.5s ease;
}
.carousel-item:hover img { transform: scale(1.06); }

/* Overlay hint on hover */
.carousel-item::after {
  content: '';
  position: absolute;
  inset: 0;
  background: rgba(18,55,42,0);
  transition: background 0.3s ease;
  pointer-events: none;
}
.carousel-item:hover::after {
  background: rgba(18,55,42,0.08);
}

@@media (max-width: 767px) {
  .carousel-item {
    flex: 0 0 calc(50% - 8px);
  }
}

/* ---- Carousel Arrows (overlaid on track, hidden by default) ---- */
.carousel-arrow {
  position: absolute;
  top: calc(40% - 24px);
  z-index: 20;
  width: 48px; height: 48px;
  border-radius: 9999px;
  border: 1px solid rgba(173,188,159,0.55);
  background: var(--bg-vanilla);
  color: var(--green-dark);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4px 16px rgba(18,55,42,0.15);
  opacity: 0;
  transition: opacity 0.3s ease, background 0.2s ease, color 0.2s ease;
}
.carousel-arrow:hover {
  background: var(--green-dark);
  color: var(--text-light);
}
.carousel-arrow-prev { left: -24px; }
.carousel-arrow-next { right: -24px; }

@@media (max-width: 767px) { .carousel-arrow { display: none; } }

/* ============================================================
   MISSION BANNER
   ============================================================ */
.mission-section {
  margin-top: 96px;
}
.mission-banner {
  position: relative;
  border-radius: 24px;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  padding: 64px 56px;
  min-height: 480px;
  box-shadow: 0 20px 48px var(--shadow-color);
  border: 1px solid var(--outline-variant);
}
.mission-bg-img {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  z-index: 0;
  filter: grayscale(0.2);
}
.mission-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to right,
    rgba(18, 55, 42, 0.93) 0%,
    rgba(18, 55, 42, 0.75) 20%,
    rgba(18, 55, 42, 0.18) 100%
  );
  z-index: 1;
}
.mission-content {
  position: relative;
  z-index: 2;
  max-width: 520px;
}
.mission-content h2 {
  font-family: 'Playfair Display', serif;
  font-size: 3.2rem;
  font-weight: 800;
  color: var(--text-light);
  line-height: 1.1;
  margin-bottom: 20px;
}
@@media (max-width: 767px) {
  .mission-content h2 { font-size: 2.2rem; }
  .mission-banner { padding: 40px 28px; min-height: 380px; }
}
.mission-content p {
  font-size: 1.05rem;
  line-height: 1.7;
  color: rgba(251, 250, 218, 0.82);
}

/* ============================================================
   VISIT CARDS SECTION
   ============================================================ */
.visit-section {
  margin-top: 72px;
}
.visit-section-header {
  margin-bottom: 40px;
}
.visit-section-header h3 {
  font-family: 'Passion One', display;
  font-size: 32px;
  font-weight: 600;
  color: var(--green-dark);
  margin-bottom: 6px;
}
.visit-section-header p {
  font-size: 15px;
  color: var(--green-primary);
}
.visit-cards-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24px;
}
@@media (min-width: 640px) {
  .visit-cards-grid { grid-template-columns: 1fr 1fr; }
}
.visit-card {
  background: var(--bg-vanilla-dark);
  border: 1px solid var(--outline-variant);
  border-radius: 20px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 8px 24px var(--shadow-color);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  background-image: radial-gradient(circle at 2px 2px, rgba(67,104,80,0.06) 1px, transparent 0);
  background-size: 24px 24px;
}
.visit-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 16px 40px var(--shadow-color);
}
.visit-card-icon-row {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 32px 32px 0;
}
.visit-card-icon {
  width: 48px; height: 48px;
  border-radius: 12px;
  background: var(--green-dark);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.visit-card-icon .material-symbols-outlined {
  color: var(--text-light);
  font-size: 22px;
}
.visit-card-tag {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--green-primary);
  background: rgba(67,104,80,0.1);
  padding: 4px 10px;
  border-radius: 9999px;
  border: 1px solid var(--outline-variant);
}
.visit-card-body {
  padding: 24px 32px 32px;
  flex: 1;
  display: flex;
  flex-direction: column;
}
.visit-card-body h4 {
  font-family: 'Playfair Display', serif;
  font-size: 28px;
  font-weight: 700;
  color: var(--green-dark);
  margin-bottom: 12px;
}
.visit-card-body p {
  font-size: 15px;
  line-height: 1.65;
  color: var(--green-primary);
  flex: 1;
  margin-bottom: 28px;
}
.visit-card-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--green-dark);
  border-bottom: 2px solid var(--green-light);
  padding-bottom: 2px;
  align-self: flex-start;
  transition: color 0.2s ease, border-color 0.2s ease;
}
.visit-card-link:hover {
  color: var(--green-primary);
  border-color: var(--green-dark);
}
.visit-card-link .material-symbols-outlined { font-size: 16px; }

/* ============================================================
   TERMS & CONDITIONS
   ============================================================ */
.terms-section {
  margin-top: 72px;
  margin-bottom: 24px;
}
.terms-card {
  border: 1px solid var(--outline-variant);
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 6px 20px var(--shadow-color);
}
.terms-header {
  background: var(--green-dark);
  padding: 24px 36px;
  display: flex;
  align-items: center;
  gap: 14px;
}
.terms-header .material-symbols-outlined {
  color: var(--text-light);
  font-size: 22px;
}
.terms-header h4 {
  font-family: 'Playfair Display', serif;
  font-size: 24px;
  font-weight: 700;
  color: var(--text-light);
  letter-spacing: 0.01em;
}
.terms-body {
  background: var(--bg-vanilla-dark);
  background-image: radial-gradient(circle at 2px 2px, rgba(67,104,80,0.06) 1px, transparent 0);
  background-size: 24px 24px;
  padding: 32px 36px;
}
.terms-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.terms-item {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding: 14px 18px;
  background: rgba(255,255,255,0.35);
  border-radius: 12px;
  border: 1px solid var(--outline-variant);
}
.terms-item .material-symbols-outlined {
  color: var(--green-dark);
  font-size: 18px;
  flex-shrink: 0;
  margin-top: 2px;
}
.terms-item p {
  font-size: 14px;
  line-height: 1.6;
  color: var(--green-dark);
}

/* ============================================================
   THEATER MODE (LIGHTBOX)
   ============================================================ */
.theater-overlay {
  position: fixed; inset: 0;
  z-index: 100000;
  background: rgba(18, 55, 42, 0.96);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}
.theater-overlay.is-open {
  opacity: 1;
  pointer-events: all;
}

.theater-body {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  max-width: 90vw;
  max-height: 90vh;
}
/* Show theater nav arrows on hover of theater-body */
.theater-body:hover .theater-nav { opacity: 1; }

.theater-img {
  max-width: 88vw;
  max-height: 84vh;
  object-fit: contain;
  border-radius: 8px;
  box-shadow: 0 32px 96px rgba(0,0,0,0.55);
  transition: opacity 0.22s ease;
  display: block;
}

/* Close button */
.theater-close {
  position: fixed;
  top: 24px; right: 24px;
  z-index: 100001;
  width: 48px; height: 48px;
  border-radius: 9999px;
  background: rgba(251,250,218,0.12);
  border: 1px solid rgba(251,250,218,0.20);
  color: var(--text-light);
  display: flex; align-items: center; justify-content: center;
  transition: background 0.2s ease;
}
.theater-close:hover { background: rgba(251,250,218,0.22); }

/* Theater navigation arrows */
.theater-nav {
  position: absolute;
  top: 50%; transform: translateY(-50%);
  z-index: 100001;
  width: 52px; height: 52px;
  border-radius: 9999px;
  background: rgba(251,250,218,0.11);
  border: 1px solid rgba(251,250,218,0.20);
  color: var(--text-light);
  display: flex; align-items: center; justify-content: center;
  opacity: 0;
  transition: opacity 0.3s ease, background 0.2s ease;
}
.theater-nav:hover { background: rgba(251,250,218,0.22); }
.theater-nav-prev { left: -80px; }
.theater-nav-next { right: -80px; }

@@media (max-width: 767px) {
  .theater-nav-prev { left: -56px; }
  .theater-nav-next { right: -56px; }
}

/* Counter */
.theater-counter {
  position: fixed;
  bottom: 28px; left: 50%; transform: translateX(-50%);
  color: rgba(251,250,218,0.55);
  font-family: 'Poppins', sans-serif;
  font-size: 13px;
  letter-spacing: 0.12em;
}

/* ============================================================
   INTERACTION GLOW
   ============================================================ */
#interaction-glow {
  position: fixed;
  width: 600px; height: 600px;
  background: radial-gradient(circle, rgba(173,188,159,0.07) 0%, transparent 70%);
  border-radius: 9999px;
  pointer-events: none;
  z-index: 10;
  left: -1000px; top: -1000px;
  transition: left 0.15s linear, top 0.15s linear;
}
    </style>
}

