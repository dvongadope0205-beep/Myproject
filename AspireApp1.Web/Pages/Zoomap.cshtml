@page
@model WebApps.Pages.ZoomapModel
@{
    ViewData["Title"] = "Zoo Map - National Conservation Zoo";
}

@section Styles {
<link rel="stylesheet" href="css/pages.css">
}

<main>
        <section class="page-hero">
            <h1>Interactive Zoo Map</h1>
            <p>Don't get lost in the wild! Follow our trails to see over 1,900 animals.</p>
        </section>
        <section class="page-content-wrap">
            <div class="page-section" style="text-align:center;">
                <div style="background:#eef2f5; border-radius:20px; overflow:hidden; border: 2px solid #ccc; box-shadow: 0 10px 30px rgba(0,0,0,0.1); margin-bottom: 20px; max-width: 900px; margin: 0 auto 30px;">
                    <img src="/Source/General/cutmap.jpg" alt="Zoo Map" style="width: 100%; height: auto; display: block;" />
                </div>
                <div style="margin-top:30px;">
                    <a href="/Source/General/map.pdf" download="map.pdf" class="btn-primary"><i class="fa fa-download"></i> Download PDF Map</a>
                </div>
            </div>
        </section>
    </main>
