@page
@model WebApps.Pages.VolunteersModel
@{
    ViewData["Title"] = "Volunteers - National Conservation Zoo";
}

@section Styles {
<link rel="stylesheet" href="css/pages.css">
}

<!-- ... Header boilerplate ... -->
    
    
    
    

    <!-- MAIN CONTENT START -->
    <main>
        <section class="page-hero">
            <h1>Volunteer Programs</h1>
            <p>Give the gift of your time! Become a volunteer and be a crucial part of our conservation mission.</p>
        </section>

        <section class="page-content-wrap">
            <div class="page-section">
                <h2>Why Volunteer?</h2>
                <p>Our volunteers are the heartbeat of the Zoo. From educating guests to assisting with ground maintenance, volunteers play a vital role in our everyday operations and global conservation goals.</p>
            </div>
            <div class="page-section">
                <h2>Volunteer Opportunities</h2>
                <div class="feature-grid">
                    <div class="feature-box">
                        <i class="fa fa-bullhorn"></i>
                        <h3>Education Docent</h3>
                        <p>Engage with visitors, share fascinating animal facts, and lead wildlife conservation chats.</p>
                    </div>
                    <div class="feature-box">
                        <i class="fa fa-cutlery"></i>
                        <h3>Dietary Prep Assistant</h3>
                        <p>Assist our nutrition center in preparing daily meals for over 1,900 animals.</p>
                    </div>
                    <div class="feature-box">
                        <i class="fa fa-tree"></i>
                        <h3>Horticulture Team</h3>
                        <p>Help maintain the lush, beautiful gardens and botanical exhibits throughout the park.</p>
                    </div>
                </div>
            </div>
            <div class="page-section" style="text-align:center;">
                <h2>Ready to Join?</h2>
                <p>Fill out our simple volunteer application form and we'll reach out to schedule an orientation.</p>
                <a href="#" class="btn-primary" style="margin-top:20px;">Apply Now</a>
            </div>
        </section>
    </main>
    <!-- MAIN CONTENT END -->
