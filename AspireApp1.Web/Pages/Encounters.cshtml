@page
@model WebApps.Pages.EncountersModel
@{
    ViewData["Title"] = "Wild Animal Encounters - National Conservation Zoo";
}

@section Styles {
<link rel="stylesheet" href="css/pages.css">
}

<main>
        <section class="page-hero">
            <h1>Wild Animal Encounters</h1>
            <p>Get up close and personal. Feed a giraffe, meet a sloth, or touch a rhino under expert guidance.</p>
        </section>
        <section class="page-content-wrap" style="max-width: 1000px; padding: 40px 20px; margin: auto;">
            <div style="text-align:center; margin-bottom: 50px;">
                <h2 style="font-size: 36px; font-family: Georgia, serif; color: var(--zoo-dark);">Meet the Animals Like Never Before</h2>
                <p style="font-size: 18px; color: #555; max-width: 800px; margin: 20px auto; line-height: 1.6;">Our exclusive Animal Encounters offer a once-in-a-lifetime opportunity to interact with incredible wildlife. Guided by our expert animal care staff, you will learn about their diets, habitats, and the conservation efforts protecting them in the wild.</p>
            </div>

            <!-- Giraffe -->
            <div style="display: flex; flex-wrap: wrap; background: white; border-radius: 12px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.1); margin-bottom: 40px;">
                <div style="flex: 1; min-width: 300px;">
                    <img src="/Source/Picture/encounter.jpg" alt="Giraffe Encounter" style="width: 100%; height: 100%; object-fit: cover; min-height: 300px;">
                </div>
                <div style="flex: 1; padding: 40px; min-width: 300px;">
                    <h3 style="font-size: 28px; margin-bottom: 15px; color: var(--zoo-dark);">Giraffe Feeding Station</h3>
                    <p style="color: #666; line-height: 1.6; margin-bottom: 20px;">Step up to our elevated platform and come face-to-face with the tallest mammals on Earth! Feel their gentle, prehensile tongues as they gently take lettuce right from your hand. You'll learn the difference between Reticulated and Masai giraffes from our knowledgeable guides. Great for all ages!</p>
                    <div style="background: #f4f6f5; padding: 15px; border-left: 4px solid var(--zoo-green); margin-bottom: 25px;">
                        <p style="margin: 0; color: #333;"><strong>Schedule:</strong> Daily at 11:30 AM and 2:00 PM</p>
                        <p style="margin: 5px 0 0 0; color: #333;"><strong>Group Size:</strong> Up to 6 people per group</p>
                    </div>
                    <p style="font-size: 24px; color: var(--zoo-green); font-weight: bold; margin-bottom: 20px;">$10 / bundle</p>
                    <a class="btn-zoo" style="border:none; cursor:pointer;" href="/Tickets">Reserve Spot</a>
                </div>
            </div>

            <!-- Rhino -->
            <div style="display: flex; flex-wrap: wrap; flex-direction: row-reverse; background: white; border-radius: 12px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.1); margin-bottom: 40px;">
                <div style="flex: 1; min-width: 300px;">
                    <img src="/Source/Picture/elephant.jpg" alt="Rhino Encounter" style="width: 100%; height: 100%; object-fit: cover; min-height: 300px;">
                </div>
                <div style="flex: 1; padding: 40px; min-width: 300px;">
                    <h3 style="font-size: 28px; margin-bottom: 15px; color: var(--zoo-dark);">Rhino Interaction</h3>
                    <p style="color: #666; line-height: 1.6; margin-bottom: 20px;">Ever wonder what a rhinoceros feels like? Join us behind the scenes to meet our majestic Southern White Rhinos. Safely separated by a training barrier, you'll get to touch their thick, armored skin, take unmatched photos, and hear inspiring stories about our anti-poaching efforts in South Africa.</p>
                    <div style="background: #f4f6f5; padding: 15px; border-left: 4px solid var(--zoo-green); margin-bottom: 25px;">
                        <p style="margin: 0; color: #333;"><strong>Schedule:</strong> Tuesdays & Saturdays at 10:00 AM</p>
                        <p style="margin: 5px 0 0 0; color: #333;"><strong>Age Requirement:</strong> Must be 8 years or older</p>
                    </div>
                    <p style="font-size: 24px; color: var(--zoo-green); font-weight: bold; margin-bottom: 20px;">$45 / person</p>
                    <a class="btn-zoo" style="border:none; cursor:pointer;" href="/Tickets">Reserve Spot</a>
                </div>
            </div>
        </section>
    <partial name="_AdventureBar" />
    </main>

