@page
@model WebApps.Pages.ResetPasswordModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Reset Password - National Conservation Zoo";
    ViewData["HideFooter"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.5/css/all.min.css" />
    <style>
        body { display: block !important; margin: 0; padding: 0; min-height: auto; }
        
        .login-page-wrapper {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: calc(100vh - 100px);
            background: transparent;
            padding-top: 120px;
            padding-bottom: 50px;
        }

        .reset-card {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 14px 28px rgba(0,0,0,0.25), 0 10px 10px rgba(0,0,0,0.22);
            width: 420px;
            max-width: 95%;
            padding: 50px 40px;
            text-align: center;
            animation: slideUp 0.5s ease;
        }

        @@keyframes slideUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .reset-card .icon-circle {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: linear-gradient(135deg, #11998e, #38ef7d);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 25px;
        }

        .reset-card .icon-circle i {
            font-size: 32px;
            color: #fff;
        }

        .reset-card h1 {
            font-weight: bold;
            font-size: 24px;
            margin: 0 0 10px;
            color: #333;
        }

        .reset-card p {
            font-size: 14px;
            color: #777;
            margin: 0 0 25px;
            line-height: 1.6;
        }

        .reset-card input[type="password"] {
            background-color: #f0f0f0;
            border: 2px solid transparent;
            border-radius: 8px;
            padding: 14px 18px;
            width: 100%;
            box-sizing: border-box;
            font-size: 14px;
            transition: border-color 0.3s;
            outline: none;
            margin-bottom: 12px;
        }

        .reset-card input[type="password"]:focus {
            border-color: #11998e;
            background-color: #fff;
        }

        .reset-card .btn-reset {
            width: 100%;
            border-radius: 25px;
            border: none;
            background: linear-gradient(135deg, #11998e, #38ef7d);
            color: #fff;
            font-size: 13px;
            font-weight: bold;
            padding: 14px;
            letter-spacing: 1px;
            text-transform: uppercase;
            cursor: pointer;
            margin-top: 10px;
            transition: transform 0.15s, box-shadow 0.3s;
        }

        .reset-card .btn-reset:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(17,153,142,0.35);
        }

        .reset-card .btn-reset:active {
            transform: scale(0.97);
        }

        .reset-card .back-link {
            display: inline-block;
            margin-top: 25px;
            color: #11998e;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
            transition: color 0.2s;
        }

        .reset-card .back-link:hover {
            color: #38ef7d;
            text-decoration: underline;
        }

        .reset-card .back-link i {
            margin-right: 5px;
        }

        .msg-success {
            background: #e8f5e9;
            color: #2e7d32;
            padding: 16px 20px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-weight: 600;
            font-size: 14px;
            line-height: 1.6;
        }

        .msg-success i {
            font-size: 18px;
            margin-right: 6px;
        }

        .msg-error {
            background: #ffebee;
            color: #c62828;
            padding: 14px 18px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-weight: 600;
            font-size: 14px;
        }

        .password-requirements {
            text-align: left;
            font-size: 12px;
            color: #999;
            margin: 0 0 15px 5px;
        }

        .password-requirements li {
            margin-bottom: 4px;
        }
    </style>
}

<div class="login-page-wrapper">
    <div class="reset-card">
        <div class="icon-circle">
            <i class="fas fa-key"></i>
        </div>

        <h1>Create New Password</h1>

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="msg-success">
                <i class="fas fa-check-circle"></i> @Model.SuccessMessage
            </div>
            <a href="/Login" class="back-link"><i class="fas fa-sign-in-alt"></i> Go to Sign In</a>
        }
        else
        {
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="msg-error">
                    <i class="fas fa-exclamation-circle"></i> @Model.ErrorMessage
                </div>
            }

            @if (string.IsNullOrEmpty(Model.Token) || string.IsNullOrEmpty(Model.Email))
            {
                <p>This reset link is invalid or has expired.</p>
                <a href="/ForgotPassword" class="back-link"><i class="fas fa-redo"></i> Request a new link</a>
            }
            else
            {
                <p>Enter your new password below. Make sure it's strong and memorable.</p>

                <ul class="password-requirements">
                    <li>At least 6 characters long</li>
                    <li>Both passwords must match</li>
                </ul>

                <form method="post">
                    <input type="hidden" asp-for="Token" />
                    <input type="hidden" asp-for="Email" />
                    <input type="password" asp-for="NewPassword" placeholder="New Password" required minlength="6" />
                    <input type="password" asp-for="ConfirmPassword" placeholder="Confirm New Password" required minlength="6" />
                    <button type="submit" class="btn-reset">Update Password</button>
                </form>

                <a href="/Login" class="back-link"><i class="fas fa-arrow-left"></i> Back to Sign In</a>
            }
        }
    </div>
</div>
