@page
@model WebApps.Pages.GroupsModel
@{
    ViewData["Title"] = "Group Tickets - National Conservation Zoo";
}

@section Styles {
    <link rel="stylesheet" href="css/groups.css">
}

<main class="groups-page-wrapper">
    <section class="hero-groups">
        <h1>Group Ticket Sales</h1>
        <p>Your pack's next wild adventure starts here!</p>
    </section>

    <!-- Band 1 -->
    <div class="color-band band-teal">
        <div class="band-content-wrapper">
            <div class="band-text-box">
                <h2>Traveling With the Pack</h2>
                <p>Take advantage of our special discounted rates for groups of 15 and up! Explore our varied habitats and experience wildlife firsthand.</p>
                <a href="#form" class="band-link">Request Group Booking ></a>
            </div>
        </div>
        <div class="band-image-container">
            <img src="/Source/Groupticket/pexels-98046052-18189294.jpg" alt="Golden Lion Tamarin">
        </div>
    </div>

    <!-- Band 2 -->
    <div class="color-band band-blue">
        <div class="band-content-wrapper">
            <div class="band-text-box">
                <h2>Group Rates & Benefits</h2>
                <ul>
                    <li><strong>School Groups (K-12):</strong> $15 per student (Weekdays)</li>
                    <li><strong>Summer Camps:</strong> $18 per camper (Weekdays)</li>
                    <li><strong>Scout Groups:</strong> $20 per scout (Includes Commemorative Zoo Patch)</li>
                    <li><strong>General Groups (15+):</strong> $20-$34 per guest</li>
                </ul>
                <p>Advance reservations are required to receive the group discount. Payment must be made as a single transaction. We offer a 1:10 complimentary chaperone ratio for schools and camps!</p>
                <a asp-page="/Tickets" class="band-link">Buy Tickets Online ></a>
            </div>
        </div>
        <div class="band-image-container" style="border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%;">
            <img src="/Source/Groupticket/pexels-jcosta-17814033.jpg" alt="Elephant">
        </div>
    </div>

    <!-- Band 3 -->
    <div class="color-band band-grey">
        <div class="band-content-wrapper">
            <div class="band-text-box">
                <h2>Premium Insider Tours</h2>
                <p>Key to the Zoo: Premium Insider History. Philadelphia Zoo is home to an impressive past and an even brighter future! On this tour, you'll learn about some of the important ways we are using innovative strategies to help save wildlife, all while being immersed in the historic grounds.</p>
                <p>All tours will include at least one animal house tour and one Animal Ambassador meet-and-greet.</p>
                <a asp-page="/Tours" class="band-link">Book Tour ></a>
            </div>
        </div>
        <div class="band-image-container" style="border-radius: 70% 30% 30% 70% / 60% 40% 60% 40%;">
            <img src="/Source/Groupticket/pexels-nathan-stein-1486873-15308830.jpg" alt="Behind the Scenes Tour">
        </div>
    </div>

    <!-- Band 4 -->
    <div class="color-band band-green">
        <div class="band-content-wrapper">
            <div class="band-text-box">
                <h2>Community Groups</h2>
                <p>Neighbors of the Zoo either by way of residency, school enrollment, or groups leading mission-aligned projects in our nearby neighborhood are welcomed and encouraged to consider the Zoo as an extension of their home and classroom through our Community Access Program.</p>
                <p>Bus parking is free! Reach out to learn more about food, boxed lunches, and dining options.</p>
                <a asp-page="/Contact" class="band-link">Learn More ></a>
            </div>
        </div>
        <div class="band-image-container" style="border-radius: 50%;">
            <img src="/Source/Groupticket/pexels-robertkso-17292734.jpg" alt="Group of people">
        </div>
    </div>

    <section id="form" class="group-form-section">
        @if (TempData["GroupSuccess"] != null)
        {
            <div style="background: #e8f5e9; border: 1px solid #4caf50; color: #2e7d32; padding: 20px; border-radius: 8px; margin: 20px auto; max-width: 900px; text-align: center; font-size: 16px;">
                <i class="fa fa-check-circle" style="font-size: 24px; margin-right: 10px;"></i>@TempData["GroupSuccess"]
            </div>
        }
        <div class="form-container-split">
            <div class="form-text-left">
                <h2 style="font-family: Georgia, serif; font-size: 48px; font-weight: normal; margin-bottom: 20px; color: var(--zoo-dark);">Request a Group Booking</h2>
                <p style="font-size: 16px; line-height: 1.6; color: #444; margin-bottom: 30px; max-width: 400px;">
                    Our highly trained staff are here to help you plan the perfect wild adventure. Fill out this form to give us an idea of your group's size and needs, and a member of the National Conservation Zoo team will get back to you!
                </p>
                <img src="/Source/Picture/encounter.jpg" alt="Zoo Staff" style="width: 250px; border-radius: 20px; box-shadow: 0 10px 20px rgba(0,0,0,0.1);">
            </div>
            
            <div class="form-box-right">
                <form class="custom-jagged-form" method="post">
                    <div class="form-group-outline">
                        <label>Organization Name <span class="req">(Required)</span></label>
                        <input type="text" asp-for="OrganizationName" required>
                    </div>
                    
                    <div class="form-group-outline">
                        <label>Contact Name <span class="req">(Required)</span></label>
                        <input type="text" asp-for="ContactName" required>
                    </div>

                    <div class="form-group-outline">
                        <label>Email Address <span class="req">(Required)</span></label>
                        <input type="email" asp-for="EmailAddress" required>
                    </div>

                    <div class="form-group-outline double-col">
                        <div class="half-col">
                            <label>Phone Number</label>
                            <input type="tel" asp-for="Phone">
                        </div>
                        <div class="half-col">
                            <label>Estimated Headcount <span class="req">(Required)</span></label>
                            <input type="number" asp-for="Headcount" min="15" required>
                        </div>
                    </div>

                    <div class="form-group-outline">
                        <label>Preferred Visit Date</label>
                        <input type="date" asp-for="PreferredDate">
                    </div>

                    <div class="form-group-outline">
                        <label>Additional Needs / Message <span class="req">(Required)</span></label>
                        <textarea rows="4" asp-for="AdditionalNeeds" required></textarea>
                    </div>

                    <button type="submit" class="btn-jagged-submit">Submit Request</button>
                </form>
            </div>
        </div>
    </section>

    <partial name="_AdventureBar" />

</main>

