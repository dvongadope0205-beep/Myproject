<script>
    // ── Section Switching ──────────────────────────────────────────────
    const sectionMeta = {
        overview: { title: 'Overview', sub: 'System activity and statistics overview', addBtn: false },
        events:   { title: 'Manage Events', sub: 'Add, edit, or delete zoo events', addBtn: true, addLabel: 'Add Event', addFn: 'openEventModal' },
        shop2:    { title: 'Manage Shop Products', sub: 'Manage products in the zoo store', addBtn: true, addLabel: 'Add Product', addFn: 'openProductModal' },
        pending:  { title: 'Pending Cash Orders', sub: 'Approve and complete cash-on-delivery orders', addBtn: false },
        pendingpayments: { title: 'Details Pending', sub: 'View all transaction logs currently in pending state', addBtn: false },
        refunds:  { title: 'Refund Requests', sub: 'Manage active customer refund requests', addBtn: false },
        contacts: { title: 'Contact Messages', sub: 'View contact form inquiries submitted by visitors', addBtn: false },
        donations: { title: 'Donation History', sub: 'View all donation records and details', addBtn: false }
    };

    function switchSection(name) {
        document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
        document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
        document.getElementById('section-' + name).classList.add('active');
        document.getElementById('nav-' + name).classList.add('active');

        const meta = sectionMeta[name];
        document.getElementById('topbar-title').textContent = meta.title;
        document.getElementById('topbar-sub').textContent = meta.sub;

        const addBtn = document.getElementById('topbar-add-btn');
        if (meta.addBtn) {
            addBtn.style.display = 'flex';
            document.getElementById('topbar-add-label').textContent = meta.addLabel;
            addBtn.onclick = window[meta.addFn];
        } else {
            addBtn.style.display = 'none';
        }
    }

    // ── Shop 2 Pagination, Filtering & Sorting State ────────────────────
    let shop2State = {
        search: '',
        category: '',
        sortBy: 'name',
        sortDesc: false,
        page: 1,
        pageSize: 10
    };
    let shop2AllRows = [];

    function onShop2Search(val) {
        shop2State.search = val.trim().toLowerCase();
        shop2State.page = 1;
        applyShop2FilterSortPaginate();
    }

    function onShop2CategoryFilter(val) {
        shop2State.category = val.trim().toLowerCase();
        shop2State.page = 1;
        applyShop2FilterSortPaginate();
    }

    function onShop2Sort(field) {
        if (shop2State.sortBy === field) {
            shop2State.sortDesc = !shop2State.sortDesc;
        } else {
            shop2State.sortBy = field;
            shop2State.sortDesc = false;
        }
        
        // Update sort icons
        const fields = ['name', 'category', 'price', 'stock'];
        fields.forEach(f => {
            const icon = document.getElementById('sort-icon-' + f);
            if (icon) {
                if (f === field) {
                    icon.className = shop2State.sortDesc ? 'fa fa-sort-desc' : 'fa fa-sort-asc';
                    icon.style.opacity = '1';
                } else {
                    icon.className = 'fa fa-sort';
                    icon.style.opacity = '0.6';
                }
            }
        });
        
        applyShop2FilterSortPaginate();
    }

    function applyShop2FilterSortPaginate() {
        // 1. Filter
        let filtered = shop2AllRows.filter(row => {
            const name = row.dataset.name || '';
            const category = row.dataset.category || '';
            
            const matchesSearch = !shop2State.search || name.includes(shop2State.search);
            const matchesCategory = !shop2State.category || category === shop2State.category;
            
            return matchesSearch && matchesCategory;
        });
        
        // 2. Sort
        filtered.sort((a, b) => {
            let valA = a.dataset[shop2State.sortBy];
            let valB = b.dataset[shop2State.sortBy];
            
            if (shop2State.sortBy === 'price' || shop2State.sortBy === 'stock') {
                valA = parseFloat(valA) || 0;
                valB = parseFloat(valB) || 0;
            } else {
                valA = (valA || '').toString();
                valB = (valB || '').toString();
            }
            
            if (valA < valB) return shop2State.sortDesc ? 1 : -1;
            if (valA > valB) return shop2State.sortDesc ? -1 : 1;
            return 0;
        });
        
        // 3. Paginate
        const total = filtered.length;
        const pageCount = Math.ceil(total / shop2State.pageSize) || 1;
        if (shop2State.page > pageCount) shop2State.page = pageCount;
        if (shop2State.page < 1) shop2State.page = 1;
        
        const startIdx = (shop2State.page - 1) * shop2State.pageSize;
        const endIdx = Math.min(startIdx + shop2State.pageSize, total);
        
        // Show/hide rows in DOM
        shop2AllRows.forEach(row => {
            row.style.display = 'none';
        });
        
        for (let i = startIdx; i < endIdx; i++) {
            filtered[i].style.display = '';
        }
        
        // Put rows in order in tbody
        const tbody = document.getElementById('shop2-table-body');
        if (tbody) {
            filtered.forEach(row => tbody.appendChild(row));
        }
        
        // Update count display
        const countDisplay = document.getElementById('shop2-count-display');
        if (countDisplay) {
            countDisplay.textContent = total + ' product' + (total !== 1 ? 's' : '');
        }
        
        // Update pagination labels
        const pagInfo = document.getElementById('shop2-pagination-info');
        if (pagInfo) {
            if (total === 0) {
                pagInfo.textContent = 'Showing 0 products';
            } else {
                pagInfo.textContent = `Showing ${startIdx + 1} to ${endIdx} of ${total} products`;
            }
        }
        
        // Render pagination buttons
        const pagButtons = document.getElementById('shop2-pagination-buttons');
        if (pagButtons) {
            pagButtons.innerHTML = '';
            
            // Prev button
            const prevBtn = document.createElement('button');
            prevBtn.type = 'button';
            prevBtn.className = 'filter-pill';
            prevBtn.style.padding = '5px 12px';
            prevBtn.disabled = shop2State.page === 1;
            prevBtn.innerHTML = '<i class="fa fa-angle-left"></i>';
            prevBtn.onclick = () => {
                if (shop2State.page > 1) {
                    shop2State.page--;
                    applyShop2FilterSortPaginate();
                }
            };
            pagButtons.appendChild(prevBtn);
            
            // Page numbers
            for (let i = 1; i <= pageCount; i++) {
                const pageBtn = document.createElement('button');
                pageBtn.type = 'button';
                pageBtn.className = 'filter-pill' + (i === shop2State.page ? ' active' : '');
                pageBtn.style.padding = '5px 12px';
                pageBtn.textContent = i;
                pageBtn.onclick = () => {
                    shop2State.page = i;
                    applyShop2FilterSortPaginate();
                };
                pagButtons.appendChild(pageBtn);
            }
            
            // Next button
            const nextBtn = document.createElement('button');
            nextBtn.type = 'button';
            nextBtn.className = 'filter-pill';
            nextBtn.style.padding = '5px 12px';
            nextBtn.disabled = shop2State.page === pageCount;
            nextBtn.innerHTML = '<i class="fa fa-angle-right"></i>';
            nextBtn.onclick = () => {
                if (shop2State.page < pageCount) {
                    shop2State.page++;
                    applyShop2FilterSortPaginate();
                }
            };
            pagButtons.appendChild(nextBtn);
        }
    }

    // Auto-select section from URL query string if present
    document.addEventListener('DOMContentLoaded', function() {
        const urlParams = new URLSearchParams(window.location.search);
        const section = urlParams.get('section') || 'overview';
        if (sectionMeta[section]) {
            switchSection(section);
        }
        
        // Cache and initialize Shop 2 elements
        const rows = document.querySelectorAll('.shop2-product-row');
        shop2AllRows = Array.from(rows);
        applyShop2FilterSortPaginate();
    });

    function openAddModal() {
        const activeSection = document.querySelector('.nav-item.active')?.id?.replace('nav-','');
        if (activeSection === 'events') openEventModal();
        else if (activeSection === 'shop' || activeSection === 'shop2') openProductModal();
    }

    // ── Event Modal ────────────────────────────────────────────────────
    function openEventModal(btnOrId) {
        let id = 0, title = '', desc = '', date = '', cap = 100, price = 0.00, expect = '', details = '', sponsors = '', location = '', status = 'Active';
        if (btnOrId && typeof btnOrId === 'object' && btnOrId.nodeType === 1) {
            id = parseInt(btnOrId.dataset.id) || 0;
            title = btnOrId.dataset.title || '';
            desc = btnOrId.dataset.desc || '';
            date = btnOrId.dataset.date || '';
            cap = parseInt(btnOrId.dataset.cap) || 100;
            price = parseFloat(btnOrId.dataset.price) || 0.00;
            expect = btnOrId.dataset.expect || '';
            details = btnOrId.dataset.details || '';
            sponsors = btnOrId.dataset.sponsors || '';
            location = btnOrId.dataset.location || '';
            status = btnOrId.dataset.status || 'Active';
        } else if (typeof btnOrId === 'number' || typeof btnOrId === 'string') {
            id = parseInt(btnOrId) || 0;
            title = arguments[1] || '';
            desc = arguments[2] || '';
            date = arguments[3] || '';
            cap = parseInt(arguments[4]) || 100;
            price = parseFloat(arguments[5]) || 0.00;
        }

        document.getElementById('eventModalTitle').innerHTML =
            id === 0 ? '<i class="fa fa-calendar-plus-o" style="color:var(--accent-dark);"></i> Add New Event'
                     : '<i class="fa fa-edit" style="color:var(--accent-dark);"></i> Edit Event';
        document.getElementById('EventId').value = id;
        document.getElementById('EvtTitle').value = title;
        document.getElementById('EvtDescription').value = desc;
        document.getElementById('EvtWhatToExpect').value = expect;
        document.getElementById('EvtEventDetails').value = details;
        document.getElementById('EvtSponsors').value = sponsors;
        document.getElementById('EvtLocation').value = location;
        document.getElementById('EvtStatus').value = status;
        document.getElementById('ImageUpload').value = '';
        if (!date) {
            const now = new Date();
            now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
            date = now.toISOString().slice(0,16);
        }
        document.getElementById('EventDate').value = date;
        document.getElementById('Capacity').value = cap;
        document.getElementById('BasePrice').value = price;
        document.getElementById('eventModal').classList.add('open');
    }
    function closeEventModal() {
        document.getElementById('eventModal').classList.remove('open');
    }

    // ── Product Modal ──────────────────────────────────────────────────
    function openProductModal(btnOrId) {
        let id = 0, name = '', info = '', detail = '', care = '', price = 0.00, stock = 50, cat = '', image = '', images = '';
        let sizeEnabled = false, sizeChartEnabled = false, featured = false, isNew = false;
        if (btnOrId && typeof btnOrId === 'object' && btnOrId.nodeType === 1) {
            id = parseInt(btnOrId.dataset.id) || 0;
            name = btnOrId.dataset.name || '';
            info = btnOrId.dataset.info || '';
            detail = btnOrId.dataset.detail || '';
            care = btnOrId.dataset.care || '';
            price = parseFloat(btnOrId.dataset.price) || 0.00;
            stock = parseInt(btnOrId.dataset.stock) || 50;
            cat = btnOrId.dataset.category || '';
            image = btnOrId.dataset.image || '';
            images = btnOrId.dataset.images || '';
            sizeEnabled = btnOrId.dataset.sizeEnabled === "1";
            sizeChartEnabled = btnOrId.dataset.sizeChartEnabled === "1";
            featured = btnOrId.dataset.featured === "1";
            isNew = btnOrId.dataset.new === "1";
        } else if (typeof btnOrId === 'number' || typeof btnOrId === 'string') {
            id = parseInt(btnOrId) || 0;
            name = arguments[1] || '';
            info = arguments[2] || '';
            price = parseFloat(arguments[3]) || 0.00;
            stock = parseInt(arguments[4]) || 50;
            cat = arguments[5] || '';
        }

        const form = document.getElementById('productForm');
        const activeSection = document.querySelector('.nav-item.active')?.id?.replace('nav-','');
        if (activeSection === 'shop2') {
            form.action = '/AdminDashboard?handler=SaveProduct2';
        } else {
            form.action = '/AdminDashboard?handler=SaveProduct';
        }

        document.getElementById('productModalTitle').innerHTML =
            id === 0 ? '<i class="fa fa-plus-circle" style="color:var(--accent-dark);"></i> Add New Product'
                     : '<i class="fa fa-edit" style="color:var(--accent-dark);"></i> Edit Product';
        document.getElementById('ProductId').value = id;
        document.getElementById('ProdName').value = name;
        document.getElementById('ProdInformation').value = info;
        document.getElementById('ProdDetail').value = detail;
        document.getElementById('ProdMaterialAndCare').value = care;
        document.getElementById('ProdPrice').value = price;
        document.getElementById('ProdStock').value = stock;
        document.getElementById('ProductImageUpload').value = '';
        document.getElementById('ProdIsSizeEnabled').checked = sizeEnabled;
        document.getElementById('ProdIsSizeChartEnabled').checked = sizeChartEnabled;
        document.getElementById('ProdIsFeatured').checked = featured;
        document.getElementById('ProdIsNew').checked = isNew;
        const catSel = document.getElementById('ProdCategory');
        if (cat && catSel) {
            for (let i = 0; i < catSel.options.length; i++) {
                if (catSel.options[i].value === cat) { catSel.selectedIndex = i; break; }
            }
        }

        // Live Image Gallery Preview logic
        const container = document.getElementById('ModalProductGalleryContainer');
        const mainPreview = document.getElementById('ModalMainPreview');
        const strip = document.getElementById('ModalThumbnailsStrip');
        strip.innerHTML = '';

        let allImages = [];
        if (image) allImages.push(image);
        if (images) {
            images.split(',').forEach(img => {
                const cleaned = img.trim();
                if (cleaned && !allImages.includes(cleaned)) allImages.push(cleaned);
            });
        }

        if (allImages.length > 0) {
            container.style.display = 'block';
            mainPreview.src = allImages[0];
            allImages.forEach((imgUrl, index) => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.style = 'border: 2px solid ' + (index === 0 ? '#72441c' : '#ebd4bd') + '; padding: 2px; background: #fff; cursor: pointer; border-radius: 4px; width: 50px; height: 50px; display: flex; align-items: center; justify-content: center;';
                btn.innerHTML = `<img src="${imgUrl}" style="width: 100%; height: 100%; object-fit: contain;" />`;
                btn.onclick = function() {
                    mainPreview.src = imgUrl;
                    Array.from(strip.children).forEach(c => c.style.borderColor = '#ebd4bd');
                    btn.style.borderColor = '#72441c';
                };
                strip.appendChild(btn);
            });
        } else {
            container.style.display = 'none';
        }

        document.getElementById('productModal').classList.add('open');
    }
    function closeProductModal() {
        document.getElementById('productModal').classList.remove('open');
    }

    // Dynamic Multi-Image Gallery preview for local files selection
    document.addEventListener('DOMContentLoaded', function() {
        const imgInput = document.getElementById('ProductImageUpload');
        if (imgInput) {
            imgInput.addEventListener('change', function(e) {
                const files = e.target.files;
                const container = document.getElementById('ModalProductGalleryContainer');
                const mainPreview = document.getElementById('ModalMainPreview');
                const strip = document.getElementById('ModalThumbnailsStrip');
                strip.innerHTML = '';
                if (files && files.length > 0) {
                    container.style.display = 'block';
                    mainPreview.src = URL.createObjectURL(files[0]);
                    Array.from(files).forEach((file, index) => {
                        const imgUrl = URL.createObjectURL(file);
                        const btn = document.createElement('button');
                        btn.type = 'button';
                        btn.style = 'border: 2px solid ' + (index === 0 ? '#72441c' : '#ebd4bd') + '; padding: 2px; background: #fff; cursor: pointer; border-radius: 4px; width: 50px; height: 50px; display: flex; align-items: center; justify-content: center;';
                        btn.innerHTML = `<img src="${imgUrl}" style="width: 100%; height: 100%; object-fit: contain;" />`;
                        btn.onclick = function() {
                            mainPreview.src = imgUrl;
                            Array.from(strip.children).forEach(c => c.style.borderColor = '#ebd4bd');
                            btn.style.borderColor = '#72441c';
                        };
                        strip.appendChild(btn);
                    });
                } else {
                                    container.style.display = 'none';
                                }
                            });
                        }
                    });

                    // ── Refund Modals Logic ─────────────────────────────────────────────
                    let currentRefundForm = null;
                    function showRefundConfirmModal(form, amount) {
                        currentRefundForm = form;
                        document.getElementById('refundConfirmAmount').textContent = '$' + amount;
                        document.getElementById('refundConfirmModal').classList.add('open');
                    }
                    function closeRefundConfirmModal() {
                        document.getElementById('refundConfirmModal').classList.remove('open');
                        currentRefundForm = null;
                    }
                    function closeRefundSuccessModal() {
                        document.getElementById('refundSuccessModal').classList.remove('open');
                    }
                    function closeSaveSuccessModal() {
                        document.getElementById('saveSuccessModal').classList.remove('open');
                    }

                    // ── Delete Modals Logic ─────────────────────────────────────────────
                    let currentDeleteForm = null;
                    function showDeleteConfirmModal(form, message, title = 'Confirm Action', confirmText = 'Confirm', confirmBgColor = '#dc2626') {
                        currentDeleteForm = form;
                        document.getElementById('deleteConfirmTitle').textContent = title;
                        document.getElementById('deleteConfirmMessage').textContent = message;
                        const submitBtn = document.getElementById('deleteConfirmSubmitBtn');
                        if (submitBtn) {
                            submitBtn.textContent = confirmText;
                            submitBtn.style.backgroundColor = confirmBgColor;
                        }
                        document.getElementById('deleteConfirmModal').classList.add('open');
                    }
                    function closeDeleteConfirmModal() {
                        document.getElementById('deleteConfirmModal').classList.remove('open');
                        currentDeleteForm = null;
                    }
                    
                    document.addEventListener('DOMContentLoaded', function() {
                        const confirmBtn = document.getElementById('refundConfirmSubmitBtn');
                        if (confirmBtn) {
                            confirmBtn.addEventListener('click', function() {
                                if (currentRefundForm) {
                                    currentRefundForm.submit();
                                }
                            });
                        }

                        const deleteBtn = document.getElementById('deleteConfirmSubmitBtn');
                        if (deleteBtn) {
                            deleteBtn.addEventListener('click', function() {
                                if (currentDeleteForm) {
                                    currentDeleteForm.submit();
                                }
                            });
                        }
                    });

                    // Close modals on overlay click
                    document.getElementById('eventModal').addEventListener('click', function(e) {
                        if (e.target === this) closeEventModal();
                    });
                    document.getElementById('productModal').addEventListener('click', function(e) {
                        if (e.target === this) closeProductModal();
                    });
                    document.getElementById('refundConfirmModal').addEventListener('click', function(e) {
                        if (e.target === this) closeRefundConfirmModal();
                    });
                    document.getElementById('refundSuccessModal').addEventListener('click', function(e) {
                        if (e.target === this) closeRefundSuccessModal();
                    });
                    document.getElementById('deleteConfirmModal').addEventListener('click', function(e) {
                        if (e.target === this) closeDeleteConfirmModal();
                    });
                    document.getElementById('saveSuccessModal').addEventListener('click', function(e) {
                        if (e.target === this) closeSaveSuccessModal();
                    });

                    // Escape key
                    document.addEventListener('keydown', function(e) {
                        if (e.key === 'Escape') {
                            closeEventModal();
                            closeProductModal();
                            closeRefundConfirmModal();
                            closeRefundSuccessModal();
                            closeDeleteConfirmModal();
                            closeSaveSuccessModal();
                        }
                    });
                </script>

                @if (TempData["RefundSuccess"] != null)
                {
                    <script>
                        document.addEventListener('DOMContentLoaded', function() {
                            document.getElementById('refundSuccessMessage').textContent = "@Html.Raw(TempData["RefundSuccess"])";
                            document.getElementById('refundSuccessModal').classList.add('open');
                        });
                    </script>
                }

                @if (TempData["SaveSuccess"] != null)
                {
                    <script>
                        document.addEventListener('DOMContentLoaded', function() {
                            document.getElementById('saveSuccessMessage').textContent = "@Html.Raw(TempData["SaveSuccess"])";
                            document.getElementById('saveSuccessModal').classList.add('open');
                        });
                    </script>
                }
</body>
</html>
