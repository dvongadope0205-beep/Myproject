<div class="philly-grid">
    <!-- Card 1 -->
    <div class="philly-card">
        <img src="~/Source/Picture/encounter.jpg" alt="Animal Encounters" class="philly-card-img">
        <div class="philly-card-body">
            <h3>Animal Encounters</h3>
            <p>Get closer than ever! Meet some of your favorite animals up-close during an exclusive wild encounter guided by our expert keepers.</p>
            <div>
                <a asp-page="/Encounters" class="philly-book">Learn More</a>
            </div>
        </div>
    </div>

    <!-- Card 2 -->
    <div class="philly-card">
        <img src="~/Source/Picture/camp.jpg" alt="Zoo Summer Camp" class="philly-card-img">
        <div class="philly-card-body">
            <h3>Zoo Summer Camp</h3>
            <p>Designed for young explorers, our Zoo Summer Camp offers hands-on wildlife education, behind-the-scenes access, and unforgettable memories.</p>
            <div>
                <a asp-page="/Camp" class="philly-book">Learn More</a>
            </div>
        </div>
    </div>

    <!-- Card 3 -->
    <div class="philly-card">
        <img src="~/Source/Picture/membership.jpg" alt="Become a Member" class="philly-card-img">
        <div class="philly-card-body">
            <h3>Become a Member</h3>
            <p>Enjoy free unlimited access all year, discounted tickets to special events, and support global wildlife conservation efforts directly with your membership.</p>
            <div>
                <a asp-page="/Join" class="philly-book">Join Today</a>
            </div>
        </div>
    </div>
</div>
