<div class="modal-overlay" id="productModal">
    <div class="modal-box">
        <button class="modal-close" onclick="closeProductModal()">&#10005;</button>
        <h2 class="modal-title" id="productModalTitle">
            <i class="fa fa-plus-circle" style="color:var(--accent-dark);"></i> Add Product
        </h2>

        <form id="productForm" method="post" asp-page-handler="SaveProduct" enctype="multipart/form-data" runat="server">
            <input type="hidden" id="ProductId" name="CurrentProduct.ProductId" value="0">

            @foreach (var field in Model.ProductFormFields)
            {
                @if (field.Type == "checkbox")
                {
                    <div class="form-group">
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <input type="checkbox" id="@field.Id" name="@field.Name" value="true" style="width: 20px; height: 20px; cursor: pointer; accent-color: #72441c;" />
                            <input type="hidden" name="@field.Name" value="false" />
                            <label for="@field.Id" style="margin: 0; cursor: pointer; font-weight: 600;">@field.Label</label>
                        </div>
                    </div>
                }
                else
                {
                    <div class="form-group">
                        <label>@field.Label</label>
                        @if (field.Type == "textarea")
                        {
                            <textarea id="@field.Id" name="@field.Name" rows="@field.Rows" placeholder="@field.Placeholder" @(field.IsRequired ? "required" : "")></textarea>
                        }
                        else if (field.Type == "select")
                        {
                            <select id="@field.Id" name="@field.Name" style="width: 100%; padding: 10px; 
                            border: 1.5px solid #ebd4bd; border-radius: 8px; font-size: 14px; outline: none; background: white;">
                                @foreach (var cat in Model.ShopCategories)
                                {
                                    <option value="@cat.Name">@cat.Name</option>
                                }
                                @if (!Model.ShopCategories.Any())
                                {
                                    <option value="Souvenirs">Souvenirs</option>
                                    <option value="Apparel">Apparel</option>
                                    <option value="Accessories">Accessories</option>
