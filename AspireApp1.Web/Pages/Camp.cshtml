@page
@model WebApps.Pages.CampModel
@{
    ViewData["Title"] = "Zoo Summer Camp - National Conservation Zoo";
}

@section Styles {
    <link rel="stylesheet" href="css/pages.css">
    <style>
        .camp-activities-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 30px;
            margin-top: 40px;
        }

        .activity-card {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
            transition: transform 0.3s ease;
            display: flex;
            flex-direction: column;
        }

        .activity-card:hover {
            transform: translateY(-5px);
        }

        .activity-icon-area {
            height: 180px;
            background-color: var(--zoo-dark);
            position: relative;
            overflow: hidden;
        }

        .activity-icon-area img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: 0.8;
            transition: opacity 0.3s;
        }
        
        .activity-card:hover .activity-icon-area img {
            opacity: 1;
        }

        .activity-content {
            padding: 25px;
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .activity-content h4 {
            font-size: 20px;
            color: var(--zoo-green);
            margin-top: 0;
            margin-bottom: 2px;
        }
        
        .card-date-badge {
            font-size: 13px;
            font-weight: bold;
            color: #d35400;
            display: block;
            margin-bottom: 12px;
        }

        .activity-content p {
            color: #555;
            font-size: 15px;
            line-height: 1.6;
            margin-bottom: 20px;
            flex: 1;
        }

        .btn-camp-ticket {
            background-color: var(--zoo-green);
            color: white;
            padding: 10px 20px;
            border-radius: 4px;
            text-decoration: none;
            font-weight: bold;
            display: inline-block;
            text-align: center;
            transition: background 0.3s;
            cursor: pointer;
            border: none;
        }
        .btn-camp-ticket:hover {
            background-color: #0d7a50;
        }
        
        /* Modal Styles */
        #campModal {
            display:none; 
            position: fixed; 
            top: 0; left: 0; 
            width: 100%; height: 100%; 
            background: rgba(0,0,0,0.7); 
            z-index: 9999; 
            justify-content: center; 
            align-items: center; 
            padding: 20px;
            box-sizing: border-box;
        }
        
        .modal-content-box {
            background: white; 
            border-radius: 12px; 
            width: 100%; 
            max-width: 800px; 
            max-height: 90vh; 
            overflow: hidden;
            display: flex;
            flex-direction: column;
            position: relative;
            box-shadow: 0 20px 50px rgba(0,0,0,0.3);
            animation: slideUp 0.3s ease;
        }
        
        @@keyframesx slideUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .modal-body-scroll {
            overflow-y: auto;
            flex: 1;
        }
    </style>
}

<main>
    <section class="page-hero">
        <h1>Zoo Summer Camp</h1>
        <p>Ignite your child's passion for wildlife with hands-on learning and interactive games.</p>
    </section>

    <section class="page-content-wrap" style="max-width: 1200px; padding: 60px 20px; margin: auto;">
        
        <!-- Intro Section -->
        <div style="text-align:center; margin-bottom: 60px;">
            <h2 style="font-size: 42px; font-family: Georgia, serif; color: var(--zoo-dark);">The Ultimate Wild Summer</h2>
            <p style="font-size: 18px; color: #555; max-width: 800px; margin: 20px auto; line-height: 1.6;">
                Our Zoo Summer Camp programs offer kids an unparalleled interactive experience. We mix education with amazing outdoor fun, allowing young conservationists to deeply connect with science, wildlife, and natural habitats spanning across the globe.
            </p>
        </div>

        <!-- Hero Overview Block -->
        <div style="display: flex; flex-wrap: wrap; background: white; border-radius: 12px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.1); margin-bottom: 60px;">
            <div style="flex: 1; min-width: 300px;">
                <img src="/Source/Picture/camp.jpg" alt="Summer Camp Kids" style="width: 100%; height: 100%; object-fit: cover; min-height: 400px;">
            </div>
            <div style="flex: 1; padding: 50px; min-width: 300px; display: flex; flex-direction: column; justify-content: center;">
                <h3 style="font-size: 32px; margin-bottom: 20px; color: var(--zoo-dark); font-family: Georgia, serif;">Immersive K-8 Camp Experience</h3>
                <p style="color: #666; font-size: 16px; line-height: 1.7; margin-bottom: 30px;">
                    Structured by age group, our camps use the zoo as a living, breathing laboratory. From early childhood nature play to advanced zookeeping techniques for older kids, it's the perfect environment to foster a profound respect for nature while making lifelong friends!
                </p>
                <div style="background: #f4f6f5; padding: 20px; border-left: 5px solid var(--zoo-green); margin-bottom: 30px;">
                    <p style="margin: 0; color: #222; font-size: 16px;"><strong>Full Day Camp:</strong> 9:00 AM - 4:00 PM</p>
                    <p style="margin: 8px 0 0 0; color: #222; font-size: 16px;"><strong>Half Day Camp:</strong> 9:00 AM - 12:00 PM</p>
                </div>
                
                <div style="display: flex; gap: 15px; align-items: center; flex-wrap: wrap;">
                    <a asp-page="/Tickets" class="btn-zoo">Reserve Camp Tickets</a>
                    <span style="font-size: 14px; color: #888;">*Member discounts apply automatically.</span>
                </div>
            </div>
        </div>
        

    </section>
    <partial name="_AdventureBar" />
</main>

