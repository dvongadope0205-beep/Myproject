<!-- User Account Icon / Initials Avatar with Dropdown -->
@if (User.Identity?.IsAuthenticated == true)
{
    var name = User.Identity.Name ?? "U";
    var initial = name.Trim().Length > 0 ? name.Trim().Substring(0, 1).ToUpper() : "U";
    <div class="shop-auth-dropdown" style="position: relative; display: inline-block;">
        <div class="shop-avatar-trigger" style="cursor: pointer; display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 50%; background-color: rgb(114, 68, 28); color: #fff; font-weight: 600; font-size: 14px; border: 1.5px solid #fff; box-shadow: 0 0 0 1px rgb(114, 68, 28); text-align: center; line-height: 29px; font-family: 'Fredoka', sans-serif;">
            @initial
        </div>
        <div class="shop-auth-menu" style="display: none; position: absolute; right: 0; top: 42px; background-color: #fff; min-width: 200px; box-shadow: 0 8px 24px rgba(0,0,0,0.15); z-index: 1000; border-radius: 10px; overflow: hidden; border: 1px solid #eee;">
            <a href="/Shopnew/info" style="display: block; padding: 12px 18px; color: #492719; text-decoration: none; font-size: 14px; font-family: 'Fredoka', sans-serif; font-weight: 500; border-bottom: 1px solid #f5f5f5; transition: background 0.15s;">📋 Information</a>
            @if (User.IsInRole("Admin"))
            {
                <a href="/AdminDashboard" style="display: block; padding: 12px 18px; color: #492719; text-decoration: none; font-size: 14px; font-family: 'Fredoka', sans-serif; font-weight: 500; border-bottom: 1px solid #f5f5f5; transition: background 0.15s;">🛠️ Details</a>
            }
            else
            {
                <a href="/Shopnew/purchase-history" style="display: block; padding: 12px 18px; color: #492719; text-decoration: none; font-size: 14px; font-family: 'Fredoka', sans-serif; font-weight: 500; border-bottom: 1px solid #f5f5f5; transition: background 0.15s;">📦 Purchase History</a>
                <a href="/Shopnew/refund-request" style="display: block; padding: 12px 18px; color: #492719; text-decoration: none; font-size: 14px; font-family: 'Fredoka', sans-serif; font-weight: 500; border-bottom: 1px solid #f5f5f5; transition: background 0.15s;">🔄 Refund Request</a>
            }
            <a href="/Logout" style="display: block; padding: 12px 18px; color: #c0392b; text-decoration: none; font-size: 14px; font-family: 'Fredoka', sans-serif; font-weight: 500; transition: background 0.15s;">🚪 Log Out</a>
        </div>
    </div>
}
else
{
    <a href="/Shopnew/login" title="Account" style="color: inherit; text-decoration: none; display: inline-flex; align-items: center;">
