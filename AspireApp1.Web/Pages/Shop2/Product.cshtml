        <circle class="path" cx="33" cy="33" fill="none" r="30" stroke-width="6"></circle>
        </svg>
        </div>
        <div class="product__media media media--transparent">
        <img sizes="(min-width: 2000px) 1045px, (min-width: 990px) calc(55.0vw - 10rem), (min-width: 750px) calc((100vw - 11.5rem) / 2), calc(100vw / 1 - 4rem)" src="@img" />
        </div>
        <button aria-haspopup="dialog" class="product__media-toggle quick-add-hidden product__media-zoom-lightbox" data-media-id="media-@i" type="button">
        <span class="visually-hidden">Open media @(i+1) in modal</span>
        </button>
        </modal-opener>
        </div>
        </li>
    }
</ul>
</slider-component>
<!--- Thumbnails strip go round-->
<slider-component class="thumbnail-slider" id="GalleryThumbnails-template">
<!--- LEFT Arrow -->
<button aria-label="Previous thumbnails" class="thumbnail-arrow left" onclick="scrollThumbnails(-1)">
<span class="fauvist">
<svg class="melody" viewbox="0 0 10 6">
<path clip-rule="evenodd" d="M9.354.646a.5.5 0 0 0-.708 0L5 4.293 1.354.646a.5.5 0 0 0-.708.708l4 4a.5.5 0 0 0 .708 0l4-4a.5.5 0 0 0 0-.708" fill="currentColor" fill-rule="evenodd"></path>
</svg>
</span>
</button>
<!--- Strip -->
<ul class="thumbnail-strip" id="thumbnailStrip">
    @for (int i = 0; i < imagesList.Count; i++)
    {
        var img = imagesList[i];
        string activeClass = (i == 0) ? "is-active" : "";
        <li class="thumbnail-container" data-media-position="@(i+1)" id="thumbnailsContainer">
        <button class="thumbnail-global-setting @activeClass" onclick="changeImage(this, '@img')">
        <img alt="@title" sizes="(min-width: 2000px) calc((1045 - 4rem) / 4), (min-width: 990px) calc((55.0vw - 4rem) / 4), (min-width: 750px) calc((100vw - 15rem) / 8), calc((100vw - 8rem) / 3)" src="@img" />
        </button>
        </li>
    }
</ul>
<!--- RIGHT Arrow -->
<button aria-label="Next thumbnails" class="thumbnail-arrow right" onclick="scrollThumbnails(1)">
<span class="fauvist">
<svg class="melody-right" viewbox="0 0 10 6">
<path clip-rule="evenodd" d="M9.354.646a.5.5 0 0 0-.708 0L5 4.293 1.354.646a.5.5 0 0 0-.708.708l4 4a.5.5 0 0 0 .708 0l4-4a.5.5 0 0 0 0-.708" fill="currentColor" fill-rule="evenodd"></path>
</svg>
</span>
</button>
</slider-component>
</media-gallery>
</div>
<!-- RIGHT: Product Info -->
<div class="product-info">
<section class="product-info-container" id="ProductInfo">
<div class="product-brand-category" style="font-family: var(--font-body-family); font-size: 1.3rem; font-weight: 600; text-transform: uppercase; color: #593211; opacity: 0.8; margin-bottom: 5px; letter-spacing: 1px;">Natural Habitat / @category</div>
<div class="product-title" style="
                                        --pdp-title-size: 4.5rem;
                                        --pdp-title-font-family: var(--font-heading-family);
                                        --pdp-title-font-weight: 800;
                                        --pdp-title-color: #ec993c;
                                        --pdp-title-line-height: 1;
                                        --pdp-title-letter-spacing: -1px;">
<h1>@title</h1>
</div>
<p class="product__text inline-richtext subtitle"></p>
<div class="product-pricing" id="price-template" role="status" style="
                                        --pdp-price-size: 2.3rem;
                                        --pdp-price-font-family: var(--font-body-family);
                                        --pdp-price-font-weight: 500;
                                        --pdp-price-line-height: 1;
                                        --pdp-price-letter-spacing: 0px;
                                        --pdp-price-regular-color: #593211;
                                        --pdp-price-sale-color: #593211;">
<div class="price-large">
<div class="price-container">
<div class="price-sale">
@if (!string.IsNullOrEmpty(originalPriceStr))
{
    <span class="price-regular">@originalPriceStr</span>
    <span class="price-sale">@price</span>
}
else
{
    <span class="price-standard">@price</span>
}
</div>
</div>
</div>
</div>
<div class="product-tax">
<p class="shipping-note">Shipping calculated at checkout.</p>
</div>

