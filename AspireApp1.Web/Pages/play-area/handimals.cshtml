@page "/play-area/handimals"
@model ZooProject.Pages.PlayArea.Handimals

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Poppins:wght@400;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Passion+One:wght@700;900&display=swap" rel="stylesheet">
    <style>
        /* =========================================
           1. BIẾN MÀU SẮC & THIẾT LẬP CHUNG
        ========================================= */
        :root {
            --brand-teal: #0b3c98;
            --brand-mint: #a1d4cd;
            --brand-icy: #e2f1f0; 
            --neon-lime: #E4EC81;
            --text-light: rgba(255, 255, 255, 0.85);
            --bg-dark: #0b1c1b; /* Giữ màu Twilight gốc của trang hoạt động */
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            color: var(--text-light);
            background-color: #0a3d3d !important;
            overflow-x: hidden;
            position: relative;
            min-height: 100vh;
        }

        /* Hiệu ứng hạt nhiễu (Grainy) sang trọng nền dưới */
        .texture-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background-image: url('data:image/svg+xml;utf8,%3Csvg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg"%3E%3Cfilter id="noiseFilter"%3E%3CfeTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="3" stitchTiles="stitch"/%3E%3C/filter%3E%3Crect width="100%25" height="100%25" filter="url(%23noiseFilter)" opacity="0.03"/%3E%3C/svg%3E');
            pointer-events: none;
            z-index: 0;
        }

        /* Khung chứa nội dung chính */
        .detail-container {
            max-width: 1254px;
            margin: 0 auto;
            padding: 80px 24px;
            position: relative;
            z-index: 10;
        }

        /* =========================================
           2. TYPOGRAPHY & HEADER
        ========================================= */
        .page-title {
            font-family: 'Passion One', display;
            font-size: 7rem;
            font-weight: 700;
            color: #fdf5e6;
            margin-bottom: 60px;
            letter-spacing: 1px;
            text-align: center; 
            text-transform: uppercase;
            line-height: 1;
        }

        /* =========================================
           3. BỐ CỤC SO LE (STAGGERED LAYOUT)
        ========================================= */
        .activity-section {
            display: flex;
            flex-direction: column;
            gap: 80px;
            margin-bottom: 100px;
        }

        .split-row {
            display: flex;
            align-items: center;
            gap: 64px;
        }

        /* Đ$o ngư$c vị trí hình/chữ cho hàng chẵn */
        .split-row:nth-child(even) {
            flex-direction: row-reverse;
        }

        .split-image-wrapper {
            flex: 1;
            border-radius: 32px;
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
            aspect-ratio: 4 / 3;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .split-image-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .split-image-wrapper:hover img {
            transform: scale(1.03);
        }

        .split-text-wrapper {
            flex: 1;
        }

        /* Định dạng văn b$n */
        .split-text-wrapper p {
            font-size: 1.125rem;
            line-height: 1.7;
            margin-bottom: 20px;
            color: var(--text-light);
        }

        .split-text-wrapper p strong {
            font-size: 1.5rem;
            color: #ffffff;
            display: block;
            margin-bottom: 12px;
        }

        /* Phần địa điểm (Locations) */
        .locations-box {
            background: rgba(255, 255, 255, 0.04);
            padding: 28px;
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.08);
            margin-top: 24px;
        }

        .locations-box h3 {
            font-family: 'Passion One', display;
            font-size: 1.8rem;
            color: var(--brand-mint);
            text-transform: uppercase;
            margin-bottom: 12px;
            letter-spacing: 0.5px;
        }

        .locations-box ul {
            list-style: none;
            padding-left: 0;
        }

        .locations-box li {
            position: relative;
            padding-left: 24px;
            font-size: 1.05rem;
            line-height: 1.6;
            margin-bottom: 10px;
        }

        .locations-box li::before {
            content: "•";
            position: absolute;
            left: 6px;
            color: var(--brand-mint);
            font-size: 1.5rem;
            top: -2px;
        }

        .locations-box a {
            color: #137997;
            text-decoration: none;
            font-weight: 600;
            border-bottom: 1px dashed #137997;
            transition: all 0.2s ease;
        }

        .locations-box a:hover {
            color: #57C1D2;
            border-bottom-style: solid;
        }

        /* =========================================
           4. MISSION BANNER (Đồng bộ từ Wildlife Wood)
        ========================================= */
        .mission-banner {
            position: relative;
            border-radius: 40px;
            overflow: hidden;
            display: flex;
            align-items: flex-end;
            padding: 60px 48px;
            min-height: 600px; 
            box-shadow: 0 20px 40px rgba(0,0,0,0.3);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .mission-bg-img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 0;
        }

        .mission-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to right, rgba(11, 28, 27, 0.95) 0%, rgba(11, 28, 27, 0.7) 30%, rgba(11, 28, 27, 0.1) 100%);
            z-index: 1;
        }

        .mission-content {
            position: relative;
            z-index: 2;
            max-width: 500px;
        }

        .mission-content h2 {
            font-family: 'Passion One', display;
            font-size: 3.5rem;
            color: #ffffff;
            margin-bottom: 16px;
        }

        .mission-content p {
            font-size: 1rem;
            line-height: 1.6;
            margin-bottom: 32px;
            color: #e2f1f0;
        }

        .btn-cta {
            display: inline-block;
            background-color: var(--neon-lime);
            color: #000000;
            font-weight: 700;
            font-size: 0.95rem;
            letter-spacing: 0.5px;
            padding: 16px 36px;
            border-radius: 999px;
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .btn-cta:hover {
            transform: translateY(-3px);
            background-color: #93a827;
            box-shadow: 0 10px 20px rgba(0,0,0,0.2);
        }

        /* =========================================
           5. RESPONSIVE (Cho Mobile)
        ========================================= */
        @@media (max-width: 900px) {
            .page-title { font-size: 4rem; margin-bottom: 40px; }
            .split-row, .split-row:nth-child(even) {
                flex-direction: column;
                gap: 32px;
            }
            .activity-section { gap: 60px; }
            .mission-banner { padding: 40px 24px; min-height: 450px; }
            .mission-overlay { background: linear-gradient(to top, rgba(11, 28, 27, 0.95) 0%, rgba(11, 28, 27, 0.4) 100%); }
            .mission-content h2 { font-size: 2.8rem; }
        }
        </style>
}

@* ── BODY CONTENT ── *@

<div class="texture-overlay"></div>

    <main class="detail-container">
        
        <h1 class="page-title">Hand, Finger, and Letter Art</h1>
        
        <div class="activity-section">
            
            <div class="split-row">
                <div class="split-image-wrapper">
                    <img src="/Source/play-area/family%20activities/handimals/hand-art.png" alt="Hand Art Activity">
                </div>
                <div class="split-text-wrapper">
                    <p><strong>Make your mark with Hand Art</strong></p>
                    <p>Choose your favourite animal and let our artists transform your handprint or fingerprint into a playful keepsake.</p>
                    <p>Whether it’s a single print or a full family portrait, each piece is created in just a few minutes.</p>
                </div>
            </div>

            <div class="split-row">
                <div class="split-image-wrapper">
                    <img src="/Source/play-area/family%20activities/handimals/hand-art2.jpg" alt="Bespoke Letter Art">
                </div>
                <div class="split-text-wrapper">
                    <p>Prices start from $10. Mounts, frames and custom designs are available.</p>
                    <p>Looking for something bespoke? Commission our artists for hand-painted letter art or personalised keyrings.</p>
                    <p style="font-style: italic; color: var(--brand-mint);">Open daily, weather permitting.</p>
                    
                    <div class="locations-box">
                        <h3>Locations:</h3>
                        <ul>
                            <li>Within our various <a href="/play-area/face-painting">face painting studios</a></li>
                            <li>Next to <a href="/play-area/dining">The Gannet</a></li>
                        </ul>
                    </div>
                </div>
            </div>

        </div>

        <div class="mission-banner">
            <img src="/Source/play-area/family%20activities/handimals/mission-5.jpg" class="mission-bg-img" alt="Red Panda Target Mission">
            <div class="mission-overlay"></div>
            <div class="mission-content">
                <h2>Support our mission</h2>
                <p>Every penny spent in our gift shops, face painting stations or food outlets supports our vital conversation projects, helping to save endangered species and habitats across the world!</p>
                <a href="/Tickets" class="btn-cta">BOOK ZOO TICKETS</a>
            </div>
        </div>

    </main>

