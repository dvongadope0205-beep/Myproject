@page
@model WebApps.Pages.ContactModel
@{
    ViewData["Title"] = "Contact Us - National Conservation Zoo";
}

@section Styles {
<link rel="stylesheet" href="css/pages.css">
}

<!-- ... Header boilerplate ... -->
    
    
    
    

    <!-- MAIN CONTENT START -->
    <main>
        <section class="page-hero">
            <h1>Contact Us</h1>
            <p>Have questions? We're here to help you plan your wild adventure.</p>
        </section>

        <section class="page-content-wrap">

            <div class="page-section">
                <h2>Send Us a Message</h2>
                <form class="contact-form" method="post">
                    <div class="form-group">
                        <label>First Name</label>
                        <input type="text" asp-for="FirstName" required placeholder="Jane">
                    </div>
                    <div class="form-group">
                        <label>Last Name</label>
                        <input type="text" asp-for="LastName" required placeholder="Doe">
                    </div>
                    <div class="form-group">
                        <label>Email Address</label>
                        <input type="email" asp-for="EmailAddress" required placeholder="jane@example.com">
                    </div>
                    <div class="form-group">
                        <label>Reason for Contact</label>
                        <select asp-for="Reason">
                            <option value="General Inquiry">General Inquiry</option>
                            <option value="Support Request">Support Request</option>
                            <option value="Refund Request">Refund Request</option>
                            <option value="Feedback & Suggestions">Feedback & Suggestions</option>
                            <option value="Business Partnership">Business & Partnership</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Inquiry Subject</label>
                        <select asp-for="Subject">
                            <option>General Support</option>
                            <option>Ticketing Issues</option>
                            <option>Membership</option>
                            <option>Feedback</option>
                        </select>
                    </div>
                    <div class="form-group full-width">
                        <label>Your Message</label>
                        <textarea asp-for="MessageText" required placeholder="How can we help?"></textarea>
                    </div>
                    <div class="form-group full-width">
                        <button type="submit" class="btn-primary" style="width:100%;">Submit Inquiry</button>
                    </div>
                </form>
            </div>
            <div class="page-section" style="display:flex; justify-content:space-between; flex-wrap:wrap; gap:20px;">
                <div>
                    <h3>Mailing Address</h3>
                    <p>National Conservation Zoo<br>123 Wildlife Drive<br>Hanoi, Vietnam 100000</p>
                </div>
                <div>
                    <h3>Phone Support</h3>
                    <p>Tickets & Membership: (024) 1234-5678<br>General Info: (024) 8765-4321</p>
                </div>
            </div>

            <!-- Contact the Events Team -->
            <div class="page-section" style="border-top: 3px solid #119864; padding-top: 30px; margin-top: 10px;">
                <h2 style="display:flex; align-items:center; gap:12px;">
                    <i class="fa fa-calendar-check-o" style="color:#119864; font-size:28px;"></i>
                    Contact the Events Team
                </h2>
                <p style="color:#666; margin-bottom:25px;">Planning a birthday, corporate outing, wedding, or school trip? Our Events Team will help you create an unforgettable experience at the zoo.</p>



                <form class="contact-form" method="post" asp-page-handler="EventSupport">
                    <div class="form-group">
                        <label>Full Name *</label>
                        <input type="text" asp-for="EventFullName" required placeholder="Your full name">
                    </div>
                    <div class="form-group">
                        <label>Email Address *</label>
                        <input type="email" asp-for="EventEmail" required placeholder="you@example.com">
                    </div>
                    <div class="form-group">
                        <label>Phone</label>
                        <input type="tel" asp-for="EventPhone" placeholder="(024) 123-4567">
                    </div>
                    <div class="form-group">
                        <label>Event Type *</label>
                        <select asp-for="EventType" required>
                            <option value="">Select event type...</option>
                            <option>Birthday Party</option>
                            <option>Corporate Event</option>
                            <option>Wedding Reception</option>
                            <option>School Trip</option>
                            <option>Team Building</option>
                            <option>Other</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Preferred Date</label>
                        <input type="date" asp-for="EventPreferredDate">
                    </div>
                    <div class="form-group">
                        <label>Estimated Guest Count</label>
                        <input type="number" asp-for="EventGuestCount" min="1" placeholder="50">
                    </div>
                    <div class="form-group full-width">
                        <label>Tell us about your event *</label>
                        <textarea asp-for="EventMessage" required placeholder="Describe your event, any special requirements, preferred time, budget, etc."></textarea>
                    </div>
                    <div class="form-group full-width">
                        <button type="submit" class="btn-primary" style="width:100%; background: linear-gradient(135deg, #119864, #0d7a4f);">
                            <i class="fa fa-paper-plane"></i> Submit Event Request
                        </button>
                    </div>
                </form>
            </div>
        </section>
    </main>
    <!-- MAIN CONTENT END -->

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            @if (TempData["ContactSuccess"] != null)
            {
                <text>
                showPremiumAlert('@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(TempData["ContactSuccess"].ToString()))');
                </text>
            }
            @if (TempData["EventSuccess"] != null)
            {
                <text>
                showPremiumAlert('@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(TempData["EventSuccess"].ToString()))');
                </text>
            }
        });
    </script>
}
