        <script>
            // Carousel
            document.addEventListener("DOMContentLoaded", function () {
                // 1. Tìm khung nhìn của Carousel
                const viewportNode = document.querySelector('.embla-viewport');
                if (!viewportNode) return;

                // 2. Kích hoạt phép thuật Embla với tính năng lặp vô tận (loop: true)
                // Embla sẽ tự động xử lý mọi tính toán vật lý và click liên tục
                const emblaApi = EmblaCarousel(viewportNode, { loop: true });

                // 3. Tìm 2 nút bấm mũi tên của bạn
                const prevBtn = document.querySelector('.embla-control .the-embla-button:first-child');
                const nextBtn = document.querySelector('.embla-control .the-embla-button:last-child');

                // Gắn sự kiện click. Bạn click nhanh bao nhiêu nó cũng sẽ nối đuôi mượt mà.
                if (prevBtn) prevBtn.addEventListener('click', emblaApi.scrollPrev, false);
                if (nextBtn) nextBtn.addEventListener('click', emblaApi.scrollNext, false);
            });
            // FAQ
            document.addEventListener("DOMContentLoaded", function () {
                const faqTriggers = document.querySelectorAll('.accordion-faqs .trigger');

                faqTriggers.forEach(trigger => {
                    const question = trigger.closest('.question');
                    const panel = question.querySelector('.accordion_content');

                    // Dọn dẹp sạch sẽ các thuộc tính gây lỗi từ code cũ
                    panel.removeAttribute('hidden');
                    panel.removeAttribute('style');

                    trigger.addEventListener('click', () => {
                        const isOpen = question.getAttribute('data-state') === 'open';

                        faqTriggers.forEach(otherTrigger => {
                            const otherQuestion = otherTrigger.closest('.question');
                            const otherPanel = otherQuestion.querySelector('.accordion_content');
                            otherQuestion.setAttribute('data-state', 'closed');
                            otherPanel.setAttribute('data-state', 'closed');
                            otherTrigger.classList.remove('open');
                            otherTrigger.setAttribute('aria-expanded', 'false');
                            otherTrigger.setAttribute('data-state', 'closed');
                        });

                        if (!isOpen) {
                            question.setAttribute('data-state', 'open');
                            panel.setAttribute('data-state', 'open');
                            trigger.setAttribute('aria-expanded', 'true');
                            trigger.setAttribute('data-state', 'open');
                        }
                    });
                });
            });
        </script>

<!-- Membership Tabs JS -->
<script>
document.addEventListener("DOMContentLoaded", function () {
    const tabContainer = document.querySelector('.table[role="tablist"]');
    if (tabContainer) {
        const tabs = Array.from(tabContainer.querySelectorAll('button[role="tab"]'));
        const parent = tabContainer.closest('.hidden') || document;
        const panels = Array.from(parent.querySelectorAll('div[role="tabpanel"]'));

        tabs.forEach((tab, index) => {
            const panel = panels[index];
            if (!panel) return;

            tab.addEventListener('click', () => {
                // Reset all
                tabs.forEach(t => {
                    t.setAttribute('aria-selected', 'false');
                    t.setAttribute('data-state', 'inactive');
                });
                panels.forEach(p => {
                    p.setAttribute('data-state', 'inactive');
                    p.hidden = true;
                    // p.style.display = 'none'; // Alternative if hidden doesn't work well
                });

                // Activate selected
                tab.setAttribute('aria-selected', 'true');
                tab.setAttribute('data-state', 'active');
                panel.setAttribute('data-state', 'active');
                panel.hidden = false;
            });

            // Initialize correct state dynamically on load
            if (index === 0) {
                tab.setAttribute('aria-selected', 'true');
                tab.setAttribute('data-state', 'active');
                panel.setAttribute('data-state', 'active');
                panel.hidden = false;
            } else {
                tab.setAttribute('aria-selected', 'false');
                tab.setAttribute('data-state', 'inactive');
                panel.setAttribute('data-state', 'inactive');
                panel.hidden = true;
            }
        });
    }
});
</script>


