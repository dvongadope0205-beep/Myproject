<script src="/js/shop/feature.js"></script>
<script src="/js/shop/cart-effect.js"></script>

<script>
    // Avatar dropdown toggle & global shop scripts initialization
    document.addEventListener('DOMContentLoaded', function () {
        if (typeof initFeatures === 'function') initFeatures();
        if (typeof initCartEffects === 'function') initCartEffects();

        var trigger = document.querySelector('.shop-avatar-trigger');
        var menu = document.querySelector('.shop-auth-menu');
        if (trigger && menu) {
            trigger.addEventListener('click', function (e) {
                e.stopPropagation();
                menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
            });
            document.addEventListener('click', function () {
                menu.style.display = 'none';
            });
            menu.addEventListener('click', function (e) { e.stopPropagation(); });
            // Hover highlight
            menu.querySelectorAll('a').forEach(function (a) {
                a.addEventListener('mouseenter', function () { a.style.background = '#faf5f0'; });
                a.addEventListener('mouseleave', function () { a.style.background = 'transparent'; });
            });
        }

        // Dynamic product size and size chart toggle logic
        var path = window.location.pathname;
        if (path && (path.includes('/Shopnew/') || path.includes('/shopnew/'))) {
            var slug = path.split('/').pop();
            if (slug && slug !== 'index' && slug !== 'cart' && slug !== 'checkout' && slug !== 'search') {
                fetch('/api/shop/product-settings?slug=' + encodeURIComponent(slug))
                    .then(function (response) { return response.json(); })
                    .then(function (data) {
                        if (data) {
                            if (!data.isSizeEnabled) {
                                // Hide size picker in main product details
                                var sizePicker = document.querySelector('.product-variant-picker');
                                if (sizePicker) sizePicker.style.setProperty('display', 'none', 'important');
                                
                                // Hide size row/selectors inside quick add forms or recommendation cards
                                document.querySelectorAll('.variant-row, div[aria-label=\"Size\"], fieldset.product-form-input').forEach(function(el) {
                                    el.style.setProperty('display', 'none', 'important');
                                });
                            }
                            if (!data.isSizeChartEnabled) {
                                // Hide size chart button/link/modal trigger
                                var sizeChartBlock = document.querySelector('.wj-sizechart-block');
                                if (sizeChartBlock) sizeChartBlock.style.setProperty('display', 'none', 'important');
                                
                                document.querySelectorAll('.wj-sizechart-btn, .wj-sizechart-root, .wj-sizechart-modal').forEach(function(el) {
                                    el.style.setProperty('display', 'none', 'important');
                                });
                            }
                        }
                    })
                    .catch(function (err) { console.error('Error loading product settings:', err); });
            }
        }
    });
</script>

    <!-- ══════════════ PREMIUM GLOBAL CUSTOM POPUPS (ALERT & CONFIRM) ══════════════ -->
    <div id="premiumAlertModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.55); backdrop-filter: blur(8px); z-index: 999999; align-items: center; justify-content: center; font-family: 'Fredoka', sans-serif;">
        <div style="background: #fff; border-radius: 16px; width: 400px; max-width: 90%; padding: 30px; box-shadow: 0 15px 40px rgba(0,0,0,0.25); text-align: center; border: 2.5px solid #72441c; animation: pModalScale 0.3s ease;">
            <div style="width: 70px; height: 70px; border-radius: 50%; background: #faf6f0; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; border: 2px solid #72441c;">
                <i class="fa fa-info-circle" style="font-size: 32px; color: #72441c;"></i>
            </div>
            <h3 style="margin: 0 0 10px; font-size: 22px; font-weight: 700; color: #492719;">Message</h3>
            <p id="premiumAlertMessage" style="margin: 0 0 25px; font-size: 15px; color: #555; line-height: 1.6;"></p>
            <button onclick="closePremiumAlert()" style="background: linear-gradient(135deg, #ffab4d 0%, #72441c 100%); color: #fff; border: none; border-radius: 25px; padding: 12px 35px; font-size: 14px; font-weight: 700; cursor: pointer; transition: all 0.2s; min-width: 120px; outline: none; box-shadow: 0 4px 12px rgba(114,68,28,0.25);">OK</button>
        </div>
    </div>

    <div id="premiumConfirmModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.55); backdrop-filter: blur(8px); z-index: 999999; align-items: center; justify-content: center; font-family: 'Fredoka', sans-serif;">
        <div style="background: #fff; border-radius: 16px; width: 420px; max-width: 90%; padding: 30px; box-shadow: 0 15px 40px rgba(0,0,0,0.25); text-align: center; border: 2.5px solid #72441c; animation: pModalScale 0.3s ease;">
            <div style="width: 70px; height: 70px; border-radius: 50%; background: #faf6f0; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; border: 2px solid #72441c;">
                <i class="fa fa-question-circle" style="font-size: 32px; color: #72441c;"></i>
            </div>
            <h3 style="margin: 0 0 10px; font-size: 22px; font-weight: 700; color: #492719;">Confirm Action</h3>
            <p id="premiumConfirmMessage" style="margin: 0 0 25px; font-size: 15px; color: #555; line-height: 1.6;"></p>
            <div style="display: flex; gap: 15px; justify-content: center;">
                <button onclick="closePremiumConfirm(false)" style="background: #f5f5f5; color: #555; border: 1.5px solid #ddd; border-radius: 25px; padding: 12px 30px; font-size: 14px; font-weight: 700; cursor: pointer; transition: all 0.2s; min-width: 110px; outline: none;">Cancel</button>
                <button onclick="closePremiumConfirm(true)" style="background: linear-gradient(135deg, #ffab4d 0%, #72441c 100%); color: #fff; border: none; border-radius: 25px; padding: 12px 30px; font-size: 14px; font-weight: 700; cursor: pointer; transition: all 0.2s; min-width: 110px; outline: none; box-shadow: 0 4px 12px rgba(114,68,28,0.25);">Confirm</button>
            </div>
        </div>
    </div>

    <style>
        @@keyframes pModalScale {
            from { transform: scale(0.9); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }
    </style>

    <script>
        let premiumConfirmCallback = null;

        function showPremiumAlert(msg) {
            document.getElementById('premiumAlertMessage').innerText = msg;
            document.getElementById('premiumAlertModal').style.display = 'flex';
        }

        function closePremiumAlert() {
            document.getElementById('premiumAlertModal').style.display = 'none';
        }

        function showPremiumConfirm(msg, callback) {
            document.getElementById('premiumConfirmMessage').innerText = msg;
            premiumConfirmCallback = callback;
            document.getElementById('premiumConfirmModal').style.display = 'flex';
        }

        function closePremiumConfirm(approved) {
            document.getElementById('premiumConfirmModal').style.display = 'none';
            if (approved && premiumConfirmCallback) {
                premiumConfirmCallback();
            }
            premiumConfirmCallback = null;
        }

        // Global Alert Override
        window.alert = function(msg) {
            showPremiumAlert(msg);
        };

        // Form Submit Confirm Interception
        document.addEventListener('submit', function(e) {
            const form = e.target;
            const onsubmitAttr = form.getAttribute('onsubmit');
            if (onsubmitAttr && onsubmitAttr.includes('confirm(')) {
                e.preventDefault();
                e.stopImmediatePropagation();
                const match = onsubmitAttr.match(/confirm\(['"](.*?)['"]\)/);
                const msg = match ? match[1] : "Are you sure you want to proceed?";
                showPremiumConfirm(msg, () => {
                    form.removeAttribute('onsubmit');
                    form.submit();
                });
            }
        }, true);
    </script>
</body>
