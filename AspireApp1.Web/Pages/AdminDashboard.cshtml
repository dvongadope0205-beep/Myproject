                                }
                            </select>
                        }
                        else if (field.Type == "file")
                        {
                            <input type="file" id="@field.Id" name="@field.Name" accept="image/*" multiple @(field.IsRequired ? "required" : "")>
                        }
                        else
                        {
                            <input type="@field.Type" id="@field.Id" name="@field.Name" placeholder="@field.Placeholder" 
                                   value="@field.Value" min="@field.Min" step="@field.Step" @(field.IsRequired ? "required" : "")>
                        }
                    </div>
                }
            }
            <div class="form-group" id="ModalProductGalleryContainer" style="display:none; margin-bottom: 20px;">
                <label>Gallery Preview</label>
                <div class="modal-gallery-wrap" 
                style="display: flex; flex-direction: column; align-items: 
                    center; border: 2px dashed #ebd4bd; border-radius: 12px; padding: 15px; background: #faf6f0; gap: 12px; position: relative;">
                    <img id="ModalMainPreview" src="" 
                        style="max-height: 220px; max-width: 100%; object-fit: contain; border-radius: 8px; border: 1.5px solid #ebd4bd; background: #fff; padding: 5px;" />
                    <div id="ModalThumbnailsStrip" style="display: flex; gap: 8px; overflow-x: auto; width: 100%; padding: 5px 0; justify-content: center; scrollbar-width: none;">
                    </div>
                </div>
            </div>

            <button type="submit" class="btn-submit">
                <i class="fa fa-save"></i> Save Product
            </button>
        </form>
    </div>
</div>

