@page
@model WebApps.Pages.DirectionsModel
@{
    ViewData["Title"] = "Hours & Directions - National Conservation Zoo";
}

@section Styles {
<link rel="stylesheet" href="css/pages.css">
}

<main>
        <section class="page-hero">
            <h1>Hours & Directions</h1>
            <p>We are conveniently located in the center of the city. Plan your daily commute.</p>
        </section>
        <section class="page-content-wrap">
            <div class="page-section">
                <h2>Today's Hours</h2>
                <p>The Zoo is open from <strong>10:00 AM to 4:30 PM</strong> daily. Last admission is at 3:30 PM.</p>
                <div style="margin-top:20px; height: 300px; background:#eef2f5; border-radius:12px; display:flex; align-items:center; justify-content:center; border:2px solid #ccc;">
                    <h3 style="color:#aaa;"><i class="fa fa-map-marker"></i> Interactive Map Frame</h3>
                </div>
            </div>
            <div class="page-section">
                <h2>Parking Options</h2>
                <p>Visitor parking is available at the Main Lot for $15/day. Members receive free parking.</p>
            </div>
        </section>
    </main>
