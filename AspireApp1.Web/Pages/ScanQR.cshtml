@page
@model WebApps.Pages.ScanQRModel
@{
    Layout = null;
    var bgColor = Model.Status == "success" ? "#119864" : Model.Status == "already" ? "#f0ad4e" : "#dc3545";
    var icon = Model.Status == "success" ? "fa-check-circle" : Model.Status == "already" ? "fa-info-circle" : "fa-times-circle";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QR Payment - Zoo</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #0d2b1a 0%, #1a5e3a 50%, #119864 100%);
            padding: 20px;
        }
        .scan-card {
            background: white;
            border-radius: 24px;
            box-shadow: 0 25px 60px rgba(0,0,0,0.3);
            max-width: 400px;
            width: 100%;
            overflow: hidden;
            animation: slideUp 0.5s ease;
        }
        @@keyframes slideUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .scan-header {
            background: @bgColor;
            padding: 40px 30px;
            text-align: center;
            color: white;
        }
        .scan-header .icon {
            font-size: 64px;
            margin-bottom: 16px;
            animation: popIn 0.6s ease 0.2s both;
        }
        @@keyframes popIn {
            from { transform: scale(0); }
            to { transform: scale(1); }
        }
        .scan-header h1 { font-size: 22px; font-weight: 700; margin-bottom: 8px; }
        .scan-header p { font-size: 14px; opacity: 0.9; }
        .scan-body { padding: 30px; text-align: center; }
        .tx-ref {
            background: #f8f9fa;
            padding: 12px 20px;
            border-radius: 10px;
            margin: 16px 0;
            font-family: monospace;
            font-size: 13px;
            color: #555;
            word-break: break-all;
        }
        .amount {
            font-size: 36px;
            font-weight: 800;
            color: #119864;
            margin: 16px 0;
        }
        .success-check {
            width: 80px; height: 80px;
            background: linear-gradient(135deg, #119864, #0d7a4f);
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 16px;
            animation: popIn 0.6s ease 0.3s both;
        }
        .success-check svg { width: 40px; height: 40px; }
        .success-check svg path {
            stroke: white; stroke-width: 3; fill: none;
            stroke-dasharray: 50; stroke-dashoffset: 50;
            animation: drawCheck 0.5s ease 0.8s forwards;
        }
        @@keyframes drawCheck {
            to { stroke-dashoffset: 0; }
        }
        .zoo-logo { margin-top: 24px; font-size: 13px; color: #999; }
    </style>
</head>
<body>
    <div class="scan-card">
        <div class="scan-header">
            @if (Model.Status == "success")
            {
                <div class="icon"><i class="fa fa-check-circle"></i></div>
                <h1>Payment Successful!</h1>
                <p>Transaction completed</p>
            }
            else if (Model.Status == "already")
            {
                <div class="icon"><i class="fa fa-info-circle"></i></div>
                <h1>Already Processed</h1>
                <p>This payment was already completed</p>
            }
            else
            {
                <div class="icon"><i class="fa fa-times-circle"></i></div>
                <h1>Payment Failed</h1>
                <p>Unable to process this payment</p>
            }
        </div>
        <div class="scan-body">
            @if (Model.Status == "success")
            {
                <div class="success-check">
                    <svg viewBox="0 0 50 50"><path d="M14 27 L22 35 L37 16"/></svg>
                </div>
                <div class="amount">$@Model.Amount.ToString("F2")</div>
                <p style="color:#333;font-weight:600;font-size:16px;margin-bottom:8px;">Transaction Complete</p>
            }

            @if (!string.IsNullOrEmpty(Model.TransactionRef))
            {
                <div class="tx-ref">
                    <strong>Ref:</strong> @Model.TransactionRef
                </div>
            }

            <p style="color:#666; font-size:14px; line-height:1.6;">@Model.Message</p>

            @if (Model.Status == "success")
            {
                <p style="color:#119864; font-weight:600; margin-top:16px; font-size:14px;">
                    <i class="fa fa-desktop"></i> Your computer screen will update automatically.
                </p>
            }

            <div class="zoo-logo">
                <i class="fa fa-paw"></i> National Conservation Zoo
            </div>
        </div>
    </div>
</body>
</html>
