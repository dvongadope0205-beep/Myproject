<!DOCTYPE html>
<html lang="vi">
<head>

<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>@ViewData["Title"]</title>
<link href="~/css/shop/global.css" rel="stylesheet"/>
<link href="~/css/shop/header.css" rel="stylesheet"/>
<link href="~/css/shop/cart-drawer.css" rel="stylesheet"/>
<link href="~/css/shop/footer.css" rel="stylesheet"/>
<link href="~/css/shop/product-card.css" rel="stylesheet"/>
<link href="~/css/shop/feature.css" rel="stylesheet"/>
@{
    var pageRoute = ViewContext.RouteData.Values["page"]?.ToString();
    var isProductPage = pageRoute?.StartsWith("/Shopnew/", StringComparison.OrdinalIgnoreCase) == true
                        && !pageRoute.EndsWith("/index", StringComparison.OrdinalIgnoreCase)
                        && !pageRoute.EndsWith("/cart", StringComparison.OrdinalIgnoreCase)
                        && !pageRoute.EndsWith("/checkout", StringComparison.OrdinalIgnoreCase)
                        && !pageRoute.EndsWith("/search", StringComparison.OrdinalIgnoreCase)
                        && !pageRoute.EndsWith("/contact-us", StringComparison.OrdinalIgnoreCase)
                        && !pageRoute.EndsWith("/pre-order", StringComparison.OrdinalIgnoreCase)
                        && !pageRoute.EndsWith("/order-status", StringComparison.OrdinalIgnoreCase)
                        && !pageRoute.EndsWith("/accessories", StringComparison.OrdinalIgnoreCase)
                        && !pageRoute.EndsWith("/apparel", StringComparison.OrdinalIgnoreCase)
                        && !pageRoute.EndsWith("/bundles", StringComparison.OrdinalIgnoreCase)
                        && !pageRoute.EndsWith("/gift-cards", StringComparison.OrdinalIgnoreCase)
                        && !pageRoute.EndsWith("/game", StringComparison.OrdinalIgnoreCase)
                        && !pageRoute.EndsWith("/plush", StringComparison.OrdinalIgnoreCase)
                        && !pageRoute.EndsWith("/stationery", StringComparison.OrdinalIgnoreCase)
                        && !pageRoute.EndsWith("/shop-all", StringComparison.OrdinalIgnoreCase)
                        && !pageRoute.EndsWith("/new", StringComparison.OrdinalIgnoreCase);
}
@if (isProductPage)
{
    <link href="~/css/shop/product-info.css" rel="stylesheet" asp-append-version="true" />
}
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
<style>
        /* -------------------------------------------
           SECTION 1: HERO OVERLAY (Giá»‘ng HÃ¬nh 2)
           ------------------------------------------- */
        .hero-section {
            position: relative;
            width: 100%;
            height: 70vh;
            min-height: 500px;
            background-color: transparent;
            overflow: hidden;
            display: flex;
            align-items: center;
            border-bottom: var(--border-thick);
        }

        .hero-section img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            opacity: 0.9;
        }

        .hero-section:hover img {
            transform: scale(1.08);
            opacity: 1;
        }

        .hero-bg-right {
            position: absolute;
            top: 0;
            right: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
        }

        .hero-bg-right img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .hero-content-right {
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%);
            z-index: 3;
            text-align: center;
            color: #fff;
            width: 90%;
        }

        .hero-content-right h1 {
            font-size: 6rem;
            line-height: 1;
            text-transform: uppercase;
            text-shadow: 4px 4px 0px rgba(0, 0, 0, 0.4);
            margin-bottom: 20px;
        }

        .hero-content-right p {
            font-size: 1.2rem;
            margin-bottom: 30px;
            font-weight: 600;
            letter-spacing: 1px;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
        }

        .btn-shop-hero {
            display: inline-block;
            background-color: var(--color-red);
            color: #fff;
            padding: 15px 40px;
            font-size: 1.2rem;
            font-weight: bold;
            text-decoration: none;
            text-transform: uppercase;
            border: 2px solid #fff;
            box-shadow: 4px 4px 0px rgba(0, 0, 0, 0.3);
            transition: all 0.2s ease;
        }

        .btn-shop-hero:hover {
            transform: translate(-2px, -2px);
            box-shadow: 6px 6px 0px rgba(0, 0, 0, 0.4);
            background-color: #ff5b84;
        }

        /* Removed .hero-bg-left */

        .floating-product {
            width: 250px;
            height: 250px;
            background-color: var(--color-orange);
            border-radius: 50%;
            border: var(--border-thick);
            box-shadow: 10px 10px 0px rgba(0, 0, 0, 0.1);
            position: absolute;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 1.5rem;
            color: var(--color-dark);
            text-align: center;
        }

        .float-1 {
            top: 10%;
            left: 10%;
            transform: rotate(-10deg);
        }

        .float-2 {
            bottom: 5%;
            left: 20%;
            transform: rotate(5deg);
            width: 200px;
            height: 200px;
            background-color: #fff;
        }

        .tag-new {
            position: absolute;
            bottom: 30px;
            left: 47%;
            background: #fff;
            color: var(--color-dark);
            padding: 8px 20px;
            font-weight: 700;
            font-size: 1.2rem;
            border: var(--border-thick);
            box-shadow: 4px 4px 0px var(--color-dark);
            z-index: 4;
        }

        /* -------------------------------------------
           SECTION 2: 4-COLUMN GRID (Giá»‘ng dá»c hÃ ng ngang HÃ¬nh 3 & tag nhá» HÃ¬nh 1)
           ------------------------------------------- */
        .collections-grid {
            display: flex;
            flex-wrap: nowrap;
            width: 100%;
            height: 45vh;
            border-bottom: var(--border-thick);
            background: #111;
        }

        .col-item {
            flex: 1;
            position: relative;
            overflow: hidden;
            cursor: pointer;
            border-right: var(--border-thick);
        }

        .col-item:last-child {
            border-right: none;
        }

        .col-item:nth-child(1) {
            background-color: #bfa593;
        }

        .col-item:nth-child(2) {
            background-color: #eab464;
        }

        .col-item:nth-child(3) {
            background-color: #e6a7b3;
        }

        .col-item:nth-child(4) {
            background-color: #b28e67;
        }

        .col-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            opacity: 0.9;
        }

        .col-item:hover img {
            transform: scale(1.08);
            opacity: 1;
        }

        .col-center-text {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: #fff;
            font-size: 2rem;
            font-weight: 700;
            text-shadow: 2px 2px 0px var(--color-dark), -1px -1px 0px var(--color-dark), 1px -1px 0px var(--color-dark), -1px 1px 0px var(--color-dark);
            text-align: center;
            text-transform: uppercase;
            letter-spacing: 2px;
            pointer-events: none;
            z-index: 2;
            width: 90%;
            transition: transform 0.3s ease;
        }

        .col-item:hover .col-center-text {
            transform: translate(-50%, -60%);
        }

        .col-tag {
            position: absolute;
            bottom: 15px;
            left: 15px;
            background: #fff;
            color: var(--color-dark);
            padding: 5px 12px;
            font-weight: 700;
            font-size: 0.9rem;
            border: 2px solid var(--color-dark);
            box-shadow: 2px 2px 0px var(--color-dark);
            text-transform: uppercase;
            z-index: 3;
        }

        /* -------------------------------------------
           SECTION 3: GAME BANNER (Giá»‘ng HÃ¬nh 1 má»›i)
           ------------------------------------------- */
        .game-banner-section {
            position: relative;
            width: 100%;
            border-bottom: var(--border-thick);
            padding: 0;
            overflow: hidden;
        }

        .full-banner-img {
            width: 100%;
            height: auto;
            object-fit: cover;
            display: block;
        }

        .banner-action-container {
            position: absolute;
            bottom: 10%;
            left: 0;
            width: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 10;
        }

        .game-title-big {
            font-size: 4.5rem;
            color: #fff;
            text-transform: uppercase;
            text-shadow: 3px 3px 0 var(--color-dark);
            line-height: 1;
            margin-bottom: 10px;
            letter-spacing: 2px;
        }

        .game-title-small {
            font-size: 1.5rem;
            color: #fff;
            text-shadow: 2px 2px 0 var(--color-dark);
            margin-bottom: 5px;
        }

        .game-title-brand {
            font-size: 2.5rem;
            color: #fff;
            text-shadow: 3px 3px 0 var(--color-dark);
            margin-bottom: 25px;
        }

        .btn-shop-black {
            background-color: #5c3a21;
            color: #fff;
            padding: 15px 45px;
            font-size: 1.1rem;
            font-weight: bold;
            text-decoration: none;
            text-transform: uppercase;
            position: relative;
            overflow: hidden;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
        }

        .btn-shop-black .btn-text-anim {
            display: inline-block;
            transition: transform 0.3s ease;
            position: relative;
            z-index: 2;
        }

        .btn-shop-black::after {
            content: 'âž”';
            position: absolute;
            top: 50%;
            transform: translateY(-50%) translateX(-20px);
            right: 25px;
            opacity: 0;
            transition: all 0.3s ease;
            z-index: 2;
            font-size: 1.3rem;
            line-height: 0;
        }

        .btn-shop-black:hover .btn-text-anim {
            transform: translateX(-15px);
        }

        .btn-shop-black:hover::after {
            opacity: 1;
            transform: translateY(-50%) translateX(0);
        }

        .btn-shop-black::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 0%;
            height: 100%;
            background-color: #704032;
            transition: width 0.3s ease-in-out;
            z-index: 1;
        }

        .btn-shop-black:hover::before {
            width: 100%;
        }

        .game-banner-right {
            position: absolute;
            top: 0;
            right: 0;
            width: 45%;
            height: 100%;
            z-index: 1;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .game-box-item {
            width: 300px;
            height: 400px;
            background-color: #e0964e;
            border-radius: 8px;
            border: var(--border-thick);
            box-shadow: 15px 15px 0px rgba(0, 0, 0, 0.15);
            transform: rotate(5deg);
            /* NghiÃªng há»™p giá»‘ng áº$nh */
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: bold;
            font-size: 1.5rem;
            text-align: center;
            padding: 20px;
        }
        /* -------------------------------------------
           RESPONSIVE
        ------------------------------------------- */
        @@media (max-width: 991px) {
            .hero-section {
                flex-direction: column;
                height: auto;
                min-height: 80vh;
            }

            .hero-content-right {
                left: 50%;
                right: auto;
                transform: translate(-50%, -50%);
                width: 90%;
            }

            .collections-grid {
                flex-direction: column;
                height: auto;
            }

            .col-item {
                height: 250px;
                border-right: none;
                border-bottom: var(--border-thick);
            }

            .game-banner-section {
                padding: 0;
            }

            .game-title-big {
                font-size: 3rem;
            }

            .game-title-brand {
                font-size: 1.8rem;
            }

            .featured-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 600px) {
            .featured-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
