@page
@model WebProject.Pages.ForgotPasswordModel
@{
    Layout = "~/Pages/Shop2/Shared/_Layout.cshtml";
    ViewData["Title"] = "Forgot Password - Natural Habitat Store";
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.5/css/all.min.css" />
    <style>
        body { display: block !important; margin: 0; padding: 0; min-height: auto; background: none !important; animation: none !important; }
        
        .login-page-wrapper {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: calc(100vh - 200px);
            background: transparent;
            padding-top: 40px;
            padding-bottom: 50px;
        }

        /* Override login.css global button styles that conflict with shop layout */
        .main-header button, .cart-drawer button, .nav-right button { 
            border-radius: initial; border: initial; background: initial; 
            color: initial; font-size: initial; padding: initial; 
            letter-spacing: initial; text-transform: initial; margin-top: initial; 
        }

        .forgot-card {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 14px 28px rgba(0,0,0,0.15), 0 10px 10px rgba(0,0,0,0.1);
            width: 480px;
            max-width: 95%;
            padding: 50px 40px;
            text-align: center;
            animation: slideUp 0.5s ease;
            border: 1px solid #f3e5d8;
        }

        @@keyframes slideUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .forgot-card .icon-circle {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: linear-gradient(135deg, #ec993c, #593211);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 25px;
        }

        .forgot-card .icon-circle i {
            font-size: 32px;
            color: #fff;
        }

        .forgot-card h1 {
            font-weight: bold;
            font-size: 24px;
            margin: 0 0 10px;
            color: #593211;
            font-family: 'Fredoka', sans-serif;
        }

        .forgot-card p {
            font-size: 14px;
            color: #666;
            margin: 0 0 25px;
            line-height: 1.6;
            font-family: 'Fredoka', sans-serif;
        }

        .forgot-card input[type="email"],
        .forgot-card input[type="tel"] {
            background-color: #eee;
            border: 2px solid transparent;
            border-radius: 5px;
            padding: 12px 15px;
            width: 100%;
            box-sizing: border-box;
            font-size: 14px;
            transition: border-color 0.3s;
            outline: none;
            margin: 8px 0;
        }

        .forgot-card input[type="email"]:focus,
        .forgot-card input[type="tel"]:focus {
            border-color: #ec993c;
            background-color: #fff;
        }

        .forgot-card .btn-reset {
            width: 100%;
            border-radius: 20px;
            border: 1px solid #ec993c;
            background: #ec993c;
            color: #fff;
            font-size: 12px;
            font-weight: bold;
            padding: 12px 45px;
            letter-spacing: 1px;
            text-transform: uppercase;
            cursor: pointer;
            margin-top: 20px;
            transition: transform 0.15s, box-shadow 0.3s;
            font-family: 'Fredoka', sans-serif;
        }

        .forgot-card .btn-reset:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(236, 153, 60, 0.35);
        }

        .forgot-card .btn-reset:active {
            transform: scale(0.97);
        }

        .forgot-card .back-link {
            display: inline-block;
            margin-top: 25px;
            color: #ec993c;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
            transition: color 0.2s;
            font-family: 'Fredoka', sans-serif;
        }

        .forgot-card .back-link:hover {
            color: #593211;
            text-decoration: underline;
        }

        .forgot-card .back-link i {
            margin-right: 5px;
        }

        .method-card {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 20px;
            border: 2.5px solid #eee;
            border-radius: 12px;
            cursor: pointer;
            text-align: left;
            transition: all 0.2s;
        }

        .method-card:hover {
            border-color: #ec993c !important;
            background: #fafafa;
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        }

        .msg-success {
            background: #e8f5e9;
            color: #2e7d32;
            padding: 14px 18px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-weight: 600;
            font-size: 14px;
            text-align: left;
        }

        .msg-error {
            background: #ffebee;
            color: #c62828;
            padding: 14px 18px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-weight: 600;
            font-size: 14px;
            text-align: left;
        }
    </style>
}

<div class="login-page-wrapper">
    <div class="forgot-card">
        
        <!-- Step 1: Selection -->
        <div id="step-selection" class="wizard-step">
            <div class="icon-circle">
                <i class="fas fa-shield-alt"></i>
            </div>
            <h1>Reset Password</h1>
            <p>Select a verification method to protect your account security before resetting your password:</p>
            
            <div style="display: flex; flex-direction: column; gap: 15px; margin: 25px 0;">
                <div class="method-card" onclick="selectMethod('email')">
                    <div style="font-size: 28px; color: #ec993c;"><i class="fas fa-envelope"></i></div>
                    <div>
                        <strong style="display: block; font-size: 16px; color: #593211; font-family: 'Fredoka', sans-serif;">Verify via Email Address</strong>
                        <span style="font-size: 13px; color: #888; font-family: 'Fredoka', sans-serif;">We will search by your email address.</span>
                    </div>
                </div>
                <div class="method-card" onclick="selectMethod('phone')">
                    <div style="font-size: 28px; color: #593211;"><i class="fas fa-phone-alt"></i></div>
                    <div>
                        <strong style="display: block; font-size: 16px; color: #593211; font-family: 'Fredoka', sans-serif;">Verify via Phone Number</strong>
                        <span style="font-size: 13px; color: #888; font-family: 'Fredoka', sans-serif;">We will search by your phone number.</span>
                    </div>
                </div>
            </div>
            
            <a href="/Shop2/login" class="back-link"><i class="fas fa-arrow-left"></i> Back to Sign In</a>
        </div>

        <!-- Step 2: Input Form -->
        <div id="step-input" class="wizard-step" style="display: none;">
            <div class="icon-circle">
                <i class="fas fa-user-edit"></i>
            </div>
            <h1 id="input-title">Verification Info</h1>
            <p id="input-desc">Please enter your details below.</p>
            
            <div id="input-error" class="msg-error" style="display: none;">
                <i class="fas fa-exclamation-circle"></i> <span id="error-text"></span>
            </div>
            
            <form onsubmit="submitVerifyForm(event); return false;">
                @Html.AntiForgeryToken()
                <div id="email-input-container" style="display: none; margin-bottom: 15px;">
                    <input type="email" id="input-email" placeholder="Enter your email address" />
                </div>
                <div id="phone-input-container" style="display: none; margin-bottom: 15px;">
                    <input type="tel" id="input-phone" placeholder="Enter your phone number" />
                </div>
                
                <button type="submit" class="btn-reset" id="btn-submit-verify">Verify Info</button>
            </form>
            
            <div style="margin-top: 20px;">
                <a href="javascript:void(0)" onclick="goBackToStep1()" class="back-link" style="color: #666; margin-right: 15px;"><i class="fas fa-arrow-left"></i> Back</a>
                <a href="/Shop2/login" class="back-link"><i class="fas fa-sign-in-alt"></i> Back to Sign In</a>
            </div>
        </div>

        <!-- Step 3: Error State -->
        <div id="step-error" class="wizard-step" style="display: none;">
            <div class="icon-circle" style="background: #dc3545;">
                <i class="fas fa-times-circle"></i>
            </div>
            <h1 style="color: #dc3545;">Verification Failed</h1>
            <p id="error-message-detail">The information provided does not match our records. Please check and try again.</p>
            
            <button onclick="retryInput()" class="btn-reset" style="background: #dc3545; border-color: #dc3545; margin-top: 15px;">Try Again</button>
            <button onclick="goBackToStep1()" class="btn-reset" style="background: #6c757d; border-color: #6c757d; margin-top: 10px;">Choose Different Method</button>
            
            <a href="/Shop2/login" class="back-link"><i class="fas fa-arrow-left"></i> Back to Sign In</a>
        </div>

        <!-- Step 4: Verification Success & QR Code -->
        <div id="step-success-qr" class="wizard-step" style="display: none;">
            <div class="icon-circle" style="background: #28a745;">
                <i class="fas fa-check-circle"></i>
            </div>
            <h1 style="color: #28a745;">Info Verified!</h1>
            <p>Your details matched successfully. Scan the QR code below to complete verification and set your new password.</p>
            
            <div id="verifyQrContainer" style="margin: 25px auto; width: 180px; height: 180px; display: flex; align-items: center; justify-content: center; background: #faf9f6; padding: 10px; border-radius: 12px; border: 2px dashed #28a745; margin-left: auto; margin-right: auto;"></div>
            
            <div style="background: #e8f5e9; border-radius: 10px; padding: 15px; margin: 15px 0; font-size: 14px; text-align: left; line-height: 1.6; border: 1px solid #c3e6cb; color: #155724; display: flex; align-items: center; justify-content: center; gap: 10px;">
                <div style="width: 18px; height: 18px; border: 2.5px solid #c3e6cb; border-top: 2.5px solid #28a745; border-radius: 50%; animation: stepSpin 0.8s linear infinite;"></div>
                <strong>Redirecting in <span id="redirect-countdown">7</span> seconds...</strong>
            </div>
            <style>
                @@keyframes stepSpin { to { transform: rotate(360deg); } }
            </style>
        </div>

    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
    let selectedMethod = null;
    let verifiedToken = null;
    let verifiedEmail = null;
    let countdownInterval = null;

    function selectMethod(method) {
        selectedMethod = method;
        document.getElementById('step-selection').style.display = 'none';
        document.getElementById('step-input').style.display = 'block';
        
        const titleEl = document.getElementById('input-title');
        const descEl = document.getElementById('input-desc');
        
        if (method === 'email') {
            titleEl.innerText = "Email Verification";
            descEl.innerText = "Please enter your registered email address.";
            document.getElementById('email-input-container').style.display = 'block';
            document.getElementById('phone-input-container').style.display = 'none';
            document.getElementById('input-email').value = '';
            document.getElementById('input-email').focus();
        } else {
            titleEl.innerText = "Phone Verification";
            descEl.innerText = "Please enter your registered phone number.";
            document.getElementById('email-input-container').style.display = 'none';
            document.getElementById('phone-input-container').style.display = 'block';
            document.getElementById('input-phone').value = '';
            document.getElementById('input-phone').focus();
        }
        document.getElementById('input-error').style.display = 'none';
    }

    function goBackToStep1() {
        if (countdownInterval) clearInterval(countdownInterval);
        document.getElementById('step-selection').style.display = 'block';
        document.getElementById('step-input').style.display = 'none';
        document.getElementById('step-error').style.display = 'none';
        document.getElementById('step-success-qr').style.display = 'none';
    }

    function retryInput() {
        document.getElementById('step-input').style.display = 'block';
        document.getElementById('step-error').style.display = 'none';
    }

    function submitVerifyForm(e) {
        if (e) e.preventDefault();
        
        const inputVal = selectedMethod === 'email' 
            ? document.getElementById('input-email').value.trim() 
            : document.getElementById('input-phone').value.trim();
            
        if (!inputVal) {
            showInputError("Please enter your information.");
            return;
        }

        const submitBtn = document.getElementById('btn-submit-verify');
        submitBtn.disabled = true;
        submitBtn.innerText = "Verifying...";

        fetch('/Shop2/ForgotPassword?handler=VerifyInfo', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            },
            body: JSON.stringify({ method: selectedMethod, value: inputVal })
        })
        .then(r => r.json())
        .then(data => {
            submitBtn.disabled = false;
            submitBtn.innerText = "Verify Info";
            
            if (data.success) {
                showSuccessQr(data.token, data.email);
            } else {
                showVerificationFailed(data.message);
            }
        })
        .catch(() => {
            submitBtn.disabled = false;
            submitBtn.innerText = "Verify Info";
            showVerificationFailed("A network error occurred. Please try again.");
        });
    }

    function showInputError(msg) {
        const errEl = document.getElementById('input-error');
        document.getElementById('error-text').innerText = msg;
        errEl.style.display = 'block';
    }

    function showVerificationFailed(msg) {
        document.getElementById('step-input').style.display = 'none';
        document.getElementById('step-error').style.display = 'block';
        document.getElementById('error-message-detail').innerText = msg;
    }

    function showSuccessQr(token, email) {
        verifiedToken = token;
        verifiedEmail = email;
        
        document.getElementById('step-input').style.display = 'none';
        document.getElementById('step-success-qr').style.display = 'block';
        
        // Generate QR code
        const container = document.getElementById('verifyQrContainer');
        container.innerHTML = '';
        const qrPayload = window.location.origin + '/ResetPassword?token=' + token + '&email=' + encodeURIComponent(email);
        new QRCode(container, {
            text: qrPayload,
            width: 180,
            height: 180,
            colorDark: '#ec993c',
            colorLight: '#ffffff',
            correctLevel: QRCode.CorrectLevel.M
        });

        // 7-second countdown and redirect
        let countdown = 7;
        document.getElementById('redirect-countdown').innerText = countdown;
        countdownInterval = setInterval(() => {
            countdown--;
            document.getElementById('redirect-countdown').innerText = countdown;
            if (countdown <= 0) {
                clearInterval(countdownInterval);
                window.location.href = qrPayload;
            }
        }, 1000);
    }
</script>
