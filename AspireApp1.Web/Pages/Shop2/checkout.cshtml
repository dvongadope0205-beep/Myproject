@page
@model WebProject.Pages.CheckoutModel
@{
    Layout = "~/Pages/Shop2/Shared/_Layout.cshtml";
    ViewData["Title"] = "Checkout - Natural Habitat Store";
}

@section Styles {
    <link href="~/css/shop2/checkout.css" rel="stylesheet" asp-append-version="true"/>
    <style>
        .checkout-page-container {
            font-family: 'Fredoka', sans-serif;
            color: #492719;
            max-width: 1200px;
            margin: 0 auto;
            padding: 40px 20px;
        }
        
        .checkout-section-title {
            font-size: 24px;
            font-weight: 700;
            color: #72441c;
            margin-bottom: 25px;
            border-bottom: 2px solid #ebd393;
            padding-bottom: 10px;
        }

        .checkout-input {
            width: 100%;
            padding: 12px 16px;
            border: 2px solid #eee;
            border-radius: 10px;
            font-size: 15px;
            font-family: 'Fredoka', sans-serif;
            box-sizing: border-box;
            outline: none;
            transition: border-color 0.15s;
        }

        .checkout-input:focus {
            border-color: #ec993c;
        }

        .form-label-custom {
            display: block;
            font-weight: 600;
            margin-bottom: 6px;
            font-size: 14px;
            color: #492719;
        }

        .confirm-pay-btn {
            width: 100%;
            background-color: #ec993c;
            color: #000;
            border: 2px solid #000;
            border-radius: 12px;
            padding: 16px;
            font-family: 'Fredoka', sans-serif;
            font-size: 18px;
            font-weight: 700;
            cursor: pointer;
            transition: background 0.15s;
            text-transform: uppercase;
            box-shadow: 0 4px 12px rgba(114, 68, 28, 0.1);
        }

        .confirm-pay-btn:hover {
            background-color: #e5952e;
        }
    </style>
}

<main class="content-for-layout checkout-page-container">
    <div class="checkout-split-layout">
        <!-- LEFT COLUMN: Shipping Form -->
        <div class="checkout-left-col">
            @Html.AntiForgeryToken()
            <form id="checkout-form" class="checkout-form-card" onsubmit="return false;">
                <h2 class="checkout-section-title">Shipping Information</h2>
                
                <div class="form-group">
                    <label class="form-label-custom" for="fullName">Full Name *</label>
                    <input type="text" id="fullName" class="checkout-input" placeholder="Enter your full name" value="@Model.UserFullName" required />
                </div>
                
                <div class="form-group">
                    <label class="form-label-custom" for="email">Email Address *</label>
                    <input type="email" id="email" class="checkout-input" placeholder="example@domain.com" value="@Model.UserEmail" required />
                </div>
                
                <div class="form-group">
                    <label class="form-label-custom" for="phone">Phone Number *</label>
                    <input type="tel" id="phone" class="checkout-input" placeholder="e.g. +1 555-0199" value="@Model.UserPhone" required />
                </div>
                
                <div class="form-group">
                    <label class="form-label-custom" for="address">Shipping Address *</label>
                    <input type="text" id="address" class="checkout-input" placeholder="Street address, P.O. box, apartment" value="@Model.UserAddress" required />
                </div>
                
                <div class="form-row two-col">
                    <div class="form-group">
                        <label class="form-label-custom" for="city">City *</label>
                        <input type="text" id="city" class="checkout-input" placeholder="City / State" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label-custom" for="postcode">ZIP / Postal Code *</label>
                        <input type="text" id="postcode" class="checkout-input" placeholder="10001" required />
                    </div>
                </div>
                
                <div class="form-group">
                    <label class="form-label-custom" for="country">Country *</label>
                    <select id="country" class="checkout-input" required>
                        <option value="UK">United Kingdom</option>
                        <option value="US" selected>United States</option>
                        <option value="VN">Vietnam</option>
                    </select>
                </div>

                <div class="form-group" style="margin-top: 25px;">
                    <label class="form-label-custom">Shipping Method *</label>
                    <div id="shipping-options">
                        <!-- JS renders shipping radio options here -->
                    </div>
                </div>
            </form>
        </div>
        
        <!-- RIGHT COLUMN: Order Summary -->
        <div class="checkout-right-col">
            <div class="checkout-summary-card">
                <h2 class="checkout-section-title">Order Summary</h2>
                
                <!-- Dynamic Items Container -->
                <div class="checkout-summary-items" id="summary-items">
                    <!-- JS renders items here -->
                </div>
                
                <hr class="checkout-divider" />
                
                <div class="discount-row">
                    <input type="text" id="discount-code" placeholder="Discount code or gift card" class="checkout-input" />
                    <button type="button" id="discount-apply">Apply</button>
                </div>
                
                <hr class="checkout-divider" />
                
                <div class="summary-line">
                    <span>Subtotal</span>
                    <span id="summary-subtotal">$0.00</span>
                </div>
                <div class="summary-line">
                    <span>Shipping</span>
                    <span id="summary-shipping">$0.00</span>
                </div>
                <div class="summary-line" id="tax-row">
                    <span>Estimated Tax (VAT)</span>
                    <span id="summary-tax">$0.00</span>
                </div>
                
                <hr class="checkout-divider" />
                
                <div class="summary-line total-line">
                    <span>Total</span>
                    <div style="display:flex;align-items:center;gap:8px">
                        <span id="total-currency" style="font-size:12px;color:#737373;font-weight:400">USD</span>
                        <span id="summary-total">$0.00</span>
                    </div>
                </div>
                
                <!-- Place Order Button -->
                <button type="button" class="confirm-pay-btn" id="pay-btn-bottom">
                    Pay Now
                </button>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script src="~/js/shop2/checkout.js" asp-append-version="true"></script>
}
